#!/usr/bin/env python3
"""
serial-agent — Serial console daemon and CLI for automation agents.

══════════════════════════════════════════════════════════════════════════════
ARCHITECTURE
══════════════════════════════════════════════════════════════════════════════

  ┌─────────────────┐   TCP/direct   ┌──────────────┐   ring buffer
  │  ser2net / port │ ◄─────────────►│serial-daemon │──────────────► ~/var/serial-agent/ttyUSBx/
  └─────────────────┘                └──────┬───────┘   buf.log, status.json, events.log
           ▲                                │ FIFO input
           │ TCP (shared)          ┌────────▼────────┐
           │                       │  serial-agent   │ ← agent CLI
  ┌────────┴────────┐              │                 │
  │  tio.sh / human │              └─────────────────┘
  └─────────────────┘

Storage: ~/var/serial-agent/ (disk, not tmpfs)
         /tmp/serial-agent → ~/var/serial-agent  (symlink, auto-created, clears on reboot)

══════════════════════════════════════════════════════════════════════════════
DYNAMIC DISCOVERY — no hardcoding device paths or board names
══════════════════════════════════════════════════════════════════════════════

  Fields in discover JSON:
    label     User-set in ~/.config/serial-boards.conf — STABLE, USE THIS
    hostname  Board console hostname — fragile (rootfs-dependent)
    serial    USB adapter serial# — unique per physical device

  One-shot setup (no manual chain):
    serial-agent connect --board "$BOARD" --wait-shell

  Full automation example:
    BOARD="${BOARD:?Set BOARD= from serial-boards.conf}"
    serial-agent connect --board "$BOARD" --wait-shell --timeout 90
    result=$(serial-agent send "$dev" "uname -r" --json)
    echo "$result" | python3 -c "import sys,json; print(json.load(sys.stdin)['output'])"

  Label your boards:
    serial-agent auto-label -y     # or manually in ~/.config/serial-boards.conf

══════════════════════════════════════════════════════════════════════════════
STATE MACHINE
══════════════════════════════════════════════════════════════════════════════

  State      Meaning                          Agent action
  ─────────  ───────────────────────────────  ──────────────────────────────
  SHELL      At a shell prompt                ✓ Safe to send; alive confirmed
  RUNNING    Command executing                ✓ Alive; wait for SHELL before sending
  LOGIN      Waiting for username             Send username; wait for Password
  PASSWORD   Waiting for password             Send password; wait for SHELL
  BOOTING    Kernel/init messages             Wait for SHELL (10-60s typical)
  DEAD       No output for >30s              ✗ Board off or hung
  QUIET      Console silent >30s              Daemon healthy, port held; state
                                              before silence shown as QUIET<-X
  UNKNOWN    Daemon just started              Run alive or connect

  Status JSON fields:
    state            — one of the above
    last_output_ago  — seconds since any byte received
    last_prompt_ago  — seconds since last shell prompt
    prompt_text      — last detected prompt string

══════════════════════════════════════════════════════════════════════════════
MINIMISING TIMEOUTS
══════════════════════════════════════════════════════════════════════════════

  1. Check state first — never send to a RUNNING board
  2. Match --timeout to the command (ls=3s, make=300s)
  3. alive is instant for SHELL/RUNNING with recent output
  4. wait-state uses inotifywait (instant) if available, else 50ms polling
  5. send --json returns clean structured output — no parsing needed
  6. expect handles multi-outcome boards (panic, login, shell) in one call

══════════════════════════════════════════════════════════════════════════════
COMMANDS
══════════════════════════════════════════════════════════════════════════════

  Discovery & setup (no hardcoding):
    auto-label  [--dry-run] [-y]                   generate labels from probe
    discover    [--board PAT] [--serial S] [--live] JSON port list
    connect     [--board PAT] [--serial S] [--wait-shell] [--timeout N] [--json]
    ser2net-gen [--start-port N] [--output FILE]   generate /etc/ser2net.yaml

  Daemon lifecycle:
    start   DEVICE [--tcp HOST:PORT] [--baud N] [--lines N]
    stop    DEVICE
    status  DEVICE                       JSON state + timestamps
    path    DEVICE                       ~/var/serial-agent/ttyUSBx/
    clean   [DEVICE]                     remove stale state dirs

  Observation (no serial traffic):
    read    DEVICE [--lines N] [--no-timestamps]
    events  DEVICE [--lines N]
    tail    DEVICE

  Liveness checks:
    alive      DEVICE [--timeout N]                exit 0=alive; fast cached path
    wait-alive DEVICE [--timeout N]                block until SHELL/LOGIN/PASSWORD
    wait-state DEVICE STATE[,STATE] [--timeout N]  event-driven, inotifywait if available

  Sending:
    send   DEVICE CMD [--wait PAT] [--timeout N]   sends + waits for pattern
           [--json]     structured output {"output","state","elapsed_ms","exit_code"}
           [--capture]  clean stdout only (no timestamps/prompt)
           [--exit-code] append '; echo EXITCODE:$?' and parse result
                        NOTE: commands containing 'exit' terminate the shell
                        before the echo can run — use run DEVICE instead
           [--no-wait]  fire and forget
           [--no-wrap]  prepend COLUMNS=32767 to prevent board terminal wrapping
           [--all]      send to ALL boards with running daemons (ignores DEVICE)
    expect DEVICE --on KEY=REGEX [--on ...] [--timeout N]
           wait for first of multiple patterns; JSON {"matched","output","elapsed_ms"}

══════════════════════════════════════════════════════════════════════════════
EMBEDDED MPU DEVELOPMENT PATTERNS (TI AM62x, AM62D2, etc.)
══════════════════════════════════════════════════════════════════════════════

  ── State machine ─────────────────────────────────────────────────────────
  SHELL    at shell prompt          → send commands
  RUNNING  command executing        → wait-state SHELL (never send to RUNNING)
  UBOOT    U-Boot "=>" prompt       → send U-Boot commands
  LOGIN    "login:" prompt          → serial-agent login DEVICE
  PASSWORD "Password:" prompt       → serial-agent login DEVICE
  BOOTING  kernel log timestamps    → wait-state SHELL --timeout 120
  PANIC    "Kernel panic"/BUG/OOPS  → serial-agent reboot DEVICE
  DEAD     no output 30s            → board off or hung

  ── Speed reference ───────────────────────────────────────────────────────
  Slow (avoid)                    Fast equivalent
  time.sleep(5)                   wait-state DEVICE SHELL --timeout 90
  poll alive every second         wait-state (inotifywait, 0ms latency)
  read buf then grep              send CMD --json (50ms, structured)
  discover+start+wait 3 calls     connect --board X --wait-shell
  reboot + 4 commands             reboot DEVICE --setup-terminal (atomic)

  ── One-time session setup ────────────────────────────────────────────────
  serial-agent auto-label -y                    # label boards from USB serial#
  serial-agent connect --board "$BOARD" \\
      --wait-shell --setup-terminal --timeout 90

  ── Kernel module test cycle ──────────────────────────────────────────────
  serial-agent upload "$DEV" ./my-driver.ko /lib/modules/extra/
  serial-agent send   "$DEV" "modprobe my-driver" --json --exit-code
  serial-agent send   "$DEV" "dmesg | tail -20" --capture --no-wrap
  serial-agent send   "$DEV" "rmmod my-driver" --json --exit-code

  ── DTB overlay test ──────────────────────────────────────────────────────
  serial-agent upload "$DEV" ./k3-am625-sk-audio.dtbo /boot/overlays/
  serial-agent reboot "$DEV" --setup-terminal --timeout 90
  serial-agent send   "$DEV" "ls /proc/device-tree/sound/" --capture

  ── Reboot + verify ───────────────────────────────────────────────────────
  serial-agent reboot "$DEV" --setup-terminal --timeout 120
  serial-agent health "$DEV"
  serial-agent send   "$DEV" "dmesg | grep -ci error" --json --no-wrap

  ── Multi-outcome expect ──────────────────────────────────────────────────
  serial-agent send   "$DEV" "reboot" --no-wait
  serial-agent expect "$DEV" --on "READY=~#" --on "PANIC=Kernel panic" \\
      --on "LOGIN=login:" --timeout 120

  ── Multi-board parallel ──────────────────────────────────────────────────
  serial-agent send --all "uname -r" --json   # all boards simultaneously

  ── U-Boot interaction ────────────────────────────────────────────────────
  serial-agent wait-state "$DEV" UBOOT --timeout 15
  serial-agent send "$DEV" "printenv bootargs" --wait '=>' --timeout 3

  ── run multi-line scripts ────────────────────────────────────────────────
  cat << 'EOF' | serial-agent run "$DEV" - --json --timeout 30
  aplay -l
  arecord -l
  amixer scontents | head -20
  EOF

══════════════════════════════════════════════════════════════════════════════
FILE LAYOUT  ~/var/serial-agent/<devname>/
══════════════════════════════════════════════════════════════════════════════

  daemon.pid   — PID of the running daemon process. Removed on clean exit.
                 Use _daemon_running(device) to check: reads PID and sends
                 kill(pid, 0) — returns False if file missing or PID dead.

  status.json  — Written after every state change and every received byte.
                 Fields: state, last_output_ago, last_prompt_ago,
                 prompt_text, pid, device, baud, via, buf_file, buf_lines.
                 Consumers should read this; never poll buf.log directly.

  stream.log   — Append-only copy of every captured line (rotates at 8 MB
                 to stream.log.1). Use THIS for tail -f/-F followers: buf.log
                 is rewritten via tmp+rename on every chunk, so its inode
                 changes constantly and tail followers silently detach.
  buf.log      — Ring buffer of the last N lines (default 500) from the
                 board. Each line is prepended with a [HH:MM:SS.mmm]
                 timestamp. Partial lines are buffered across os.read()
                 calls so split bytes never produce corrupt entries.

  events.log   — State-transition log, max MAX_EVENTS (200) lines.
                 Format: [HH:MM:SS.mmm] PREV → NEW  <prompt_text>
                 Used by _wait_state() via inotifywait for zero-latency
                 wakeup when a target state is reached.

  input.fifo   — Named FIFO for sending commands to the daemon. The daemon's
                 _writer thread holds it open for reading; senders open it
                 O_WRONLY|O_NONBLOCK (fails with ENXIO if no reader yet).
                 Each write is a complete shell command + newline (\n).
                 The FIFO is created once at daemon start and persists until
                 the next start (cleared by cmd_start to prevent stale data).

  output.fifo  — Push channel (reverse of input.fifo). _append() mirrors every
                 raw serial chunk into it so a 'watch' consumer gets results with
                 no polling latency (~0.2ms). The daemon opens the write end
                 O_WRONLY|O_NONBLOCK lazily (ENXIO while no reader) and DROPS on a
                 full pipe (EAGAIN) rather than block — the serial reader must
                 never wait on it. Single-consumer (a 2nd reader steals bytes);
                 for shared observation use the TCP relay / tio instead.

  daemon.log   — stdout/stderr of the daemon process (append mode).
                 Contains connect/disconnect events and error messages.

══════════════════════════════════════════════════════════════════════════════
DESIGN NOTES
══════════════════════════════════════════════════════════════════════════════

  Serial device flags (O_RDWR | O_NOCTTY | O_NONBLOCK):
    O_NOCTTY   — prevent the device becoming the controlling terminal.
    O_NONBLOCK — open returns immediately even if DCD is not asserted;
                 os.read() raises EAGAIN (errno 11) instead of blocking
                 when no data is available. The daemon's select() loop
                 handles EAGAIN as a spurious wakeup and continues.

  FIFO protocol:
    The _writer thread opens input.fifo with blocking O_RDONLY, which
    blocks until a sender opens the write end. Senders use O_NONBLOCK so
    they never block waiting for the daemon — they fail fast (ENXIO) if
    the daemon isn't ready yet and retry up to 20×100ms before giving up.

  Output capture baseline:
    _send_impl() snaps buf.log's byte offset to the last newline BEFORE
    writing to the FIFO. After the command completes, only bytes after that
    offset are read back — this prevents pre-command output from polluting
    the captured result, even if the board was still printing when the
    command was sent.

  State machine priority:
    _update_state() checks in this order: PANIC > UBOOT > LOGIN >
    PASSWORD > SHELL > BOOTING > DEAD > RUNNING. Earlier states are
    authoritative — a kernel panic in the last 500 chars always wins,
    even if there's also a shell prompt on another line.

  wait-state inotifywait path:
    If inotifywait is installed, _wait_state() watches events.log for
    new writes rather than polling on a timer. This gives sub-millisecond
    wakeup latency when a state transition happens, vs the 50-200ms
    polling interval. The daemon check (_daemon_running) runs once per
    inotify cycle (≤10s wake interval) to detect daemon death early.

  EXIT CODES used by CLI commands:
    0  — success (state reached, command completed, board alive)
    1  — failure (timeout, daemon died, board unreachable, command failed)
    2  — usage error (bad arguments, missing device)
"""

import argparse, errno, json, os, re, select, signal, socket, sys, termios, time
from datetime import datetime
from pathlib import Path
from threading import Thread, Event, Lock

# ── Storage ────────────────────────────────────────────────────────────────────
_SCRIPT_DIR = Path(__file__).resolve().parent
_REAL_BASE = Path.home() / 'var' / 'serial-agent'
_TMP_LINK  = Path('/tmp/serial-agent')
# SERIAL_AGENT_DIR overrides the state directory (used by 'serial-agent test'
# to redirect state to a temp dir so tests don't pollute ~/var/serial-agent).
AGENT_BASE = Path(os.environ.get('SERIAL_AGENT_DIR',
                  os.environ.get('SERIAL_AGENT_BASE', str(_REAL_BASE))))

def _resolve_board_cfg() -> Path:
    """Return the writable label config. Matches serial-common.sh two-layer model:
    Global install (script in /usr/... or /opt/...): XDG user conf ~/.config/serial-connect/boards.conf
    Local install (script in ~/...): script-dir/serial-boards.conf"""
    if env := os.environ.get('BOARD_CFG'):
        return Path(env)
    is_global = str(_SCRIPT_DIR).startswith(('/usr/', '/opt/'))
    if is_global:
        xdg = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config'))
        return xdg / 'serial-connect' / 'boards.conf'
    return _SCRIPT_DIR / 'serial-boards.conf'


# ── Tunables ───────────────────────────────────────────────────────────────────
def _env_int(name, default, lo):
    # Tolerant parse: a malformed env value must never crash import for every command.
    try:
        return max(lo, int(os.environ[name]))
    except (KeyError, ValueError):
        return default
def _env_float(name, default, lo):
    try:
        return max(lo, float(os.environ[name]))
    except (KeyError, ValueError):
        return default

DEFAULT_LINES = 500      # buf.log ring buffer depth (lines)
MAX_EVENTS    = 200      # events.log rotation threshold
# Silence before state → QUIET/FROZEN (EOF/connect-error still → DEAD).  Env-tunable
# mainly so the self-test can force a fast freeze without a 30s wait.
DEAD_AFTER    = _env_float('SERIAL_DEAD_AFTER', 30.0, 0.2)
IDLE_PROBE_INTERVAL = 15.0  # seconds of silence before sending a keepalive CR (must be < DEAD_AFTER)
RUNNING_AFTER = 3.0      # seconds of output without a prompt → state = RUNNING
EXITCODE_TAG  = 'SERIAL_EXITCODE'  # sentinel prefix injected by --exit-code
# A local device node that vanishes (ENOENT) is almost always a transient USB
# re-enumeration (FTDI flap / board reboot).  Poll fast for a bounded window so the
# daemon reconnects seconds after the node returns, then fall back to slow backoff.
DEVICE_ABSENT_POLL        = 2.0    # s between reconnect tries while the node is missing
DEVICE_ABSENT_FAST_WINDOW = 30.0   # s of fast polling before reverting to exponential backoff
# An EOF (peer closed, not ENOENT) on a reboot flaps the node briefly; retry fast for
# a short window so the reconnect gap that loses board output shrinks from ~1s to ~0.2s.
RECONNECT_FAST_DELAY  = 0.2        # s between EOF-reconnect tries during the fast window
RECONNECT_FAST_WINDOW = 8.0        # s of fast EOF retry before reverting to exponential backoff
GAP_MARKER_MIN        = 0.3        # only annotate a reconnect gap longer than this (s)
TX_STALL_TIMEOUT          = 5.0    # s of zero TX progress before giving up on a wedged port
BOOT_DIGEST_TAIL      = 30         # lines of the boot tail always kept in a digest
STREAM_MAX_BYTES     = _env_int('SERIAL_STREAM_MAX_BYTES', 8 * 1024 * 1024, 512)  # per-segment rotate size
STREAM_KEEP_SEGMENTS = _env_int('SERIAL_STREAM_SEGMENTS', 4, 1)  # rotated segments kept; retained ≈ (N+1)*size/device

# ── Patterns ───────────────────────────────────────────────────────────────────
RE_SHELL    = re.compile(r'[\$#>]\s*$')
# A kernel log line is never a prompt. RE_SHELL matches anything ending in
# '>', and one printk with an email address in angle brackets was enough to
# report state SHELL and store the whole line as prompt_text.
RE_KERNEL_TS = re.compile(r'^\[\s*\d+\.\d+\]')
RE_SHELL2   = re.compile(r'\w[\w.\-]*@[\w.\-]+[:#~/][^\n]*[\$#>]\s*$')
RE_LOGIN    = re.compile(r'(login|Username)\s*:\s*$', re.I)
RE_PASSWORD = re.compile(r'(Password|passwd)\s*:\s*$', re.I)
RE_BOOT     = re.compile(r'\[\s*\d+\.\d{3,6}\]')
RE_UBOOT    = re.compile(r'^(=>|u-boot[#>])\s*$', re.I)   # U-Boot prompt
# Annotations this daemon injects into its own stream (see the GAP marker in
# run()). They are not board output and must never drive state detection.
RE_SELF_ANNOT = re.compile(r'^<<serial-agent ')
# Hard-fault / panic conditions meaning the board is dead or frozen and needs a
# reboot.  Cased to match real kernel/U-Boot output (the old 'OOPS:' never matched:
# the kernel prints 'Oops:').  Kept case-sensitive to avoid flipping to PANIC on
# benign lines like 'debug:' that a case-insensitive match would catch.
RE_PANIC    = re.compile(
    r'Kernel panic'
    r'|Internal error'
    r'|Unable to handle kernel'
    r'|Oops'                          # 'Internal error: Oops:' / 'Oops - undefined instruction'
    r'|BUG:'
    r'|Call trace:'
    r'|Unhandled fault'
    r'|SError'
    r'|Bad mode in'
    r'|Synchronous External Abort'
    r'|soft lockup|hard LOCKUP'          # the real fatal watchdog cases (not benign 'watchdog:' chatter)
    r'|detected stalls'
    r'|Rebooting in \d'
    r'|Kernel offset:'
    r'|data abort|prefetch abort'     # U-Boot aborts
)
# Boot-digest severity buckets — used by _boot_digest to pull the signal out of a
# multi-thousand-line boot log.  Broader than RE_PANIC (includes recoverable
# errors and warnings) but still skips the ordinary informational firehose.
RE_DIG_ERR  = re.compile(
    r'\berror\b|\bfail(ed|ure)?\b|\bfault\b|denied|refused|timeout|timed[ _-]?out'
    r'|cannot|segfault|\babort\b|\bnack\b|out of memory|\boom\b|corrupt|panic|Oops',
    re.I)
RE_DIG_WARN = re.compile(r'\bwarn(ing)?\b|deprecated|not found|no such|missing|invalid',
                         re.I)
RE_ANSI     = re.compile(r'\x1b(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])')
RE_TIMESTAMP= re.compile(r'^\[\d{2}:\d{2}:\d{2}\.\d+\] ')
RE_EXITCODE = re.compile(rf'^{EXITCODE_TAG}:(\d+)\s*$')


def _strip_ansi(text: str) -> str:
    return RE_ANSI.sub('', text)

def _strip_timestamps(lines: list) -> list:
    return [RE_TIMESTAMP.sub('', l) for l in lines]

def _clean_output(raw_lines: list, sent_cmd: str = '') -> tuple:
    """Strip noise from captured board output and extract the exit code.

    Processing steps (in order):
      1. Strip [HH:MM:SS.mmm] timestamp prefix from each line.
      2. Strip ANSI escape codes (colour, cursor movement, etc.).
      3. Strip bare CR characters (terminal line wrapping artefacts).
      4. Remove command echo. Two forms handled:
           Form 1 — board echoes 'prompt + command' on one line:
             e.g. 'root@board:~# uname -r' → first line removed.
           Form 2 — board echoes the bare command, possibly wrapped:
             e.g. 'uname', '-r' across two lines → those lines consumed.
      5. Strip lines matching SERIAL_EXITCODE:<N> and record the value.
      6. Remove trailing shell prompt line(s).
      7. Remove trailing blank lines.

    Args:
        raw_lines:  Lines from buf.log (with timestamps), as a list.
        sent_cmd:   The exact command that was sent (used for echo removal).
                    Pass '' to skip echo removal.

    Returns:
        (clean_text: str, exit_code: int | None)
        clean_text is newline-joined; exit_code is None if not found.
    """
    lines = _strip_timestamps(raw_lines)
    lines = [_strip_ansi(l) for l in lines]
    lines = [l.replace('\r', '') for l in lines]   # remove all CRs (mid-line wrapping)

    # Remove command echo. Three forms handled:
    #   1a. "prompt + command" on one line (board echoes with prompt, short cmd)
    #   1b. Wrapped: "prompt + start_of_cmd" then bare continuation lines
    #       (board's terminal is narrow, so long cmds wrap at terminal width)
    #   2.  Bare command lines only (no prompt — some board configs)
    # Note: --no-wrap sets COLUMNS=32767 env var for the executed command's
    # output, but the terminal echo of typed characters still wraps at the
    # board's tty cols setting.  Form 1b handles that wrapping.
    cmd_stripped = (sent_cmd or '').strip()
    if cmd_stripped and lines:
        first = lines[0].strip()
        if first.endswith(cmd_stripped) and len(first) > len(cmd_stripped):
            # Form 1a: entire command fits on one line after the prompt
            lines = lines[1:]
        else:
            # Form 1b: check if first line starts with "prompt + beginning of cmd"
            # by finding the longest suffix of first that is a prefix of cmd_stripped
            skip = 0
            matched = False
            for cut in range(len(first) + 1):
                tail = first[cut:]
                if tail and cmd_stripped.startswith(tail):
                    # first[cut:] is the start of the command echo
                    consumed = tail
                    skip = 1
                    if consumed == cmd_stripped:
                        matched = True
                        break
                    # Consume continuation lines until command is fully assembled
                    for line in lines[1:]:
                        chunk = line.strip()
                        if not chunk:
                            break
                        test = consumed + chunk
                        if test == cmd_stripped:
                            skip += 1; consumed = test; matched = True; break
                        elif cmd_stripped.startswith(test):
                            skip += 1; consumed = test
                        else:
                            break
                    break
            if not matched:
                # Form 2: bare command, possibly wrapped, no prompt prefix
                consumed = ''
                skip = 0
                for line in lines:
                    chunk = line.strip()
                    if not chunk:
                        break
                    test = consumed + chunk
                    if cmd_stripped.startswith(test):
                        consumed = test
                        skip += 1
                        if consumed == cmd_stripped:
                            break
                    else:
                        break
            lines = lines[skip:]

    # Extract exit code if present
    exit_code = None
    cleaned = []
    for l in lines:
        m = RE_EXITCODE.match(l.strip())
        if m:
            exit_code = int(m.group(1))
        else:
            cleaned.append(l)

    # Remove trailing prompt line(s). RE_SHELL matches ANY line ending in $ # or
    # >, so this has to be told what a prompt looks like or it deletes real
    # output: a kernel line quoting <someone@host>, or every closing tag of an
    # XML file. A prompt is short, is not a kernel log line, and is either the
    # user@host form or almost nothing but the sigil itself.
    def _is_prompt_line(l):
        t = l.strip()
        if not t or RE_KERNEL_TS.match(t):
            return False
        if RE_SHELL2.search(t):
            return True
        return bool(RE_SHELL.search(t)) and len(t) <= 4
    while cleaned and _is_prompt_line(cleaned[-1]):
        cleaned.pop()

    # Remove trailing blank lines
    while cleaned and not cleaned[-1].strip():
        cleaned.pop()

    return '\n'.join(cleaned), exit_code


# ── Helpers ────────────────────────────────────────────────────────────────────
def devname(device: str) -> str:
    return Path(device).name

def devdir(device: str) -> Path:
    d = AGENT_BASE / devname(device)
    d.mkdir(parents=True, exist_ok=True)
    return d

def ensure_symlink():
    """Keep /tmp/serial-agent pointing to the current user's storage.
    If it points elsewhere (another user created it first), update it."""
    try:
        _REAL_BASE.mkdir(parents=True, exist_ok=True)
        if _TMP_LINK.is_symlink():
            if _TMP_LINK.resolve() != _REAL_BASE.resolve():
                _TMP_LINK.unlink()
                _TMP_LINK.symlink_to(_REAL_BASE)
        elif _TMP_LINK.is_dir():
            try:
                _TMP_LINK.rmdir()          # only removes if empty
                _TMP_LINK.symlink_to(_REAL_BASE)
            except OSError:
                pass                       # non-empty or permission denied; leave it
        elif not _TMP_LINK.exists():
            _TMP_LINK.symlink_to(_REAL_BASE)
    except OSError:
        pass

def now() -> float:
    return time.monotonic()

def ts() -> str:
    return datetime.now().strftime('%H:%M:%S.%f')[:-3]


# ══════════════════════════════════════════════════════════════════════════════
# Daemon
# ══════════════════════════════════════════════════════════════════════════════
class Daemon:
    """Serial console daemon.

    Runs as a double-forked background process (see cmd_start). Maintains a
    persistent connection to a serial device (or ser2net TCP relay), writes
    timestamped output to buf.log, tracks the board state machine, and
    accepts commands via a named FIFO (input.fifo).

    Consumers interact through the filesystem:
      - Read status.json for current state and timestamps.
      - Read buf.log for recent board output.
      - Write to input.fifo (via CLI 'send') to send commands to the board.
      - Watch events.log for state transitions (via CLI 'wait-state').
    """

    quiet_from = ''

    def __init__(self, device, tcp, baud, lines, idle_timeout=0):
        self.device       = device
        self.tcp          = None   # relay address; set by _start_relay_if_direct
        self.baud         = baud
        self.maxlines     = lines
        self.idle_timeout = idle_timeout   # auto-stop when no relay clients for this many seconds (0=never)
        self.ddir     = devdir(device)
        self.buf_file    = self.ddir / 'buf.log'
        self.status_file = self.ddir / 'status.json'
        self.fifo_file   = self.ddir / 'input.fifo'
        self.pid_file    = self.ddir / 'daemon.pid'
        self.events_file = self.ddir / 'events.log'
        # Last N lines captured the moment a boot goes silent (FROZEN), so the
        # output that preceded a mid-boot hang is never scrolled out of a small read.
        self.frozen_file = self.ddir / 'frozen.snapshot'
        # Follower-friendly append-only stream (see _append): buf.log is a
        # ring rewritten by tmp+rename, so its inode changes on EVERY chunk
        # and tail -f/-F followers silently detach after the first byte.
        self.stream_file = self.ddir / 'stream.log'
        # Push channel for 'watch': subscribers open output.fifo O_RDONLY and the
        # daemon mirrors every raw serial chunk into it — best-effort, non-blocking.
        self.output_fifo = self.ddir / 'output.fifo'

        self.buf_lines: list = []
        # Preload the ring from a previous daemon's buf.log so a restart
        # doesn't wipe recent board history (it used to start empty and
        # immediately overwrite the file).
        try:
            if self.buf_file.exists():
                self.buf_lines = self.buf_file.read_text(
                    errors='replace').splitlines()[-lines:]
        except OSError:
            pass
        self._partial    = ''   # incomplete line between reads
        self.state        = 'UNKNOWN'
        self._prev_state  = 'UNKNOWN'
        self.t_output     = 0.0
        self.t_prompt     = 0.0
        # Monotonic: bumped only when a prompt actually arrives. t_prompt's
        # AGE is recomputed only when a byte arrives, so on an idle board it
        # freezes and cannot answer 'is this prompt newer than my command'.
        self.prompt_seq   = 0
        self.prompt_text  = ''
        self._stop        = Event()
        self._sock        = None
        self._fd          = None
        self._given_tcp      = tcp
        self._relay_clients: list = []
        self._relay_lock     = Lock()
        self._t_last_client  = 0.0   # monotonic time of last relay client connect/disconnect
        self._out_fd         = None  # lazily-opened O_WRONLY|O_NONBLOCK to output_fifo
        self._dead_since     = 0.0   # monotonic time the port went DEAD (for reconnect-gap marker)

    def _connect(self):
        """Open the serial device or TCP connection and configure terminal settings.

        Direct serial path:
          - O_RDWR|O_NOCTTY|O_NONBLOCK: open without blocking on DCD, without
            becoming the controlling terminal.
          - Raw mode (no ICANON, no ECHO): bytes pass through unprocessed.
          - ICRNL disabled: CR is not translated to NL, preserving raw framing.
          - VMIN=0, VTIME=1: non-blocking read with 100ms kernel timeout.
          - TIOCSWINSZ cols=220: tells the board's terminal driver the window is
            wide so commands and output don't wrap mid-line in the buffer.
          - ~HUPCL: prevents DTR from dropping when the fd is closed, which
            would reset the board.

        Returns the file descriptor (int) of the opened connection.
        Raises OSError on failure (caught by run()'s reconnect loop).
        """
        if self._given_tcp:
            host, port = self._given_tcp
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.connect((host, port))
            self._sock = s
            return s.fileno()
        else:
            fd = os.open(self.device, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
            bconst = {
                9600: termios.B9600,   19200: termios.B19200,  38400: termios.B38400,
                57600: termios.B57600, 115200: termios.B115200, 230400: termios.B230400,
                460800: termios.B460800, 921600: termios.B921600,
                1000000: getattr(termios, 'B1000000', termios.B115200),
                1500000: getattr(termios, 'B1500000', termios.B115200),
            }.get(self.baud, termios.B115200)
            saved = termios.tcgetattr(fd)
            attrs = list(saved)
            # Full raw-mode setup (cfmakeraw equivalent + daemon-specific flags).
            # The previous approach only cleared a subset of flags, leaving IXON/IXOFF
            # (XON/XOFF flow control), OPOST (output processing), ISIG, and IEXTEN
            # active — any 0x11/0x13 byte from the board would pause/resume output.
            _IXOFF   = getattr(termios, 'IXOFF',   0)
            _IXANY   = getattr(termios, 'IXANY',   0)
            _ECHOK   = getattr(termios, 'ECHOK',   0)
            _ECHONL  = getattr(termios, 'ECHONL',  0)
            _CRTSCTS = getattr(termios, 'CRTSCTS', 0)
            # c_iflag: disable all input translations and flow control
            attrs[0] &= ~(termios.IGNBRK | termios.BRKINT | termios.PARMRK |
                          termios.ISTRIP | termios.INLCR  | termios.IGNCR  |
                          termios.ICRNL  | termios.IXON   | _IXOFF         | _IXANY)
            # c_oflag: disable output processing (NL→CRNL etc.)
            attrs[1] &= ~termios.OPOST
            # c_cflag: 8n1, no hardware flow control, ignore modem lines, no DTR drop
            attrs[2] &= ~(termios.CSIZE | termios.PARENB | _CRTSCTS | termios.HUPCL)
            attrs[2] |=  termios.CS8 | termios.CLOCAL | termios.CREAD
            # c_lflag: raw input — no echo, no canonical, no signals, no extensions
            attrs[3] &= ~(termios.ECHO | _ECHOK | _ECHONL | termios.ECHOE |
                          termios.ICANON | termios.ISIG | termios.IEXTEN)
            # Baud rate
            attrs[4] = bconst; attrs[5] = bconst
            # VMIN=0 VTIME=1: select() drives the wait; os.read() returns immediately
            # or after a 100ms kernel timeout if a spurious wakeup delivered no data.
            vchars = [(b[0] if isinstance(b, bytes) else b) for b in attrs[6]]
            vchars[termios.VMIN] = 0; vchars[termios.VTIME] = 1
            attrs[6] = vchars   # list, NOT bytes — tcsetattr requires list
            termios.tcsetattr(fd, termios.TCSAFLUSH, attrs)
            # Set a wide terminal window so the board doesn't wrap output mid-line
            import struct, fcntl
            try:
                winsize = struct.pack('HHHH', 50, 220, 0, 0)  # rows=50, cols=220
                fcntl.ioctl(fd, termios.TIOCSWINSZ, winsize)
            except Exception:
                pass
            self._fd = fd
            return fd

    def _send_raw(self, data: bytes):
        if self._sock:
            self._sock.sendall(data)
            return
        if self._fd is None:
            return
        # The device fd is O_NONBLOCK: os.write can write FEWER bytes than given
        # (or raise EAGAIN) once the UART TX buffer fills.  The old code ignored the
        # count and wrote once, so a fast/large/pasted command lost its tail — that
        # dropped tail is what turns "echo start" into a mangled line on the board.
        # Loop over the remainder, using select() to wait for the port to drain
        # instead of busy-spinning.  The stall timer only fires after TX_STALL_TIMEOUT
        # of *zero* progress (reset on every successful write) so a large payload
        # drains fully while a genuinely wedged port (stuck flow control) still bails
        # with a visible drop rather than hanging the writer thread forever.
        mv = memoryview(data)
        stall_deadline = now() + TX_STALL_TIMEOUT
        while mv:
            try:
                n = os.write(self._fd, mv)
            except BlockingIOError:
                n = 0
            except OSError:
                return          # fd closed / device vanished — reconnect handles it
            if n:
                mv = mv[n:]
                stall_deadline = now() + TX_STALL_TIMEOUT
            elif now() > stall_deadline:
                print(f'[serial-agent] TX stalled — dropped {len(mv)} byte(s) to '
                      f'{self.device}', flush=True)
                return
            else:
                select.select([], [self._fd], [], 0.5)

    def _rotate_stream(self):
        # Deepen history cheaply: drop the oldest segment, shift .{N-1..1} → .{N..2},
        # then stream.log → .1.  Append-only + O(1) renames, so retention scales on
        # disk without growing the per-read buf.log ring.  Names are built explicitly
        # (NOT Path.with_suffix, which mis-parses the '.1' in 'stream.log.1').
        dd = self.ddir
        oldest = dd / f'stream.log.{STREAM_KEEP_SEGMENTS}'
        try:
            if oldest.exists():
                oldest.unlink()
        except OSError:
            pass
        for i in range(STREAM_KEEP_SEGMENTS - 1, 0, -1):
            src = dd / f'stream.log.{i}'
            if src.exists():
                try:
                    src.rename(dd / f'stream.log.{i + 1}')
                except OSError:
                    pass
        try:
            self.stream_file.rename(dd / 'stream.log.1')
        except OSError:
            pass

    def _update_state(self, text: str):
        """Update the board state machine from a chunk of received text.

        Checks are ordered by priority — earlier matches win:
          PANIC > UBOOT > LOGIN > PASSWORD > SHELL > BOOTING > DEAD > RUNNING

        PANIC always wins because a kernel oops in a flood of output should
        not be obscured by a shell prompt on another line.

        BOOTING is checked on the tail of the text (last 300 chars) to handle
        boards that print a shell prompt at the login screen while the kernel
        log is still flowing — LOGIN and SHELL checks see the last line, while
        BOOTING looks at the recent tail.

        State changes are written to events.log and status.json. Events are
        read by _wait_state() via inotifywait.
        """
        t = now()
        # Strip ANSI codes before pattern matching (handles colored prompts)
        clean = _strip_ansi(text)
        lines = [l for l in clean.replace('\r', '').split('\n')
                 if l.strip() and not RE_SELF_ANNOT.match(l.strip())]
        last = lines[-1] if lines else ''

        prev = self.state
        if RE_PANIC.search(clean[-500:]):
            self.state = 'PANIC'             # kernel panic / oops — board needs reboot
        elif RE_UBOOT.search(last) and not RE_KERNEL_TS.match(last):
            self.state = 'UBOOT'             # U-Boot interactive prompt
            self.t_prompt = t
            self.prompt_seq += 1
            self.prompt_text = last.strip()
        elif RE_LOGIN.search(last):
            self.state = 'LOGIN'
        elif RE_PASSWORD.search(last):
            self.state = 'PASSWORD'
        elif not RE_KERNEL_TS.match(last) and (
                RE_SHELL2.search(last) or (RE_SHELL.search(last) and len(last) >= 2)):
            self.state = 'SHELL'
            self.t_prompt = t
            self.prompt_seq += 1
            self.prompt_text = last.strip()
        elif RE_BOOT.search(clean[-300:]):
            self.state = 'BOOTING'
        # (IDLE is detected only via the idle-timeout in run(), not here, since
        # _update_state is only called when data arrives — t_output was just set.)
        elif (self.t_output > self.t_prompt
              and t - self.t_output > 0.2
              and t - self.t_prompt > RUNNING_AFTER):
            self.state = 'RUNNING'

        if self.state != self._prev_state:
            detail = f'  {self.prompt_text}' if self.state == 'SHELL' else ''
            entry = f'[{ts()}] {self._prev_state} → {self.state}{detail}'
            # Rotated append: keep last MAX_EVENTS lines
            try:
                existing = (self.events_file.read_text().splitlines()
                            if self.events_file.exists() else [])
                existing.append(entry)
                if len(existing) > MAX_EVENTS:
                    existing = existing[-MAX_EVENTS:]
                _etmp = self.events_file.with_suffix('.tmp')
                _etmp.write_text('\n'.join(existing) + '\n')
                _etmp.rename(self.events_file)
            except OSError:
                pass
            self._prev_state = self.state

    def _append(self, data: bytes):
        """Process a raw bytes chunk from the serial device.

        Decodes UTF-8 (replacing bad bytes), updates t_output and state,
        then assembles complete lines. Partial lines are held in self._partial
        and prepended to the next read — this prevents os.read() boundary
        splits (e.g. "6.18.13" + "-dirty\\n") from creating two log entries.

        Lines are timestamped and appended to buf_lines (ring buffer capped at
        self.maxlines). The full ring is rewritten to buf.log on every call so
        readers always see a consistent snapshot.
        """
        if self._relay_clients:
            with self._relay_lock:
                dead = []
                for c in list(self._relay_clients):
                    try:
                        c.sendall(data)
                    except OSError:
                        dead.append(c)
                for c in dead:
                    try:
                        self._relay_clients.remove(c)
                    except ValueError:
                        pass
        # Mirror the raw chunk to output.fifo for any 'watch' subscriber. Kept
        # best-effort + non-blocking so a slow/absent reader can never stall the
        # serial reader (a stalled reader here would drop board output).
        self._push_output(data)
        text = data.decode('utf-8', errors='replace')
        self.t_output = now()
        # Prepend any partial line buffered from the previous read to avoid
        # splitting lines across os.read() boundaries (e.g. "6.18.13" + "-dirty\n")
        full = self._partial + text
        # State detection reads the trailing line, and a shell prompt has no
        # newline to end it — so a read boundary inside one is routine. Matching
        # the raw chunk recorded the fragment (':~#', '-evm:~#') as prompt_text.
        self._update_state(full)
        parts = re.split(r'\r?\n', full)
        # If text didn't end with \n, the last element is an incomplete line
        if full and not full.endswith('\n'):
            self._partial = parts[-1]
            parts = parts[:-1]
        else:
            self._partial = ''
        new_entries = []
        for raw in parts:
            line = raw.strip('\r')
            if line:
                new_entries.append(f'[{ts()}] {line}')
        self.buf_lines.extend(new_entries)
        if len(self.buf_lines) > self.maxlines:
            self.buf_lines = self.buf_lines[-self.maxlines:]
        try:
            _btmp = self.buf_file.with_suffix('.tmp')
            _btmp.write_text('\n'.join(self.buf_lines) + '\n')
            _btmp.rename(self.buf_file)
        except OSError:
            pass
        # Append the same lines to stream.log (append mode: inode is stable,
        # so tail -f works). Rotate at STREAM_MAX_BYTES across STREAM_KEEP_SEGMENTS
        # numbered segments — a follower using tail -F survives the rotation.
        try:
            if new_entries:
                if (self.stream_file.exists()
                        and self.stream_file.stat().st_size > STREAM_MAX_BYTES):
                    self._rotate_stream()
                with open(self.stream_file, 'a') as _sf:
                    _sf.write('\n'.join(new_entries) + '\n')
        except OSError:
            pass
        self._write_status()

    def _push_output(self, data: bytes):
        """Best-effort, non-blocking mirror of a raw serial chunk to output.fifo.

        A 'watch' consumer opens output.fifo O_RDONLY. We open the write end
        O_WRONLY|O_NONBLOCK lazily (raises ENXIO while no reader is attached — one
        cheap failed syscall per chunk when nobody is watching). On a full pipe
        (slow reader) os.write raises EAGAIN and we DROP the chunk rather than
        block — the serial reader must never wait on a pipe.

        On EPIPE the previous reader is gone. We hold the write fd open across
        chunks for speed, so when a NEW watcher attaches the first chunk hits the
        stale fd; we must close, reopen, and rewrite THAT chunk in the same call —
        otherwise the first chunk after a reconnect is lost, starving the new
        watcher until its stream.log backstop fires (~10s instead of ~0.2ms; this
        was intermittent and only surfaced on real hardware).
        """
        for _ in range(2):
            if self._out_fd is None:
                try:
                    self._out_fd = os.open(str(self.output_fifo),
                                           os.O_WRONLY | os.O_NONBLOCK)
                except OSError:
                    return                # ENXIO: no reader attached
            try:
                os.write(self._out_fd, data)
                return
            except BlockingIOError:
                return                    # EAGAIN: pipe full — drop, never block
            except OSError:               # EPIPE: reader changed — reopen & retry
                try:
                    os.close(self._out_fd)
                except OSError:
                    pass
                self._out_fd = None

    def _write_status(self):
        t = now()
        s = {
            'quiet_from': self.quiet_from,
            'state':           self.state,
            'last_output_ago': round(t - self.t_output, 1) if self.t_output else None,
            'last_prompt_ago': round(t - self.t_prompt, 1) if self.t_prompt else None,
            'prompt_seq':      self.prompt_seq,
            'prompt_text':     self.prompt_text,
            'pid':             os.getpid(),
            'device':          self.device,
            'baud':            self.baud,
            'via':             (f'tcp:{self._given_tcp[0]}:{self._given_tcp[1]}'
                               if self._given_tcp else 'direct'),
            'relay':           (f'{self.tcp[0]}:{self.tcp[1]}' if self.tcp else None),
            'buf_file':        str(self.buf_file),
            'output_fifo':     str(self.output_fifo),
            'buf_lines':       len(self.buf_lines),
            'idle_timeout':    self.idle_timeout,
            # Whether the daemon currently holds the port.  In on-demand mode
            # (idle_timeout > 0) it parks with no fd between relay clients, and
            # writes to input.fifo are silently discarded; send() uses this to
            # explain a timeout instead of just reporting "timed out".
            'port_held':       self._sock is not None or self._fd is not None,
        }
        # Write atomically (tmp + rename, same dir so the rename is atomic).
        # status.json is rewritten on every state change and every received
        # byte, while ~30 call sites read it with a bare json.loads().  A
        # plain write_text() truncates first, so any concurrent reader can
        # observe a partial file and die on JSONDecodeError.
        _stmp = self.status_file.with_suffix('.json.tmp')
        try:
            _stmp.write_text(json.dumps(s, indent=2))
            _stmp.rename(self.status_file)
        except OSError:
            pass

    def _writer(self):
        """Daemon thread: relay commands from input.fifo to the serial device.

        Opens the FIFO for reading in blocking mode — this blocks until a
        sender opens the write end (i.e. until 'serial-agent send' runs).
        Once open, reads 256-byte chunks and writes them to the serial device.
        When the writer closes its end, f.read() returns b'' (EOF) and the
        loop restarts, blocking again for the next sender.

        Senders use O_WRONLY|O_NONBLOCK so they never block — they only
        succeed if this thread already has the FIFO open for reading.

        This is a daemon thread (daemon=True) so it is automatically killed
        when the main process exits — no explicit shutdown coordination needed.
        """
        while not self._stop.is_set():
            try:
                with open(self.fifo_file, 'rb') as f:
                    while not self._stop.is_set():
                        data = f.read(256)
                        if not data:
                            break
                        self._send_raw(data)
            except OSError:
                time.sleep(0.1)

    def _start_relay_if_direct(self):
        """Bind a loopback TCP relay so tio/socat can share the port.

        Always started, even when ser2net is the backend (_given_tcp set).
        The relay is the client-facing endpoint: serial-connect/socat always
        connect here.  This prevents socat from connecting directly to the
        ser2net port, which would trigger ser2net kickolduser and kick the
        daemon's own connection off.
        """
        srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        base = _relay_base_port()
        if base:
            for _p in range(base, base + 256):
                try: srv.bind(('127.0.0.1', _p)); break
                except OSError: continue
            else:
                srv.bind(('127.0.0.1', 0))   # fallback to ephemeral
        else:
            srv.bind(('127.0.0.1', 0))
        port = srv.getsockname()[1]
        # Only start idle timer at relay creation for on-demand mode (direct device).
        # For ser2net always-on mode (_given_tcp set), leave _t_last_client at 0.0
        # so the always-on idle check never fires until an actual relay client has
        # connected and disconnected — preventing the daemon from auto-stopping when
        # nobody has ever used the relay.
        if not self._given_tcp:
            self._t_last_client = now()
        srv.listen(8)
        self.tcp = ('127.0.0.1', port)
        self._write_status()
        Thread(target=self._relay_accept_loop, args=(srv,), daemon=True).start()

    def _relay_accept_loop(self, srv):
        srv.settimeout(1.0)
        while not self._stop.is_set():
            try:
                conn, _ = srv.accept()
            except socket.timeout:
                continue
            except OSError:
                break
            with self._relay_lock:
                self._relay_clients.append(conn)
                self._t_last_client = now()
            Thread(target=self._relay_client_reader, args=(conn,), daemon=True).start()
        srv.close()

    def _relay_client_reader(self, conn):
        try:
            while not self._stop.is_set():
                data = conn.recv(4096)
                if not data:
                    break
                self._send_raw(data)
        except OSError:
            pass
        finally:
            with self._relay_lock:
                try:
                    self._relay_clients.remove(conn)
                except ValueError:
                    pass
                self._t_last_client = now()   # restart idle timer when client disconnects
            try:
                conn.close()
            except OSError:
                pass

    def run(self):
        """Main daemon loop. Runs after double-fork in cmd_start.

        Lifecycle:
          1. Write PID file and initial status.json (UNKNOWN state).
          2. Create input.fifo (if missing).
          3. Install SIGTERM/SIGINT handlers that set self._stop.
          4. Start _writer thread (daemon=True).
          5. Outer loop: call _connect(), run inner select loop, reconnect on error.

        Reconnect backoff starts at 1s, doubles on each failure up to 30s.
        Backoff resets to 1s on each successful connection.

        Startup probe: if the board sends nothing within 0.5s of connect,
        the daemon sends a bare CR (\r). This wakes an idle board at a shell
        prompt so the state transitions from UNKNOWN to SHELL immediately,
        without requiring the user to send a command first. The probe is
        skipped if the board is already talking (t_output is set) to avoid
        interrupting U-Boot autoboot.

        EAGAIN handling: os.read() on an O_NONBLOCK fd can raise EAGAIN even
        after select() reports the fd readable (spurious wakeup from a modem
        control line change). This is caught and treated as 'no data yet' —
        the select loop continues rather than treating it as a disconnect.
        """
        self.pid_file.write_text(str(os.getpid()))
        self._write_status()

        # Always-on (idle_timeout=0) vs on-demand (idle_timeout>0) modes.
        # Always-on: hold physical fd + lock file continuously.  Port always shows
        # OPEN in serial-discover; startup probe fires at t=0.5s; _send_raw works
        # immediately because _fd is never None.  serial-connect uses this mode.
        # On-demand: release fd when no relay client is connected.  _send_raw is a
        # silent no-op while parked (_fd=None), which causes send() callers to
        # time out with no error.  Only useful for short-lived automation sessions
        # where holding the port would block other tools; set --idle-timeout N.
        on_demand = self.idle_timeout > 0 and not self._given_tcp
        _lf_path = Path('/tmp/serial-connect-locks') / Path(self.device).name
        # The lock file is managed exclusively by serial-connect (_lock_acquire /
        # _lock_release) as a human-session signal.  The daemon must NOT write it
        # in always-on mode: doing so makes the port permanently appear OPEN in
        # serial-discover and serial-connect, preventing normal (non-force-close)
        # connections even when no human session is active.  On-demand mode writes
        # the lock only while physically holding the fd (relay client connected).
        if on_demand:
            self._lock_file = None   # acquired/released dynamically with fd
        else:
            self._lock_file = None   # never written; serial-connect owns the lock

        if not self.fifo_file.exists():
            os.mkfifo(self.fifo_file)
        if not self.output_fifo.exists():
            os.mkfifo(self.output_fifo)
        signal.signal(signal.SIGTERM, lambda *_: self._stop.set())
        signal.signal(signal.SIGINT,  lambda *_: self._stop.set())
        Thread(target=self._writer, daemon=True).start()
        self._start_relay_if_direct()

        backoff = 1.0
        _absent_since = None   # wall-clock when a local device node first went missing
        while not self._stop.is_set():
            # On-demand: park until a relay client connects.
            if on_demand and not self._relay_clients:
                if (self._t_last_client > 0
                        and now() - self._t_last_client > self.idle_timeout
                        and not _human_session_active(self.device)):
                    print(f'[serial-agent] idle {self.idle_timeout}s — auto-stopping', flush=True)
                    self._stop.set()
                    break
                time.sleep(0.1)
                continue

            # On-demand: acquire lock file now that we're about to hold the fd.
            if on_demand and self._lock_file is None:
                try:
                    _lf_path.parent.mkdir(mode=0o1777, exist_ok=True)
                    os.chmod(_lf_path.parent, 0o1777)
                    _lf_path.write_text(f'{os.getpid()}\n{os.environ.get("USER", "")}\n')
                    self._lock_file = _lf_path
                except OSError:
                    pass

            _clients_gone = False
            try:
                rfd = self._connect()
                backoff = 1.0
                _absent_since = None
                # Reconnect-gap marker: while the port was DEAD nobody held it, so any
                # board output in that window was lost.  Make the gap VISIBLE in the log
                # — an agent parsing a boot otherwise cannot tell output is missing.
                if self._dead_since:
                    _gap = now() - self._dead_since
                    self._dead_since = 0.0
                    if _gap >= GAP_MARKER_MIN:
                        self._append(
                            f'\r\n<<serial-agent GAP {_gap:.1f}s — port reopened; board '
                            f'output during this window may be lost>>\r\n'.encode())
                t_connected = now()
                _probe_sent = False
                _t_last_idle_probe = t_connected
                print(f'[serial-agent] {self.device} connected '
                      f'via {"ser2net" if self._given_tcp else "direct"}', flush=True)
                # Refresh status so port_held reflects the now-open port.  Without
                # this the field keeps the value it had at daemon startup (False)
                # until the board happens to send a byte.
                self._write_status()
                while not self._stop.is_set():
                    # On-demand: release device when all relay clients have left.
                    if on_demand and not self._relay_clients:
                        _clients_gone = True
                        break
                    r, _, _ = select.select([rfd], [], [], 0.5)
                    if r:
                        try:
                            data = os.read(rfd, 4096)
                        except OSError as _e:
                            if _e.errno == errno.EAGAIN:
                                continue   # spurious wakeup — no data yet
                            raise
                        if not data:
                            # EOF — device or TCP peer closed the connection.  A reboot
                            # flaps the node briefly, so retry FAST for a short window
                            # (shrinks the lost-output gap from ~1s to ~0.2s) before
                            # falling back to exponential backoff for a genuinely gone
                            # peer.  Without any sleep the outer loop would spin at full
                            # speed re-connecting and immediately getting EOF again.
                            if not _clients_gone and not self._stop.is_set():
                                if self.state != 'DEAD':
                                    _prev = self._prev_state
                                    self.state = 'DEAD'
                                    self._prev_state = 'DEAD'
                                    self._dead_since = now()
                                    self._write_status()
                                    _entry = f'[{ts()}] {_prev} → DEAD  (eof)'
                                    try:
                                        _ex = (self.events_file.read_text().splitlines()
                                               if self.events_file.exists() else [])
                                        _ex.append(_entry)
                                        if len(_ex) > MAX_EVENTS:
                                            _ex = _ex[-MAX_EVENTS:]
                                        _etmp = self.events_file.with_suffix('.tmp')
                                        _etmp.write_text('\n'.join(_ex) + '\n')
                                        _etmp.rename(self.events_file)
                                    except OSError:
                                        pass
                                if now() - (self._dead_since or now()) < RECONNECT_FAST_WINDOW:
                                    _delay = RECONNECT_FAST_DELAY
                                else:
                                    _delay = backoff
                                    backoff = min(backoff * 2, 30)
                                print(f'[serial-agent] {self.device} disconnected (EOF) '
                                      f'— retry in {_delay}s', flush=True)
                                time.sleep(_delay)
                            break
                        self._append(data)
                    else:
                        # Startup probe: one bare CR sent 0.5 s after connect if the
                        # board has been silent.  Wakes an idle board at a shell prompt
                        # so state transitions UNKNOWN → SHELL without user input.
                        # The probe is intentionally NOT suppressed by an active human
                        # session — a single CR is harmless and necessary for state
                        # bootstrap.  serial-connect starts the daemon BEFORE writing
                        # human_session (via _lock_acquire), so the probe fires first.
                        if (not _probe_sent and self.state == 'UNKNOWN'
                                and not self.t_output
                                and now() - t_connected > 0.5):
                            self._send_raw(b'\r')
                            _probe_sent = True
                        # Idle keepalive: a board sitting quietly at a live prompt is
                        # not dead, it's just quiet.  Nudge it so a genuinely alive
                        # board's echo refreshes t_output before DEAD_AFTER elapses.
                        # Gated on t_output (not on our own probe) so a truly
                        # unresponsive board still reaches IDLE — sending a probe must
                        # never by itself mask a real silence timeout.  Suppressed
                        # during an active human session — a stray CR mid-keystroke
                        # could execute a partial command (same reasoning as the
                        # idle-auto-stop checks).
                        if (self.state in ('SHELL', 'UBOOT')
                                and now() - self.t_output > IDLE_PROBE_INTERVAL
                                and now() - _t_last_idle_probe > IDLE_PROBE_INTERVAL
                                and not _human_session_active(self.device)):
                            self._send_raw(b'\r')
                            _t_last_idle_probe = now()
                        if self.t_output and now() - self.t_output > DEAD_AFTER:
                            # Console silent > DEAD_AFTER.  Two flavours:
                            #   FROZEN — went quiet mid-boot (BOOTING) or right after
                            #     a panic, i.e. WITHOUT reaching a usable prompt: a
                            #     hang.  Snapshot the last lines so the output that
                            #     preceded the hang survives a small 'read'.
                            #   QUIET  — a usable prompt (or unknown) sitting idle; the
                            #     daemon is HEALTHY and still holds the port.  (Renamed
                            #     from IDLE, which collided with the parked-daemon trap
                            #     and got healthy daemons force-restarted.)
                            if self.state not in ('QUIET', 'FROZEN'):
                                _prev = self._prev_state
                                # FROZEN = genuine mid-boot hang (never reached a prompt)
                                # or panic; a board that DID show a prompt then went silent
                                # is just idle → QUIET, even if a late boot line flipped
                                # state back to BOOTING.
                                _silent = ('FROZEN'
                                           if self.state == 'PANIC'
                                           or (self.state == 'BOOTING' and self.t_prompt == 0.0)
                                           else 'QUIET')
                                self.quiet_from = _prev
                                self.state = _silent
                                self._prev_state = _silent
                                self._write_status()
                                if _silent == 'FROZEN':
                                    try:
                                        _snap = self.buf_lines[-BOOT_DIGEST_TAIL:]
                                        self.frozen_file.write_text('\n'.join(_snap) + '\n')
                                    except OSError:
                                        pass
                                    _note = (f'boot stalled — silent {DEAD_AFTER:.0f}s '
                                             f'before a prompt; last output preserved')
                                else:
                                    _note = 'console silent'
                                # Write to events.log so _wait_state can detect this
                                # via inotifywait — without it the state is only in
                                # status.json and _wait_state's loop never sees it.
                                _entry = f'[{ts()}] {_prev} → {_silent}  ({_note})'
                                try:
                                    _existing = (self.events_file.read_text().splitlines()
                                                 if self.events_file.exists() else [])
                                    _existing.append(_entry)
                                    if len(_existing) > MAX_EVENTS:
                                        _existing = _existing[-MAX_EVENTS:]
                                    _etmp = self.events_file.with_suffix('.tmp')
                                    _etmp.write_text('\n'.join(_existing) + '\n')
                                    _etmp.rename(self.events_file)
                                except OSError:
                                    pass
                        # Always-on idle-stop (on-demand uses the outer-loop check).
                        if (not on_demand and self.idle_timeout > 0
                                and not self._relay_clients
                                and self._t_last_client > 0
                                and now() - self._t_last_client > self.idle_timeout
                                and not _human_session_active(self.device)):
                            print(f'[serial-agent] idle {self.idle_timeout}s — auto-stopping', flush=True)
                            self._stop.set()
            except (ConnectionRefusedError, OSError) as e:
                if not _clients_gone:
                    # A missing local device node (ENOENT) is a transient USB
                    # re-enumeration far more often than a real fault: poll at a
                    # short fixed interval during an initial fast window so we
                    # reconnect ~1 poll after the node reappears instead of up to
                    # 30s later.  Only past the window (board powered off) do we
                    # fall back to the exponential backoff, so a long-gone board
                    # does not spam logs.  Real errors (refused TCP, EACCES) keep
                    # the escalating backoff from the first failure.
                    _absent = (not self._given_tcp
                               and getattr(e, 'errno', None) == errno.ENOENT)
                    if _absent and _absent_since is None:
                        _absent_since = now()
                    if not _absent:
                        _absent_since = None
                    if _absent and now() - _absent_since < DEVICE_ABSENT_FAST_WINDOW:
                        _delay = DEVICE_ABSENT_POLL
                    else:
                        _delay = backoff
                        backoff = min(backoff * 2, 30)
                    print(f'[serial-agent] connect error: {e} — retry in {_delay}s', flush=True)
                    # Record the DEAD transition once, not on every poll iteration.
                    if self.state != 'DEAD':
                        _prev = self._prev_state
                        self.state = 'DEAD'
                        self._prev_state = 'DEAD'
                        self._dead_since = now()
                        self._write_status()
                        _entry = f'[{ts()}] {_prev} → DEAD  (connect error)'
                        try:
                            _ex = (self.events_file.read_text().splitlines()
                                   if self.events_file.exists() else [])
                            _ex.append(_entry)
                            if len(_ex) > MAX_EVENTS: _ex = _ex[-MAX_EVENTS:]
                            _etmp = self.events_file.with_suffix('.tmp')
                            _etmp.write_text('\n'.join(_ex) + '\n')
                            _etmp.rename(self.events_file)
                        except OSError:
                            pass
                    time.sleep(_delay)
            finally:
                if self._sock:
                    try: self._sock.close()
                    except: pass
                    self._sock = None
                if self._fd is not None:
                    try: os.close(self._fd)
                    except: pass
                    self._fd = None
                # Port is gone — record that before parking or reconnecting, so
                # port_held never advertises a port the daemon no longer holds.
                self._write_status()
                if on_demand:
                    # Release lock file — port is no longer held by this daemon.
                    if self._lock_file is not None:
                        try: self._lock_file.unlink(missing_ok=True)
                        except OSError: pass
                        self._lock_file = None
                    if _clients_gone:
                        self.state = 'UNKNOWN'
                        self._write_status()

        self.pid_file.unlink(missing_ok=True)
        if getattr(self, '_lock_file', None):
            try: self._lock_file.unlink(missing_ok=True)
            except OSError: pass
        print('[serial-agent] stopped', flush=True)


# ══════════════════════════════════════════════════════════════════════════════
# Utilities
# ══════════════════════════════════════════════════════════════════════════════
def _relay_base_port() -> int:
    """Return RELAY_BASE_PORT from serial-boards.conf, or 0 (ephemeral) if unset.

    Mirrors serial-common.sh two-layer config model: for a global install
    (/usr/... or /opt/...) the system config /etc/serial-boards.conf is read
    first (it holds the canonical RELAY_BASE_PORT); the user config can override.
    Previously this only read the user config, so RELAY_BASE_PORT in
    /etc/serial-boards.conf was silently ignored and every daemon got a random
    ephemeral port — causing relay disconnects whenever the daemon restarted.
    """
    confs: list = [_resolve_board_cfg()]
    if str(_SCRIPT_DIR).startswith(('/usr/', '/opt/')):
        confs.insert(0, Path('/etc/serial-boards.conf'))
    for cfg in confs:
        try:
            for line in cfg.read_text().splitlines():
                line = line.split('#')[0].strip()
                if line.upper().startswith('RELAY_BASE_PORT'):
                    _, _, val = line.partition('=')
                    port = int(val.strip())
                    if 1024 <= port <= 64999:
                        return port
        except Exception:
            continue
    return 0


def find_ser2net_port(device: str):
    # SERIAL_SER2NET_CONF overrides the config path (non-root installs, testing).
    _envc = os.environ.get('SERIAL_SER2NET_CONF')
    for cfg in ([_envc] if _envc else ['/etc/ser2net.yaml', '/etc/ser2net.conf']):
        try:
            text = Path(cfg).read_text()
        except OSError:
            continue
        lines = text.split('\n')
        for i, line in enumerate(lines):
            if device in line and 'serialdev' in line:
                block = '\n'.join(lines[max(0, i-8):i+8])
                m = re.search(r'accepter\s*:\s*(?:telnet,)?tcp[^,\n]*,\s*(\d+)', block, re.I)
                if m:
                    return f'localhost:{m.group(1)}'
    return None


def _seeks_prompt(pat, pattern: str) -> bool:
    """True if `pat` is waiting for a shell or U-Boot prompt.

    Decided by asking whether the pattern actually matches a prompt, not by
    comparing the regex source. String equality missed every pattern that merely
    contains the prompt alternative -- cmd_login waits on
    `Password|[\\$#>]\\s*$` -- and since a prompt has no trailing newline it
    never reaches buf.log either, so the wait burned its whole timeout on a login
    that had already succeeded.
    """
    if any(pat.search(sample) for sample in ('root@host:~# ', '# ', '$ ', '=> ')):
        return True
    # A caller pasting its own board's prompt literal, e.g. root@am62dxx-evm:~#,
    # matches no generic sample but is still a prompt wait.
    return bool(re.search(r'\w+@[\w.\-]+\S*[#$>]', pattern))


def _echo_free(text: str, cmd: str) -> str:
    """Drop the terminal's echo of `cmd` from the front of `text`.

    A marker inside the command matches its own echo before the board has
    answered, so `--wait DONE` on `echo DONE` returns immediately with an empty
    reply. Only the LEADING run of lines is consumed, and only while they keep
    spelling out the command, so real output is never eaten even when it repeats
    a word from the command. The board wraps long commands across lines, which
    is why this accumulates rather than comparing line by line.
    """
    if not cmd:
        return text
    norm = re.sub(r'\s+', '', _strip_ansi(cmd))
    if not norm:
        return text
    lines = text.split('\n')
    acc, i = '', 0
    while i < len(lines) and len(acc) < len(norm):
        l = re.sub(r'\s+', '', RE_TIMESTAMP.sub('', _strip_ansi(lines[i])))
        if '#' in l:                      # drop a leading shell prompt
            l = l.split('#', 1)[1]
        if not l:
            i += 1
            continue
        if norm.startswith(acc + l):
            acc += l
            i += 1
            continue
        break
    return '\n'.join(lines[i:])


def _wait_pattern(device, pattern, timeout, show=False, baseline_offset=None,
                  echo_of=None):
    """Poll buf.log until `pattern` appears or timeout expires.

    Args:
        device:          /dev/ttyUSBx path.
        pattern:         Regex string. Matched against ANSI-stripped new content.
        timeout:         Seconds to wait before returning False.
        show:            If True, print new lines to stdout as they arrive
                         (used by 'send' without --json/--capture).
        baseline_offset: Byte offset in buf.log to start reading from. Set
                         this to the file size snapped BEFORE the command was
                         written to the FIFO so pre-command output is excluded.
                         None = snap to current end at call time.

    Returns True if pattern matched, False on timeout or daemon death.

    Adaptive polling: 50ms for the first second (fast response for quick
    commands), then 200ms (reduces CPU for long-running commands).

    Daemon liveness is checked at the top of each iteration. If the daemon
    dies mid-wait, returns False immediately rather than burning the timeout.
    """
    bf = devdir(device) / 'stream.log'
    if not bf.exists():
        bf = devdir(device) / 'buf.log'   # pre-stream.log daemon
    sf = devdir(device) / 'status.json'
    pat = re.compile(pattern)
    _prompt_wait = _seeks_prompt(pat, pattern)
    try:
        _seq0 = json.loads((devdir(device) / 'status.json').read_text()).get('prompt_seq')
    except (OSError, ValueError):
        _seq0 = None
    deadline = time.time() + timeout
    t_start = time.time()
    baseline = baseline_offset if baseline_offset is not None else (
        bf.stat().st_size if bf.exists() else 0)

    while time.time() < deadline:
        if not _daemon_running(device):
            return False

        interval = 0.05 if (time.time() - t_start) < 1.0 else 0.2
        time.sleep(interval)

        # ── Fast path: check status.json for a fresh SHELL state ───────────
        # Shell prompts don't end with \n so _append holds them in _partial
        # (never written to buf.log).  _update_state() still detects SHELL
        # via the raw text and updates status.json, so we check here too.
        # Guard: last_prompt_ago must be < elapsed so we match the prompt
        # from THIS command, not a pre-existing SHELL from before the send.
        if _prompt_wait:
            try:
                s = json.loads(sf.read_text())
                if s.get('state') == 'SHELL' or _is_uboot(s):
                    seq = s.get('prompt_seq')
                    if seq is not None:
                        # Only a prompt that arrived AFTER we started counts.
                        if _seq0 is not None and seq > _seq0:
                            return True
                    else:
                        lpa = s.get('last_prompt_ago')   # daemon predates the counter
                        elapsed = time.time() - t_start
                        if lpa is not None and lpa < elapsed:
                            return True
            except (OSError, ValueError, KeyError):
                pass

        if not bf.exists():
            continue
        sz = bf.stat().st_size
        if sz < baseline:
            baseline = 0     # stream.log rotated (8 MB) — re-anchor
        if sz <= baseline:
            continue

        try:
            with open(bf, 'rb') as f:
                f.seek(baseline)
                new = f.read().decode('utf-8', errors='replace')
        except OSError:
            continue
        baseline = sz

        if new and show:
            for line in new.splitlines():
                print(RE_TIMESTAMP.sub('', line))
            sys.stdout.flush()

        if pat.search(_strip_ansi(_echo_free(new, echo_of))):
            return True

    return False


def _human_session_active(device: str) -> bool:
    """Return True if a human serial-connect/tio session is active for this device.

    Reads ~/var/serial-agent/<devname>/human_session (written by serial-connect
    _lock_acquire). Format: line 1 = PID, line 2 = Unix epoch float.
    Returns False and removes the file if PID is dead or epoch is >300s old.
    """
    hf = devdir(device) / 'human_session'
    if not hf.exists():
        return False
    try:
        lines = hf.read_text().strip().splitlines()
        if len(lines) < 2:
            hf.unlink(missing_ok=True)
            return False
        pid   = int(lines[0])
        epoch = float(lines[1])
        try:
            os.kill(pid, 0)
        except OSError:
            hf.unlink(missing_ok=True)
            return False
        if time.time() - epoch > 300:
            hf.unlink(missing_ok=True)
            return False
        return True
    except (ValueError, OSError):
        hf.unlink(missing_ok=True)
        return False


def _log_op(device: str, op: str, **kwargs):
    """Append one JSON entry to ops.log (ring-capped at 500 lines)."""
    log_file = devdir(device) / 'ops.log'
    entry = json.dumps({'ts': ts(), 'op': op, 'pid': os.getpid(), **kwargs})
    try:
        existing = log_file.read_text().splitlines() if log_file.exists() else []
        existing.append(entry)
        if len(existing) > 500:
            existing = existing[-500:]
        _tmp = log_file.with_suffix('.tmp')
        _tmp.write_text('\n'.join(existing) + '\n')
        _tmp.rename(log_file)
    except OSError:
        pass


def _daemon_running(device: str) -> bool:
    """Return True if a daemon process for this device is alive.

    Reads daemon.pid and sends kill(pid, 0) — a zero-signal that checks
    process existence without delivering anything. Returns False if the
    PID file is missing, unreadable, or the process no longer exists.

    Called frequently (per poll iteration in wait loops) so must be fast.
    The kill(0) syscall is O(1) and does not block.
    """
    pf = devdir(device) / 'daemon.pid'
    if not pf.exists():
        return False
    try:
        pid = int(pf.read_text().strip())
        os.kill(pid, 0)
    except (OSError, ValueError):
        return False
    # kill(pid, 0) only proves *some* signalable process owns this PID.  After
    # a daemon dies its PID is eventually recycled, and a hit on an unrelated
    # process made 'start' report "ALREADY daemon PID ..." for a daemon that
    # was long gone — leaving the device unusable until the pid file was
    # removed by hand.  Confirm the PID really is a serial-agent before
    # trusting it.  If /proc is unavailable, fall back to the kill(0) result.
    try:
        cmdline = Path(f'/proc/{pid}/cmdline').read_bytes()
    except OSError:
        return not Path('/proc').is_dir()
    return b'serial-agent' in cmdline


def _is_agent_pid(pid: int) -> bool:
    """True if pid is a serial-agent daemon (not tio/ser2net/cat/a shell)."""
    try:
        return b'serial-agent' in Path(f'/proc/{pid}/cmdline').read_bytes()
    except OSError:
        return False


def _is_real_serial(device: str) -> bool:
    """True for a physical UART. A pty's 'holder' may be the master side of a
    bridge (socat pty,link=), so fuser cannot prove a read conflict there."""
    return bool(re.match(r'^/dev/tty(USB|ACM|S|AMA)\d+$', device))


def _device_holders(device: str) -> list:
    """PIDs holding the tty open, excluding this process. Empty if fuser is absent."""
    import subprocess
    try:
        r = subprocess.run(['fuser', device], capture_output=True, text=True)
    except FileNotFoundError:
        return []
    out = []
    for p in r.stdout.split():
        try:
            pid = int(p)
        except ValueError:
            continue
        if pid != os.getpid():
            out.append(pid)
    return out


# ══════════════════════════════════════════════════════════════════════════════
# CLI commands
# ══════════════════════════════════════════════════════════════════════════════
def cmd_start(args):
    """Start a daemon for a serial device.

    Double-forks to detach from the terminal (setsid + second fork). The
    parent waits 0.6s then prints the PID and buf.log path from status.json.
    On start, ALL previous state files for this device are removed so stale
    data from a prior session cannot corrupt the new one.

    Exits silently if status.json does not appear within 0.6s (daemon failed
    to start — check daemon.log for the reason).
    """
    tcp = None
    if args.tcp:
        host, port = args.tcp.rsplit(':', 1)
        tcp = (host, int(port))

    ensure_symlink()
    AGENT_BASE.mkdir(parents=True, exist_ok=True)

    ddir = devdir(args.device)
    # Guard: if a daemon is already running, report its status and return.
    # Without this, 'start' would delete the running daemon's pid file, making
    # it unmanageable — it holds the device open but can never be stopped.
    if _daemon_running(args.device):
        sf = ddir / 'status.json'
        if sf.exists():
            s = json.loads(sf.read_text())
            print(f"ALREADY  daemon PID {s['pid']}  {args.device}  via {s['via']}")
        else:
            print(f"ALREADY  daemon running for {args.device}")
        return

    # Fully leverage ser2net when available: if it is configured for this device
    # (and neither --tcp nor --no-ser2net was given), route through it — network /
    # multi-host fan-out that survives daemon restarts. Config-based, like the
    # detection connect/discover already do; if ser2net isn't actually up the
    # daemon's reconnect loop backs off exactly as it would for an explicit --tcp.
    # Direct + built-in relay stays the fallback when no ser2net config exists.
    if tcp is None and not getattr(args, 'no_ser2net', False):
        _s2 = find_ser2net_port(args.device)
        if _s2:
            _h, _p = _s2.rsplit(':', 1)
            tcp = (_h, int(_p))
            print(f"ser2net configured for {args.device} at {_s2} — routing through it")

    # daemon.pid is not proof: it gets deleted by hand (the documented restart
    # recipe does exactly that) while the old daemon lives on.  Two daemons then
    # read() the same tty, each byte reaches only one of them, and the console
    # shows roughly every other character.  Check the device, not the file.
    # One daemon owns the tty; sharing happens above it, on the relay/fifo.
    if tcp is None:
        holders = _device_holders(args.device)
        orphan = next((p for p in holders if _is_agent_pid(p)), None)
        if orphan is not None:
            ddir.mkdir(parents=True, exist_ok=True)
            (ddir / 'daemon.pid').write_text(str(orphan))
            print(f"ADOPTED  orphaned daemon PID {orphan} for {args.device} "
                  f"— daemon.pid restored, no second daemon started")
            return
        if holders:
            who = ', '.join(map(str, holders))
            if _is_real_serial(args.device):
                print(f"REFUSED  {args.device} is already held by PID(s) {who} — a "
                      f"second reader would split the byte stream.\n"
                      f"         serial-agent stop {args.device} --force",
                      file=sys.stderr)
                sys.exit(1)
            print(f"WARNING  {args.device} is already held by PID(s) {who}",
                  file=sys.stderr)

    # Remove CONTROL files so an old daemon can't steal commands. buf.log is
    # deliberately kept: it is pure output history, the new daemon preloads it
    # into its ring so board context survives restarts (it used to be wiped,
    # which destroyed history at every restart and broke debugging sessions).
    # Runs only once we know no live daemon owns the device — wiping first would
    # strip a still-running orphan of its status.json and fifos.
    for stale in ('status.json', 'daemon.pid', 'input.fifo', 'output.fifo', 'events.log'):
        (ddir / stale).unlink(missing_ok=True)

    pid = os.fork()
    if pid:
        time.sleep(0.6)
        sf = ddir / 'status.json'
        if sf.exists():
            s = json.loads(sf.read_text())
            print(f"daemon PID {s['pid']}  {args.device}  via {s['via']}")
            print(f"  buf:  {s['buf_file']}")
            print(f"  tail: tail -F {Path(s['buf_file']).parent / 'stream.log'}")
        else:
            print(f"daemon failed to start — check {ddir}/daemon.log", file=sys.stderr)
            sys.exit(1)
        return

    os.setsid()
    if os.fork():
        os._exit(0)

    # Redirect fds 0/1/2 so any inherited pipe write-ends (e.g. from
    # subprocess.run(capture_output=True)) are released.  Without this,
    # subprocess.run blocks waiting for EOF on stdout even after the
    # parent has exited, because the grandchild still holds fd=1 open
    # via sys.__stdout__ (Python keeps the original TextIOWrapper alive).
    null_fd = os.open('/dev/null', os.O_RDONLY)
    os.dup2(null_fd, 0); os.close(null_fd)
    log_fd = os.open(str(ddir / 'daemon.log'), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    os.dup2(log_fd, 1); os.dup2(log_fd, 2); os.close(log_fd)
    # Reassign Python file objects to match the new fds.
    sys.stdin  = open('/dev/null', 'r')
    sys.stdout = open(ddir / 'daemon.log', 'a', buffering=1)
    sys.stderr = sys.stdout
    Daemon(args.device, tcp, args.baud, args.lines, args.idle_timeout).run()


def cmd_stop(args):
    """Send SIGTERM to the daemon and wait up to 3s for it to exit.

    Waits for the process to actually exit before returning so that an
    immediate 'serial-agent start' after 'stop' does not race against the
    dying daemon on the serial device. The daemon's run() loop removes
    daemon.pid on clean exit; cmd_stop also removes it as a fallback for
    crash/SIGKILL cases.

    Also SIGTERMs any other processes still holding the device (stale
    restarts or orphaned sessions caught by fuser).

    Refuses to stop if a human tio session is active unless --force is given.
    serial-connect removes the human_session file before calling stop on exit,
    so normal cleanup always proceeds; only external/accidental stops are blocked.
    """
    if _human_session_active(args.device) and not getattr(args, 'force', False):
        print(f'human session active for {args.device} — refusing stop '
              f'(use --force to override or wait for tio to exit)',
              file=sys.stderr)
        sys.exit(1)
    pf = devdir(args.device) / 'daemon.pid'
    killed = []
    if pf.exists():
        try:
            pid = int(pf.read_text().strip())
            os.kill(pid, signal.SIGTERM)
            killed.append(pid)
            for _ in range(30):   # wait up to 3s for clean exit
                try: os.kill(pid, 0); time.sleep(0.1)
                except OSError: break
        except (OSError, ValueError):
            pass
        pf.unlink(missing_ok=True)
    # Also kill any other processes still holding the device (stale restarts,
    # ser2net, orphaned tio sessions). SIGTERM first, SIGKILL if they don't exit.
    import subprocess
    fuser_pids = []
    try:
        r = subprocess.run(['fuser', args.device], capture_output=True, text=True)
        for p in r.stdout.split():
            try:
                pid2 = int(p)
                if pid2 not in killed:
                    os.kill(pid2, signal.SIGTERM)
                    killed.append(pid2)
                    fuser_pids.append(pid2)
            except (OSError, ValueError):
                pass
    except FileNotFoundError:
        pass
    if fuser_pids:
        for _ in range(15):   # wait up to 1.5s for graceful exit
            fuser_pids = [p for p in fuser_pids if os.path.exists(f'/proc/{p}')]
            if not fuser_pids:
                break
            time.sleep(0.1)
        for p in fuser_pids:  # SIGKILL anything that didn't respond
            try: os.kill(p, signal.SIGKILL)
            except OSError: pass
    if killed:
        print(f'SIGTERM → PIDs {killed}')
    else:
        print(f'no daemon running for {args.device}')


def cmd_status(args):
    sf = devdir(args.device) / 'status.json'
    if not sf.exists():
        print(json.dumps({'state': 'NO_DAEMON', 'device': args.device}))
        sys.exit(1)
    print(sf.read_text())


def cmd_alive(args):
    """Check whether the board is alive. Exits 0 if alive, 1 if not.

    Fast paths (no serial traffic):
      SHELL + recent prompt   → ALIVE immediately
      RUNNING + recent output → ALIVE (board is busy, don't interrupt)
      Any state + output <2s  → ALIVE (something is printing)
      UBOOT                   → ALIVE

    Slow path (only if fast paths all miss):
      Sends a bare CR to the FIFO with O_NONBLOCK. If the board responds
      (buf.log grows and state becomes SHELL/RUNNING/LOGIN/PASSWORD), reports
      ALIVE. Probe timeout is controlled by --timeout (default 5s).

    The slow-path FIFO write uses O_NONBLOCK so it never hangs if the daemon
    just died. A _daemon_running() guard prevents probing a dead daemon.
    """
    sf = devdir(args.device) / 'status.json'
    if not sf.exists():
        print('NO_DAEMON'); sys.exit(1)
    s = json.loads(sf.read_text())
    state = s.get('state', 'UNKNOWN')

    if state == 'SHELL':
        ago = s.get('last_prompt_ago')
        if ago is not None and ago < args.timeout:
            _log_op(args.device, 'alive', result='ALIVE', state='SHELL')
            print(f'ALIVE  state=SHELL  prompt {ago:.0f}s ago'); sys.exit(0)

    # RUNNING = board is alive, just busy — don't probe (would interrupt command!)
    if state == 'RUNNING':
        ago = s.get('last_output_ago')
        if ago is not None and ago < args.timeout:
            _log_op(args.device, 'alive', result='ALIVE', state='RUNNING')
            print(f'ALIVE  state=RUNNING  output {ago:.1f}s ago'); sys.exit(0)

    # Any recent output = alive (covers BOOTING, LOGIN, etc.)
    ago = s.get('last_output_ago')
    if ago is not None and ago < 2.0:
        _log_op(args.device, 'alive', result='ALIVE', state=state)
        print(f'ALIVE  state={state}  output {ago:.1f}s ago'); sys.exit(0)

    # Any usable prompt means the board is alive, including one it has gone
    # quiet at — that was reporting live boards as dead.
    if _console_is_live(s):
        _live = s.get('quiet_from') if s.get('state') == 'QUIET' else s.get('state')
        _log_op(args.device, 'alive', result='ALIVE', state=_live)
        print(f'ALIVE  state={_live}'); sys.exit(0)

    # Slow path: probe with CR — skip if a human tio session is active
    bf = devdir(args.device) / 'buf.log'
    if _daemon_running(args.device):
        fifo = devdir(args.device) / 'input.fifo'
        try:
            fd = os.open(str(fifo), os.O_WRONLY | os.O_NONBLOCK)
            try: os.write(fd, b'\r')
            finally: os.close(fd)
        except OSError:
            pass
        deadline = time.time() + args.timeout
        prev = bf.stat().st_size if bf.exists() else 0
        while time.time() < deadline:
            if not _daemon_running(args.device):
                break
            time.sleep(0.15)
            # A prompt with no trailing newline never reaches buf.log — _append
            # holds it in _partial — so buf.log growth cannot be the liveness
            # signal. The daemon's state machine sees the raw text and records
            # it in status.json, so read that. A board answering our CR with
            # "login:" is alive; waiting for a whole line reports it dead.
            try:
                s2 = json.loads(sf.read_text())
            except (OSError, ValueError):
                s2 = {}
            st2 = s2.get('state', '')
            ago2 = s2.get('last_output_ago')
            if _console_is_live(s2) \
                    or (ago2 is not None and ago2 < 2.0) \
                    or (bf.exists() and bf.stat().st_size > prev):
                _log_op(args.device, 'alive', result='ALIVE', state=st2)
                print(f'ALIVE  state={st2}  (probe response)'); sys.exit(0)
            prev = bf.stat().st_size if bf.exists() else prev

    # Report the state as it is NOW, not the one read before the probe.
    try:
        state = json.loads(sf.read_text()).get('state', state)
    except (OSError, ValueError):
        pass
    _log_op(args.device, 'alive', result='DEAD_OR_UNKNOWN', state=state)
    print(f'DEAD_OR_UNKNOWN  state={state}'); sys.exit(1)


def _read_tail_lines(path, n):
    """Last n lines of path, read backward from EOF so a small 'read' never pulls
    the whole (up to 8 MB) file into memory.  Reads 64 KB chunks from the end until
    it holds more than n newlines or reaches the start.  Returns (lines, at_start).
    A partial leading line (chunk started mid-line) is harmless: it only exists when
    we already hold > n lines, so the caller's [-n:] trim drops it."""
    try:
        with open(path, 'rb') as f:
            f.seek(0, os.SEEK_END)
            pos = f.tell()
            data = b''
            while pos > 0 and data.count(b'\n') <= n:
                step = min(65536, pos)
                pos -= step
                f.seek(pos)
                data = f.read(step) + data
            return data.decode('utf-8', errors='replace').splitlines(), pos == 0
    except OSError:
        return [], True


def cmd_read(args):
    # Source from stream.log (append-only, full retained history) so 'read
    # --lines N' works past the 500-line buf.log ring, walking rotated segments
    # (stream.log.1..N) newest→oldest until it holds enough.  Tail-read each segment
    # from EOF so a small read never loads the whole 8 MB file.  Fall back to
    # buf.log only for pre-stream.log daemons.
    dd = devdir(args.device)
    n = max(1, args.lines)
    stream = dd / 'stream.log'
    if stream.exists():
        lines, _ = _read_tail_lines(stream, n)
        i = 1
        while len(lines) < n and (dd / f'stream.log.{i}').exists():
            older, _ = _read_tail_lines(dd / f'stream.log.{i}', n - len(lines))
            lines = older + lines
            i += 1
    elif (dd / 'buf.log').exists():
        lines = (dd / 'buf.log').read_text(errors='replace').splitlines()
    else:
        print(f'{args.device}: no stream.log or buf.log — daemon never started?',
              file=sys.stderr)
        sys.exit(2)
    tail = lines[-n:]
    if args.no_timestamps:
        tail = _strip_timestamps(tail)
    print('\n'.join(tail))


# ── Boot capture + digest ────────────────────────────────────────────────────
def _stream_size(device) -> int:
    """Byte size of the live stream.log now — snap this BEFORE a reboot to mark
    where the boot begins.  0 if there is no stream yet."""
    sf = devdir(device) / 'stream.log'
    try:
        return sf.stat().st_size if sf.exists() else 0
    except OSError:
        return 0


def _read_stream_slice(device, start_offset: int) -> list:
    """Lines written to stream.log from byte `start_offset` to EOF.

    Handles the 8 MB rotation: if the file shrank below start_offset the boot
    spanned a rotate, so fold in the previous segment (stream.log.1) too.  A boot
    almost never exceeds one 8 MB segment, so this stays cheap in the common case.
    """
    dd = devdir(device)
    sf = dd / 'stream.log'
    if not sf.exists():
        return []
    try:
        sz = sf.stat().st_size
        with open(sf, 'rb') as f:
            if sz >= start_offset:
                f.seek(start_offset)
                data = f.read()
            else:
                prev = dd / 'stream.log.1'          # rotated mid-boot
                data = (prev.read_bytes() if prev.exists() else b'') + f.read()
        return data.decode('utf-8', errors='replace').splitlines()
    except OSError:
        return []


def _boot_digest(lines: list, tail: int = BOOT_DIGEST_TAIL, max_hits: int = 120):
    """Reduce a full boot log to the lines that matter.

    Returns (summary: dict, digest: list[str]).  Keeps every panic/fatal line, the
    most recent error/warning lines (capped), and the last `tail` lines (the
    context right before a prompt or a hang) — with '…' markers where runs of
    ordinary output were elided, so the result stays chronological and greppable.
    """
    fatal_idx, err_idx, warn_idx = [], [], []
    boot_secs = None
    gap = False
    for i, l in enumerate(lines):
        body = RE_TIMESTAMP.sub('', l)
        if '<<serial-agent GAP' in body:
            gap = True
        if RE_PANIC.search(body):
            fatal_idx.append(i)
        elif RE_DIG_ERR.search(body):
            err_idx.append(i)
        elif RE_DIG_WARN.search(body):
            warn_idx.append(i)
        m = RE_BOOT.search(body)
        if m:
            try:
                boot_secs = float(m.group(0).strip('[] '))
            except ValueError:
                pass
    # Fatals are always kept.  Cap the recoverable error/warning volume, keeping
    # the most RECENT (most diagnostic for a failed boot).  Guard budget<=0: a
    # negative slice bound (ew[-0:]) would silently keep the WHOLE list.
    budget = max(0, max_hits - len(fatal_idx))
    ew = sorted(err_idx + warn_idx)
    ew = ew[-budget:] if budget > 0 else []
    tail_idx = range(max(0, len(lines) - tail), len(lines))
    keep = sorted(set(fatal_idx) | set(ew) | set(tail_idx))
    digest, prev = [], -1
    for i in keep:
        if prev >= 0 and i > prev + 1:
            digest.append(f'      … {i - prev - 1} lines …')
        digest.append(_strip_ansi(lines[i]))   # keep host timestamp, drop colour
        prev = i
    summary = {'total_lines': len(lines), 'fatal': len(fatal_idx),
               'errors': len(err_idx), 'warnings': len(warn_idx),
               'boot_secs': boot_secs, 'gap': gap}
    return summary, digest


def _boot_capture(device, baseline, timeout, digest_lines=BOOT_DIGEST_TAIL,
                  capture_file=None, as_json=False, quiet=False, do_wait=True):
    """Wait for the board to reach a prompt (or hang), then slice + digest the boot.

    Waits for SHELL/LOGIN/UBOOT (up), FROZEN/PANIC (hung), or timeout; reads the
    boot slice from byte `baseline`, writes the FULL boot to `capture_file`, and
    prints a filtered digest.  Returns a dict (also the --json payload).  Pass
    do_wait=False when the caller already waited for the board to settle.
    """
    reached = (_wait_state(device, 'SHELL,LOGIN,UBOOT,FROZEN,PANIC',
                           timeout, print_output=False) if do_wait else True)
    sf = devdir(device) / 'status.json'
    state = json.loads(sf.read_text()).get('state', '?') if sf.exists() else '?'
    lines = _read_stream_slice(device, baseline)
    summary, digest = _boot_digest(lines, tail=digest_lines)

    if capture_file is None:
        cap_dir = Path('/tmp/serial-connect-boot')
        try:
            cap_dir.mkdir(parents=True, exist_ok=True)
        except OSError:
            cap_dir = Path('/tmp')
        capture_file = cap_dir / f'{devname(device)}.boot.log'
    try:
        Path(capture_file).write_text('\n'.join(lines) + '\n')
    except OSError:
        capture_file = None

    outcome = _boot_outcome(state, bool(reached), len(lines))
    result = {'device': device, 'outcome': outcome, 'state': state,
              'reached': bool(reached), **summary,
              'capture_file': str(capture_file) if capture_file else None}
    if as_json:
        result['digest'] = digest
        print(json.dumps(result))
        return result
    if not quiet:
        banner = {'up':      '\033[32m✓ booted\033[0m',
                  'frozen':  '\033[31m✗ FROZEN — board hung mid-boot\033[0m',
                  'timeout': '\033[33m… TIMEOUT — no prompt reached\033[0m',
                  'nothing': '\033[31m✗ NOTHING CAPTURED — the board never reset\033[0m'}[outcome]
        bt = f", kernel {summary['boot_secs']:.1f}s" if summary['boot_secs'] else ''
        print(f"boot {device}: {banner}  (state={state}{bt}; {summary['fatal']} fatal / "
              f"{summary['errors']} err / {summary['warnings']} warn "
              f"in {summary['total_lines']} captured lines)")
        if summary['gap']:
            print('  \033[33m⚠ reconnect gap during capture — some output may be lost\033[0m')
        print('─' * 64)
        print('\n'.join(digest))
        print('─' * 64)
        if capture_file:
            print(f'full boot log ({summary["total_lines"]} lines): {capture_file}')
    return result


def cmd_boot(args):
    """Capture a boot: mark the stream, wait for the board to come up (or hang),
    print a filtered digest + write the full boot log to a file.

    Does NOT send 'reboot' by default — trigger the reset however you like (power,
    relay, sysrq) and this captures it.  Use --reset-cmd to send a command first,
    or 'reboot --capture' for the send-reboot-then-capture flow with auto-login.
    """
    device = args.device
    if not _daemon_running(device):
        print(f'{device}: no daemon running — start one first (serial-agent start)',
              file=sys.stderr)
        sys.exit(2)
    baseline = _stream_size(device)
    if args.reset_cmd:
        _maybe_auto_login(argparse.Namespace(device=device, user='root',
                                             password=None, no_login=False,
                                             login=False))
        try:
            _stj = json.loads((devdir(device) / 'status.json').read_text())
        except (OSError, ValueError):
            _stj = {}
        args.reset_cmd = _reboot_cmd(
            _stj, args.reset_cmd if args.reset_cmd != 'reboot' else None)
        _log_op(device, 'boot', reset_cmd=args.reset_cmd,
                state=_stj.get('state', ''))
        fifo = devdir(device) / 'input.fifo'
        sent = False
        for _ in range(20):
            try:
                fd = os.open(str(fifo), os.O_WRONLY | os.O_NONBLOCK)
                try: os.write(fd, (args.reset_cmd + '\n').encode())
                finally: os.close(fd)
                sent = True
                break
            except OSError:
                time.sleep(0.1)
        if not sent:
            print(f'daemon not accepting input for {device}', file=sys.stderr)
            sys.exit(1)
    elif not args.quiet and not args.json:
        print(f'Waiting for {device} to boot (trigger the reset now)…', file=sys.stderr)
    result = _boot_capture(device, baseline, args.timeout,
                           digest_lines=args.digest_lines,
                           capture_file=args.capture_file,
                           as_json=args.json, quiet=args.quiet)
    sys.exit(0 if result['outcome'] == 'up' else 1)


def _needs_login(st: dict, explicit: bool = False) -> bool:
    """True if a command sent now would land in `login` instead of a shell.

    A console parked at LOGIN/PASSWORD consumes the command as a username, then
    asks for a password, then prints 'Login incorrect' — the command never runs
    and nothing useful echoes back, which reads as the board dropping input.
    QUIET reached from either state is the same situation, just idle.

    BOOTING only counts with an explicit --login: auto mode must not silently
    turn a send into a 90s wait for a prompt that may never come.
    """
    cst = st.get('state', '')
    if cst in ('LOGIN', 'PASSWORD'):
        return True
    if cst == 'QUIET' and st.get('quiet_from') in ('LOGIN', 'PASSWORD'):
        return True
    return explicit and cst == 'BOOTING'


def _reboot_login_action(st: dict) -> str:
    """'login' if a reboot command sent now would be typed as a username.

    getty consumes it, asks for a password, and the board never reboots — the
    console is left at Password: and the operator reads it as the serial link
    corrupting input.
    """
    return 'login' if _needs_login(st) else 'send'


LIVE_CONSOLE_STATES = ('SHELL', 'RUNNING', 'LOGIN', 'PASSWORD', 'UBOOT')


def _console_is_live(st: dict) -> bool:
    """True if the console is at any usable prompt, parked or not.

    QUIET only means nothing has printed lately. A console that went quiet AT a
    prompt is still sitting at that prompt, so quiet_from carries the real
    state — the same reasoning _needs_login and _is_uboot already use.
    """
    cst = st.get('state', '')
    if cst in LIVE_CONSOLE_STATES:
        return True
    return cst == 'QUIET' and st.get('quiet_from') in LIVE_CONSOLE_STATES


def _is_uboot(st: dict) -> bool:
    """True if the console is at a U-Boot prompt, parked or live.

    U-Boot is a live console with a different dialect, not a dead board — the
    distinction every caller that only tested `state == 'SHELL'` got wrong.
    """
    cst = st.get('state', '')
    return cst == 'UBOOT' or (cst == 'QUIET' and st.get('quiet_from') == 'UBOOT')


def _boot_outcome(state: str, reached: bool, captured_lines: int) -> str:
    """'up' | 'frozen' | 'timeout' | 'nothing'.

    Reaching a usable state proves nothing if the board was already in one:
    _wait_state's ALREADY fast path returns instantly at a prompt, so a boot
    that captured no output never happened.
    """
    if not reached:
        return 'timeout'
    if state in ('PANIC', 'FROZEN'):
        return 'frozen'
    if state in ('SHELL', 'LOGIN', 'UBOOT'):
        return 'up' if captured_lines else 'nothing'
    return 'timeout'


def _reboot_cmd(st: dict, explicit=None) -> str:
    """The reset command this console understands, unless the caller named one.

    U-Boot has no `reboot` — it answers `Unknown command`, stays at its prompt,
    and the board never restarts.
    """
    if explicit:
        return explicit
    cst = st.get('state', '')
    if cst == 'UBOOT' or (cst == 'QUIET' and st.get('quiet_from') == 'UBOOT'):
        return 'reset'
    return 'reboot'


def _reboot_exit_code(went_down: bool, state: str) -> int:
    """0 only if the board actually went down AND came back usable.

    Reaching a usable state proves nothing on its own: a board that ignored the
    command was already at SHELL or UBOOT, and _wait_state's ALREADY fast path
    reports that instantly as success.
    """
    return 0 if (went_down and state in ('SHELL', 'UBOOT')) else 1


def _maybe_auto_login(args):
    """Log in first when the console is sitting at a login prompt.

    On by default — sending a shell command to `login` is never what the caller
    meant, and it fails in a way that looks like a transport fault rather than a
    login prompt. --no-login opts out; --login additionally covers BOOTING.
    Board-agnostic: reuses cmd_login's credential handling (default root, no
    password).
    """
    if getattr(args, 'no_login', False):
        return
    try:
        st = json.loads((devdir(args.device) / 'status.json').read_text())
    except (OSError, ValueError):
        return
    if not _needs_login(st, getattr(args, 'login', False)):
        return
    user = getattr(args, 'user', 'root') or 'root'
    print(f"[serial-agent] console at {st.get('state','?')} — logging in as "
          f"{user} first (--no-login to disable)", file=sys.stderr)
    ns = argparse.Namespace(device=args.device,
                            user=user,
                            password=getattr(args, 'password', None),
                            timeout=90)
    try:
        cmd_login(ns)
    except SystemExit:
        pass
    try:
        st2 = json.loads((devdir(args.device) / 'status.json').read_text())
    except (OSError, ValueError):
        return
    if _needs_login(st2):
        print(f"[serial-agent] auto-login did NOT reach a shell — console still at "
              f"{st2.get('state','?')}; the command below will be typed into login",
              file=sys.stderr)


def cmd_send(args):
    """Send a command to the board and optionally capture structured output.

    Typical usage:
      --json     Structured output: {output, state, elapsed_ms, exit_code,
                 timed_out}. Zero-parsing for agents — just read the JSON.
      --capture  Clean stdout only (no timestamps, prompt, or echo).
                 Exit code = command exit code if --exit-code was also used.
      --exit-code Appends '; echo SERIAL_EXITCODE:$?' to the command and
                  parses the exit code. NOTE: avoid 'exit' in commands with
                  this flag — the shell exits before the echo can run; use
                  'run' instead for multi-step scripts.
      --no-wait  Fire and forget — write to FIFO and return immediately.
      --no-wrap  Prepend COLUMNS=32767 to prevent board terminal from
                 wrapping long output lines (important for grep, find, etc.).
      --all      Fan-out: send to every device with a running daemon in
                 parallel; results keyed by device path in the JSON output.
      --no-login Do not auto-login. By default a console at LOGIN/PASSWORD is
                 logged in first, because `login` would otherwise swallow the
                 command as a username and the failure looks like the board
                 dropping input rather than a login prompt.

    Exit code: 0 = completed (pattern matched), 1 = timed out or failed.
    """
    _maybe_auto_login(args)

    # ── Fan-out: send to ALL running daemons ──────────────────────────────────
    if args.all:
        targets = []
        if AGENT_BASE.exists():
            for ddir_p in AGENT_BASE.iterdir():
                if not ddir_p.is_dir(): continue
                dev = f'/dev/{ddir_p.name}'
                if _daemon_running(dev):
                    targets.append(dev)
        if not targets:
            print('No running daemons found.', file=sys.stderr); sys.exit(1)

        import threading
        results = {}
        def _send_one(dev):
            ns = argparse.Namespace(**vars(args))
            ns.device = dev; ns.all = False
            results[dev] = _send_impl(ns)

        threads = [threading.Thread(target=_send_one, args=(d,)) for d in targets]
        for t in threads: t.start()
        for t in threads: t.join()

        if args.json:
            print(json.dumps(results, indent=2))
        else:
            for dev, r in results.items():
                print(f'\n── {dev} ──')
                if isinstance(r, dict):
                    print(r.get('output', ''))
        sys.exit(0 if all(not r.get('timed_out') for r in results.values() if isinstance(r, dict)) else 1)

    # Interior newlines cannot be sent as one shell command: each line is
    # typed separately, so heredocs/defs land on the continuation prompt and
    # wedge the session (board-agnostic TTY reality, seen repeatedly in the
    # field). Delegate transparently to the base64 'run' path, which executes
    # the block as one script. --no-wait keeps raw behavior (caller explicitly
    # wants keystrokes, e.g. answering an interactive prompt).
    if '\n' in args.command.strip() and getattr(args, 'wait', True) is not None:
        print(f'{args.device}: multi-line command — running via script transfer '
              f"(same as 'serial-agent run')", file=sys.stderr)
        ns = argparse.Namespace(
            device=args.device, script=args.command,
            timeout=(args.timeout if args.timeout else 60.0),
            json=args.json, capture=args.capture,
            no_wrap=getattr(args, 'no_wrap', False))
        return cmd_run(ns)

    result = _send_impl(args)
    if result is None:
        return  # --no-wait

    if args.json:
        print(json.dumps(result, indent=2))
        sys.exit(0 if not result.get('timed_out') else 1)
    elif args.capture:
        print(result.get('output', ''))
        ec = result.get('exit_code')
        if ec is not None and ec != 0:
            sys.exit(ec)
        sys.exit(0 if not result.get('timed_out') else 1)
    else:
        sys.exit(0 if not result.get('timed_out') else 1)


def _send_impl(args):
    """Core send implementation. Shared by cmd_send, _do_send, and cmd_connect.

    Flow:
      1. Verify daemon is running (exits with error if not).
      2. Snap buf.log byte offset (baseline) to the last complete newline so
         post-command output capture starts cleanly.
      3. Wrap the command with COLUMNS= prefix (--no-wrap) or EXITCODE echo
         (--exit-code) if requested.
      4. Write command+newline to input.fifo using O_NONBLOCK. Retries up to
         up to 20 attempts x 100ms, checking daemon liveness on each. Fails fast
         with 'no daemon' if daemon dies during retry.
      5. If --no-wait: return None immediately (fire and forget).
      6. Otherwise: call _wait_pattern() to block until the shell prompt
         (or custom --wait pattern) appears in buf.log after the baseline.
      7. Read buf.log from baseline, call _clean_output() to strip timestamps,
         ANSI codes, command echo, trailing prompt, and extract EXITCODE.

    Returns:
        dict  with keys: output, state, elapsed_ms, exit_code, timed_out
              (when --json, --capture, or --exit-code is set)
        dict  with key: timed_out only (when none of the above)
        None  when --no-wait
    Calls sys.exit(1) on daemon errors (does not return).
    """
    fifo = devdir(args.device) / 'input.fifo'
    if not _daemon_running(args.device):
        print(f'no daemon for {args.device}', file=sys.stderr); sys.exit(1)

    # Capture source is stream.log (append-only, stable inode) — byte offsets
    # into it stay valid across the send window.  buf.log is a bounded ring
    # that drops lines from the FRONT, so an offset snapped before the command
    # pointed mid-stream after any rotation: that was the long-standing
    # '--json output truncated at the front' bug.
    bf = devdir(args.device) / 'stream.log'
    if not bf.exists():
        bf = devdir(args.device) / 'buf.log'   # pre-stream.log daemon
    t0 = time.time()
    # Snap to last newline so we never read a partial timestamped line
    if bf.exists():
        with open(bf, 'rb') as _f:
            _raw = _f.read()
        _nl = _raw.rfind(b'\n')
        baseline_offset = _nl + 1 if _nl >= 0 else len(_raw)
    else:
        baseline_offset = 0

    cmd = args.command.rstrip('\n')
    # Guard: a shell-looking command sent while the console sits at a login/
    # password prompt is typed into getty as a username — it never executes and
    # the operator only sees a mysterious timeout (three times in one night).
    # Warn loudly; still send (a bare word like 'root' IS the login flow).
    try:
        _stj = json.loads((devdir(args.device) / 'status.json').read_text())
        _cst = _stj.get('state', '')
        if _cst == 'UBOOT' or (_cst == 'QUIET' and _stj.get('quiet_from') == 'UBOOT'):
            # ANY input during the autoboot countdown stops autoboot; at the
            # U-Boot prompt shell commands are misparsed as U-Boot commands.
            # Warn (still send — deliberate U-Boot interaction is legitimate).
            print(f"{args.device}: console is in U-Boot — input interrupts "
                  f"autoboot / runs as a U-Boot command, not a shell command. "
                  f"Send 'boot' to resume Linux.", file=sys.stderr)
        elif _cst in ('LOGIN', 'PASSWORD') and (' ' in cmd or ';' in cmd):
            print(f"{args.device}: console is at a {_cst} prompt — this command "
                  f"will be typed as a username, not executed. Log in first "
                  f"(serial-agent send DEVICE root).", file=sys.stderr)
        elif _cst == 'QUIET' and _stj.get('quiet_from') in ('LOGIN', 'PASSWORD') \
                and (' ' in cmd or ';' in cmd):
            print(f"{args.device}: console went quiet at a {_stj['quiet_from']} "
                  f"prompt — log in first.", file=sys.stderr)
    except (OSError, ValueError):
        pass
    if getattr(args, 'no_wrap', False):
        # Prevent board terminal from wrapping long output lines
        cmd = f'COLUMNS=32767 LINES=200 {cmd}'
    if args.exit_code:
        cmd = f'{cmd}; echo "{EXITCODE_TAG}:$?"'
    cmd_bytes = (cmd + '\n').encode()

    # Use O_NONBLOCK so we never block waiting for the daemon's reader.
    # Retry briefly if the daemon's _writer thread isn't ready yet.
    sent = False
    for attempt in range(20):   # up to 2s (20 × 0.1s)
        if not _daemon_running(args.device):
            print(f'no daemon for {args.device}', file=sys.stderr); sys.exit(1)
        try:
            fd = os.open(str(fifo), os.O_WRONLY | os.O_NONBLOCK)
            try:
                os.write(fd, cmd_bytes)
            finally:
                os.close(fd)
            sent = True
            break
        except OSError:
            time.sleep(0.1)
    if not sent:
        print(f'daemon not accepting input for {args.device}', file=sys.stderr)
        sys.exit(1)

    # --no-wait: fire and forget
    if args.wait is None and not (args.json or args.capture or args.exit_code):
        return None

    wait_pat = args.wait if args.wait is not None else r'[\$#>]\s*$'
    show = not (args.json or args.capture)
    ok = _wait_pattern(args.device, wait_pat, args.timeout, echo_of=cmd,
                       show=show, baseline_offset=baseline_offset)
    elapsed_ms = int((time.time() - t0) * 1000)

    if not ok:
        # An on-demand daemon parks with no fd between relay clients and
        # silently discards fifo writes, so every send just times out with no
        # indication of why.  Say so instead of letting the caller guess.
        try:
            _st = json.loads((devdir(args.device) / 'status.json').read_text())
        except (OSError, ValueError):
            _st = {}
        if _st.get('idle_timeout', 0) > 0 and not _st.get('port_held', True):
            print(f'{args.device}: daemon is parked in on-demand mode '
                  f'(--idle-timeout {_st["idle_timeout"]}) and is not holding the '
                  f'port, so the command was discarded. Restart the daemon with '
                  f'--idle-timeout 0 for automation use.', file=sys.stderr)

    if args.json or args.capture or args.exit_code:
        new_lines = []
        if bf.exists():
            _sz = bf.stat().st_size
            _base = baseline_offset if _sz >= baseline_offset else 0
            with open(bf, 'rb') as f:
                f.seek(_base)
                raw = f.read().decode('utf-8', errors='replace')
            new_lines = raw.splitlines()
        output, exit_code = _clean_output(new_lines, cmd.strip())  # use actual sent cmd for echo detection
        sf = devdir(args.device) / 'status.json'
        state = json.loads(sf.read_text()).get('state', '?') if sf.exists() else '?'
        result = {
            'output':     output,
            'state':      state,
            'elapsed_ms': elapsed_ms,
            'exit_code':  exit_code,
            'timed_out':  not ok,
        }
        _log_op(args.device, 'send', cmd=cmd.strip(), timeout=args.timeout,
                elapsed_ms=elapsed_ms, state=state,
                exit_code=exit_code, timed_out=not ok)
        return result
    _log_op(args.device, 'send', cmd=cmd.strip(), timeout=args.timeout,
            elapsed_ms=elapsed_ms, timed_out=not ok)
    return {'timed_out': not ok}


def cmd_watch(args):
    """Real-time push read: return the instant a pattern appears on the console.

    Reads the daemon's output.fifo, so there is NO polling latency — the read
    blocks in the kernel until the next serial byte arrives (vs expect/wait,
    which poll a file at 50-200ms unless inotify is installed). Optionally sends
    a command first (--send) with the read side already open, so no early output
    is missed. This is the fused, zero-latency replacement for the
    'send X; sleep N; read' pattern.

    Patterns:  --until REGEX (repeatable)  and/or  --on KEY=REGEX (repeatable).
               Any match returns immediately.
    Output:    JSON {"matched": KEY|null, "output": str, "elapsed_ms": int
                     [, "timed_out": true]}.  --until patterns key as u0,u1,...
    Exit:      0 on match, 1 on timeout, 2 on usage/daemon error.
    """
    import select as _select
    dev = args.device
    if not _daemon_running(dev):
        print(f'no daemon for {dev}', file=sys.stderr); sys.exit(2)
    fifo = devdir(dev) / 'output.fifo'
    if not fifo.exists():
        print(f'no output.fifo for {dev} — daemon predates the push channel; '
              f'restart it (serial-agent stop {dev} && serial-agent start {dev} '
              f'--idle-timeout 0)', file=sys.stderr); sys.exit(2)

    patterns = {}
    for p in (args.on or []):
        if '=' not in p:
            print(f'Bad --on format (use KEY=REGEX): {p}', file=sys.stderr); sys.exit(2)
        k, rx = p.split('=', 1); patterns[k] = re.compile(rx)
    for i, rx in enumerate(args.until or []):
        patterns[f'u{i}'] = re.compile(rx)
    if not patterns:
        print('watch needs at least one --until REGEX or --on KEY=REGEX',
              file=sys.stderr); sys.exit(2)

    # Only when we are about to send: a bare watch must stay free to observe the
    # login prompt itself (--until 'login:' is a normal boot-capture pattern).
    if args.send:
        _maybe_auto_login(args)

    # Open the read end FIRST (non-blocking) so the daemon can attach its write
    # end and nothing emitted by --send is missed. Snapshot stream.log's end as
    # a backstop for the rare bytes dropped under backpressure.
    rfd = os.open(str(fifo), os.O_RDONLY | os.O_NONBLOCK)
    sf_stream = devdir(dev) / 'stream.log'
    stream_base = sf_stream.stat().st_size if sf_stream.exists() else 0

    t0 = time.time()
    if getattr(args, 'send', None):
        iff = devdir(dev) / 'input.fifo'
        cb = (args.send.rstrip('\n') + '\n').encode()
        sent = False
        for _ in range(20):
            try:
                wfd = os.open(str(iff), os.O_WRONLY | os.O_NONBLOCK)
                try: os.write(wfd, cb)
                finally: os.close(wfd)
                sent = True
                break
            except OSError:
                time.sleep(0.1)
        if not sent:
            print(f'daemon not accepting input for {dev}', file=sys.stderr)
            sys.exit(1)

    deadline = t0 + args.timeout
    acc = ''
    matched = None
    while time.time() < deadline and matched is None:
        r, _, _ = _select.select([rfd], [], [], max(0.02, deadline - time.time()))
        if not r:
            continue
        try:
            chunk = os.read(rfd, 4096)
        except BlockingIOError:
            continue
        except OSError:
            break
        if not chunk:
            time.sleep(0.02)     # writer end momentarily closed; keep waiting
            continue
        acc += _strip_ansi(chunk.decode('utf-8', errors='replace'))
        # Without this, --send 'echo DONE' --until DONE matches the echoed
        # command the instant it appears, before the board has run anything.
        for k, pat in patterns.items():
            if pat.search(_echo_free(acc, args.send)):
                matched = k; break
    os.close(rfd)

    # Backstop: reconcile against stream.log for anything dropped under pressure.
    if matched is None and sf_stream.exists():
        try:
            with open(sf_stream, 'rb') as f:
                f.seek(stream_base)
                tail = f.read().decode('utf-8', errors='replace')
            merged = acc + _strip_ansi(tail)
            for k, pat in patterns.items():
                if pat.search(_echo_free(merged, args.send)):
                    matched = k; acc = merged; break
        except OSError:
            pass

    out_text, _ = _clean_output(acc.splitlines(), sent_cmd=args.send or '')
    res = {'matched': matched, 'output': out_text,
           'elapsed_ms': int((time.time() - t0) * 1000)}
    if matched is None:
        res['timed_out'] = True
    print(json.dumps(res))
    _log_op(dev, 'watch', matched=matched, elapsed_ms=res['elapsed_ms'],
            timed_out=matched is None)
    sys.exit(0 if matched is not None else 1)


def cmd_expect(args):
    """Wait for first of multiple patterns. Returns JSON with matched key and output."""
    if getattr(args, 'pattern', None) and not args.on:
        args.on = [f'match={args.pattern}']
    if not args.on:
        print('expect: give a pattern, or --on KEY=REGEX', file=sys.stderr); sys.exit(2)
    # Read stream.log (append-only, stable inode) not buf.log: buf.log is a
    # bounded ring rewritten by tmp+rename, so a fast/large burst can scroll past
    # its 500-line cap between polls and be missed (the front-truncation class
    # already fixed for send/_send_impl). stream.log preserves the full window.
    bf = devdir(args.device) / 'stream.log'
    if not bf.exists():
        bf = devdir(args.device) / 'buf.log'
    if bf.exists():
        with open(bf, 'rb') as _f:
            _raw = _f.read()
        _nl = _raw.rfind(b'\n')
        baseline_offset = _nl + 1 if _nl >= 0 else len(_raw)
    else:
        baseline_offset = 0
    deadline = time.time() + args.timeout
    t0 = time.time()

    patterns = {}
    for p in args.on:
        if '=' not in p:
            print(f'Bad --on format (use KEY=REGEX): {p}', file=sys.stderr); sys.exit(1)
        key, regex = p.split('=', 1)
        patterns[key] = re.compile(regex)

    import shutil
    use_inotify = bool(shutil.which('inotifywait')) and bf.parent.exists()
    baseline = baseline_offset

    while time.time() < deadline:
        if not _daemon_running(args.device):
            break

        if use_inotify:
            remaining = max(0.1, deadline - time.time())
            try:
                import subprocess
                subprocess.run(
                    ['inotifywait', '-q', '-e', 'modify,create',
                     '--timeout', str(min(remaining, 5)), str(bf.parent)],
                    capture_output=True, timeout=remaining + 1)
            except Exception:
                use_inotify = False
        else:
            interval = 0.05 if (time.time() - t0) < 1.0 else 0.2
            time.sleep(interval)

        if not bf.exists(): continue
        sz = bf.stat().st_size
        if sz <= baseline: continue

        try:
            with open(bf, 'rb') as f:
                f.seek(baseline_offset); all_new = f.read().decode('utf-8', errors='replace')
            with open(bf, 'rb') as f:
                f.seek(baseline); inc = f.read().decode('utf-8', errors='replace')
        except OSError:
            continue
        baseline = sz

        clean_inc = _strip_ansi(inc)
        for key, pat in patterns.items():
            if pat.search(clean_inc):
                lines, _ = _clean_output(all_new.splitlines())
                print(json.dumps({
                    'matched':    key,
                    'output':     lines,
                    'elapsed_ms': int((time.time() - t0) * 1000),
                }))
                sys.exit(0)

    # Timed out
    lines = ''
    if bf.exists():
        with open(bf, 'rb') as f:
            f.seek(baseline_offset)
            raw, _ = _clean_output(f.read().decode('utf-8', errors='replace').splitlines())
        lines = raw
    print(json.dumps({
        'matched':    None,
        'output':     lines,
        'elapsed_ms': int((time.time() - t0) * 1000),
        'timed_out':  True,
    }))
    sys.exit(1)


def cmd_wait(args):
    """Block until a regex pattern appears in the board's output buffer.

    Unlike wait-state (which watches the state machine), wait watches the
    raw buf.log content. Useful for waiting on a specific log message,
    error string, or application output that doesn't map to a board state.

    Exit 0 on match, 1 on timeout or daemon death.
    """
    sys.exit(0 if _wait_pattern(args.device, args.pattern, args.timeout) else 1)


def _wait_state(device, state_csv, timeout, print_output=True):
    """Block until the board reaches one of the target states.

    Args:
        device:       /dev/ttyUSBx path.
        state_csv:    Comma-separated target states, e.g. 'SHELL,LOGIN'.
        timeout:      Seconds before giving up.
        print_output: If True, print ALREADY/REACHED/TIMEOUT/DAEMON_DIED
                      to stdout for the user to see.

    Returns True if a target state was reached, False on failure.
    Does NOT call sys.exit — callers decide what to do on False.

    Fast path: if the current state in status.json is already in targets,
    returns True immediately (prints ALREADY).

    Event-driven path (inotifywait available): watches events.log for new
    writes, wakes instantly on state change, checks daemon liveness once per
    inotify cycle (up to 10s). Much lower CPU than polling.

    Polling fallback: 50ms for first 2s, then 200ms. Used when inotifywait
    is not installed.

    On daemon death: prints DAEMON_DIED and returns False immediately,
    regardless of remaining timeout.

    On timeout: prints TIMEOUT with the last known state and returns False.
    """
    import shutil
    ef = devdir(device) / 'events.log'
    sf = devdir(device) / 'status.json'
    targets = {s.strip().upper() for s in state_csv.split(',')}

    if sf.exists():
        s = json.loads(sf.read_text())
        if s.get('state', '') in targets:
            if print_output: print(f'ALREADY  state={s["state"]}')
            return True

    deadline = time.time() + timeout
    t_start = time.time()
    baseline = ef.stat().st_size if ef.exists() else 0
    use_inotify = bool(shutil.which('inotifywait'))

    while time.time() < deadline:
        if not _daemon_running(device):
            if print_output: print(f'DAEMON_DIED  state=DEAD')
            return False

        if use_inotify:
            remaining = max(0.1, deadline - time.time())
            try:
                import subprocess as _sp
                _sp.run(
                    ['inotifywait', '-q', '-e', 'modify,create',
                     '--timeout', str(min(remaining, 10)), str(ef.parent)],
                    capture_output=True, timeout=remaining + 2)
            except Exception:
                use_inotify = False
        else:
            interval = 0.05 if (time.time() - t_start) < 2.0 else 0.2
            time.sleep(interval)

        # Always check status.json on each wakeup — catches states set directly
        # in run() (e.g. DEAD from silence timeout) that don't produce an
        # events.log line before Fix 1 was applied, and as a safety net after.
        if sf.exists():
            cur = json.loads(sf.read_text()).get('state', '')
            if cur in targets:
                if print_output: print(f'REACHED  state={cur}  (via status.json)')
                return True

        if not ef.exists(): continue
        sz = ef.stat().st_size
        if sz > baseline:
            with open(ef) as f:
                f.seek(baseline); new_lines = f.read()
            baseline = sz
            for line in new_lines.splitlines():
                m = re.search(r'→\s+(\w+)', line)
                if m and m.group(1) in targets:
                    if print_output: print(f'REACHED  {line.strip()}')
                    return True

    state = json.loads(sf.read_text()).get('state', '?') if sf.exists() else '?'
    if print_output: print(f'TIMEOUT  state={state}  waited={timeout}s  target={state_csv}')
    return False


def cmd_wait_state(args):
    """Block until the board reaches one of the target states, then exit 0.

    Uses inotifywait (if installed) for event-driven wakeup with sub-ms
    latency, falling back to 50-200ms polling. Prints one of:
      ALREADY  state=X    — already in target state when called
      REACHED  [timestamp] PREV → NEW  prompt   — transition observed
      TIMEOUT  state=X  waited=N  target=Y       — timed out
      DAEMON_DIED  state=DEAD                    — daemon process died

    Exit 0 = target reached. Exit 1 = timeout or daemon death.

    See also: wait-alive (shorthand for SHELL,LOGIN,PASSWORD).
    """
    # compat: IDLE was renamed QUIET; accept both
    if getattr(args, 'state', None):
        args.state = args.state.replace('IDLE', 'QUIET').replace('QUIETQUIET', 'QUIET')
    ok = _wait_state(args.device, args.state, args.timeout)
    sys.exit(0 if ok else 1)


def cmd_events(args):
    ef = devdir(args.device) / 'events.log'
    if not ef.exists():
        print('No events yet.'); return
    lines = ef.read_text().splitlines()
    print('\n'.join(lines[-args.lines:]))


def cmd_tail(args):
    bf = devdir(args.device) / 'buf.log'
    if not bf.exists():
        print('no buffer (daemon not started?)', file=sys.stderr); sys.exit(1)
    lines = bf.read_text().splitlines()
    for l in lines[-max(0, getattr(args, 'lines', 20)):] if getattr(args, 'lines', 20) else []:
        print(RE_TIMESTAMP.sub('', l) if args.no_timestamps else l)
    offset = bf.stat().st_size
    deadline = time.time() + args.timeout if args.timeout > 0 else None
    try:
        while True:
            if deadline and time.time() >= deadline:
                break
            if not _daemon_running(args.device):
                break
            time.sleep(0.1)
            sz = bf.stat().st_size if bf.exists() else 0
            if sz > offset:
                with open(bf, 'rb') as f:
                    f.seek(offset); new = f.read().decode('utf-8', errors='replace')
                for l in new.splitlines():
                    print(RE_TIMESTAMP.sub('', l) if args.no_timestamps else l)
                sys.stdout.flush()
                offset = sz
    except KeyboardInterrupt:
        pass


def cmd_connect(args):
    """One-shot: discover board, start daemon if needed, optionally wait for shell."""
    import subprocess, shutil
    if getattr(args, 'device', None):
        _d = args.device if args.device.startswith('/dev/') else f'/dev/{args.device}'
        if not _daemon_running(_d):
            cmd_start(argparse.Namespace(device=_d, baud=115200, lines=500,
                                         idle_timeout=0, tcp=None, no_ser2net=False))
        if args.wait_shell:
            _wait_state(_d, 'SHELL,LOGIN,PASSWORD,UBOOT', args.timeout)
        print(json.dumps({'device': _d}) if args.json else f'connected {_d}')
        sys.exit(0)
    sd = shutil.which('serial-discover')
    if not sd:
        print('serial-discover not found', file=sys.stderr); sys.exit(1)

    try:
        raw = subprocess.check_output([sd, '--json'], stderr=subprocess.DEVNULL, timeout=15)
        devices = json.loads(raw)
    except Exception as e:
        print(f'serial-discover failed: {e}', file=sys.stderr); sys.exit(1)

    if args.board:
        pat = re.compile(args.board, re.I)
        devices = [d for d in devices
                   if pat.search(d.get('label', '')) or pat.search(d.get('hostname', ''))
                   or pat.search(d.get('devname', ''))]
    if args.serial:
        devices = [d for d in devices if args.serial in d.get('serial', '')]
    if not args.board and not args.serial:
        # default: only LIVE or OPEN boards
        devices = [d for d in devices if d.get('state') in ('LIVE', 'OPEN')]

    if not devices:
        what = f"board '{args.board}'" if args.board else 'any live board'
        print(f'No match for {what}. Run serial-agent auto-label and serial-discover first.',
              file=sys.stderr); sys.exit(1)

    # Prefer a LIVE or OPEN port (console port) over dead ports
    live = [d for d in devices if d.get('state') in ('LIVE', 'OPEN')]
    d = live[0] if live else devices[0]
    device = d['device']
    ensure_symlink()

    # Start daemon in always-on mode (--idle-timeout 0).  On-demand mode would
    # leave the daemon parked with _fd=None, making _send_raw a silent no-op —
    # any subsequent 'send' call would time out with no error message.
    if not _daemon_running(device):
        tcp = find_ser2net_port(device)
        cmd = [sys.argv[0], 'start', device, '--baud', str(d['baud']),
               '--idle-timeout', '0']
        if tcp: cmd += ['--tcp', tcp]
        try:
            subprocess.run(cmd, check=True)
        except subprocess.CalledProcessError:
            print(f'Failed to start daemon for {device}', file=sys.stderr); sys.exit(1)
        for _ in range(20):   # poll up to 2s instead of fixed sleep
            if _daemon_running(device):
                break
            time.sleep(0.1)
    else:
        # Daemon already running — probe if board is idle/DEAD (no output for 30s).
        # Directly write CR to fifo so wait_state below sees the prompt transition.
        sf2 = devdir(device) / 'status.json'
        cur2 = json.loads(sf2.read_text()).get('state', '') if sf2.exists() else ''
        if cur2 in ('DEAD', 'UNKNOWN', 'IDLE', 'QUIET'):
            fifo2 = devdir(device) / 'input.fifo'
            if fifo2.exists():
                try:
                    fd2 = os.open(str(fifo2), os.O_WRONLY | os.O_NONBLOCK)
                    try: os.write(fd2, b'\r')
                    finally: os.close(fd2)
                except OSError:
                    pass

    if args.wait_shell:
        if not _wait_state(device, 'SHELL,LOGIN,PASSWORD,UBOOT', args.timeout,
                           print_output=not args.json):
            sys.exit(1)  # _wait_state already printed DAEMON_DIED or TIMEOUT
        sf = devdir(device) / 'status.json'
        cur = json.loads(sf.read_text()).get('state', '') if sf.exists() else ''
        # Auto-login if board landed at LOGIN (consistent with reboot behaviour)
        if cur == 'LOGIN':
            _do_send(device, getattr(args, 'user', 'root'), wait=r'Password|[\$#>]\s*$', timeout=10)
            cur = json.loads(sf.read_text()).get('state', '') if sf.exists() else ''
            if cur == 'PASSWORD':
                _do_send(device, getattr(args, 'password', None) or '', wait=r'[\$#>]\s*$', timeout=10)
            cur = json.loads(sf.read_text()).get('state', '') if sf.exists() else ''
        if args.setup_terminal and cur == 'SHELL':
            _send_impl(argparse.Namespace(
                device=device, command='stty cols 220 rows 50',
                wait=r'[\$#>]\s*$', timeout=5,
                json=True, capture=False, exit_code=False, all=False, no_wrap=False))

    _sf_log = devdir(device) / 'status.json'
    _st_log = json.loads(_sf_log.read_text()).get('state', '?') if _sf_log.exists() else '?'
    _log_op(device, 'connect', board=d.get('label') or d.get('hostname', ''),
            state=_st_log)
    if args.json:
        sf = devdir(device) / 'status.json'
        info = {'device': device, 'label': d['label'], 'hostname': d['hostname'],
                'baud': d['baud'], 'state': None}
        if sf.exists():
            info['state'] = json.loads(sf.read_text()).get('state')
        print(json.dumps(info))
    else:
        label = d['label'] or d['hostname'] or d['devname']
        print(f'Connected: {device} ({label})')
        sf = devdir(device) / 'status.json'
        if sf.exists():
            state = json.loads(sf.read_text()).get('state', '?')
            print(f'  state: {state}')


def cmd_path(args):
    print(devdir(args.device))


def cmd_auto_label(args):
    """Generate unique labels for unlabeled boards and update serial-boards.conf.
    Format: hostname-last6serial — unique even for two identical board types."""
    import subprocess, shutil
    sd = shutil.which('serial-discover')
    if not sd:
        print('serial-discover not found', file=sys.stderr); sys.exit(1)

    try:
        raw = subprocess.check_output([sd, '--json'], stderr=subprocess.DEVNULL, timeout=15)
        devices = json.loads(raw)
    except Exception as e:
        print(f'serial-discover failed: {e}', file=sys.stderr); sys.exit(1)

    cfg = _resolve_board_cfg()
    existing_text = cfg.read_text() if cfg.exists() else ''

    seen, to_label = set(), {}
    for d in devices:
        ser = d['serial']
        if not ser or ser in seen: continue
        seen.add(ser)
        if d.get('label') or ser in existing_text: continue
        hostname = d.get('hostname', '')
        if d['state'] in ('LIVE', 'OPEN') or hostname:
            to_label[ser] = {'hostname': hostname or d['chip'].lower(),
                             'chip': d['chip'], 'devname': d['devname'],
                             'state': d['state'], 'baud': d['baud']}

    if not to_label:
        print('Nothing to label — all boards already have entries.'); return

    entries = []
    for ser, info in to_label.items():
        suffix = ser[-6:] if len(ser) >= 6 else ser
        label = f"{info['hostname']}-{suffix}"
        entries.append((ser, label, info))

    print(f'Proposed additions to {cfg}:\n')
    for ser, label, info in entries:
        baud_str = f" baud={info['baud']}" if info['baud'] != 115200 else ''
        print(f'  {ser} = {label}  ({info["chip"]} / {info["devname"]} / {info["state"]}{baud_str})')

    print()
    if args.dry_run:
        print('(dry-run — nothing written)'); return
    if not args.yes:
        confirm = input('Write to serial-boards.conf? [y/N]: ').strip().lower()
        if confirm != 'y':
            print('Aborted.'); return

    with open(cfg, 'a') as f:
        f.write('\n# Auto-labeled by serial-agent auto-label\n')
        for ser, label, info in entries:
            baud_suffix = f':{info["baud"]}' if info['baud'] != 115200 else ''
            f.write(f'{ser}={label}{baud_suffix}\n')
    print(f'Added {len(entries)} label(s). Edit {cfg} to rename.')
    print('Labels track USB serial# — stable across sessions and replug.')


def cmd_discover(args):
    """Discover ports, augment with ser2net + daemon info. No hardcoding needed."""
    import subprocess, shutil
    sd = shutil.which('serial-discover')
    if not sd:
        print('serial-discover not found', file=sys.stderr); sys.exit(1)
    try:
        raw = subprocess.check_output([sd, '--json'], stderr=subprocess.DEVNULL, timeout=15)
        devices = json.loads(raw)
    except Exception as e:
        print(f'serial-discover failed: {e}', file=sys.stderr); sys.exit(1)

    if args.board:
        pat = re.compile(args.board, re.I)
        devices = [d for d in devices
                   if pat.search(d.get('label', '')) or pat.search(d.get('hostname', ''))
                   or pat.search(d.get('devname', ''))]
    if args.serial:
        devices = [d for d in devices if args.serial in d.get('serial', '')]
    if args.live:
        devices = [d for d in devices if d.get('state') in ('LIVE', 'OPEN')]

    for d in devices:
        dev = d['device']
        tcp = find_ser2net_port(dev)
        d['ser2net_tcp'] = tcp
        d['daemon_running'] = False
        d['daemon_state']   = None
        sf = AGENT_BASE / d['devname'] / 'status.json'
        pf = AGENT_BASE / d['devname'] / 'daemon.pid'
        if sf.exists() and pf.exists():
            try:
                os.kill(int(pf.read_text().strip()), 0)
                d['daemon_running'] = True
                d['daemon_state'] = json.loads(sf.read_text()).get('state')
            except (OSError, ValueError, json.JSONDecodeError):
                pass
        cmd = ['serial-agent', 'start', dev, '--baud', str(d['baud'])]
        if tcp: cmd += ['--tcp', tcp]
        d['start_cmd'] = ' '.join(cmd)

    print(json.dumps(devices, indent=2))


def _do_send(device, command, wait=r'[\$#>]\s*$', timeout=10, no_wrap=False):
    """Internal helper: send a command and return the result dict (always JSON mode).

    Calls sys.exit(1) if the daemon is not running — callers that need to
    handle daemon death gracefully should check _daemon_running() first.
    Returns None only if the daemon check passes but the send is no-wait
    (which never happens here since wait is always set).
    """
    return _send_impl(argparse.Namespace(
        device=device, command=command, wait=wait, timeout=timeout,
        json=True, capture=False, exit_code=False, all=False, no_wrap=no_wrap))


def cmd_reboot(args):
    """Reboot the board and wait for it to come back up.

    Sends 'reboot' (or a custom --cmd), watches for DEAD, then waits for
    SHELL/LOGIN/UBOOT. Optionally auto-logs in and sets up the terminal.

    Typical MPU workflow:
      serial-agent reboot DEVICE --login --setup-terminal --timeout 120
    """
    device = args.device
    sf = devdir(device) / 'status.json'
    try:
        _stj = json.loads(sf.read_text()) if sf.exists() else {}
    except (OSError, ValueError):
        _stj = {}
    args.cmd = _reboot_cmd(_stj, args.cmd)

    _log_op(device, 'reboot', cmd=args.cmd, state=_stj.get('state', ''))

    # Mark where the boot begins in stream.log so --capture can slice+digest it.
    _cap_baseline = _stream_size(device) if getattr(args, 'capture', False) else 0

    # Record wall time before sending reboot.  After the board comes back we
    # verify the shell prompt timestamp is NEWER than this — if it's older the
    # board never actually rebooted (command was ignored or came back instantly
    # and hit the _wait_state fast path with the pre-reboot SHELL state).
    t_reboot_sent = time.time()

    # A console parked at login: swallows the reboot command as a username, so
    # log in first; --no-login governs the post-reboot login only.
    if _reboot_login_action(_stj) == 'login':
        _maybe_auto_login(argparse.Namespace(device=device, user=args.user,
                                             password=args.password,
                                             no_login=False, login=False))
        try:
            _stj = json.loads(sf.read_text()) if sf.exists() else {}
        except (OSError, ValueError):
            _stj = {}
        if _reboot_login_action(_stj) == 'login':
            print(f"{device}: console still at {_stj.get('state', '?')} after "
                  f"auto-login — refusing to send {args.cmd!r} into a login "
                  f"prompt (it would be taken as a username).", file=sys.stderr)
            sys.exit(1)
        # Not needing a login is not the same as having a shell ready. getty
        # hands over before the shell prints its first prompt, and a reboot sent
        # into that gap is swallowed -- the board stays up and only the exit
        # status reveals it. Wait for a real prompt before sending.
        if _stj.get('state') not in ('SHELL', 'UBOOT'):
            _wait_state(device, 'SHELL,UBOOT', 20, print_output=False)
            try:
                _stj = json.loads(sf.read_text()) if sf.exists() else {}
            except (OSError, ValueError):
                _stj = {}

    # Send the reboot command — don't wait for prompt (shell dies immediately)
    if _daemon_running(device):
        fifo = devdir(device) / 'input.fifo'
        cmd_bytes = (args.cmd + '\n').encode()
        for _ in range(20):
            try:
                fd = os.open(str(fifo), os.O_WRONLY | os.O_NONBLOCK)
                try: os.write(fd, cmd_bytes)
                finally: os.close(fd)
                break
            except OSError:
                time.sleep(0.1)

    if not args.quiet:
        print(f'Rebooting {device}...')

    # Wait for board to go down (DEAD or BOOTING).
    # DEAD is now written to events.log so _wait_state can detect it via inotify.
    went_down = _wait_state(device, 'DEAD,BOOTING', 30)
    if not went_down:
        # Board did not go down within 30s.  Check if it's still at SHELL —
        # the reboot command may have been ignored.
        cur = json.loads(sf.read_text()).get('state', '') if sf.exists() else ''
        print(f'WARNING: board still at {cur or "?"} after 30s — reboot may not '
              f'have executed', file=sys.stderr)

    # Wait for board to come back.  FROZEN/PANIC are terminal too — reaching them
    # means the board hung/panicked, so stop waiting immediately instead of burning
    # the full timeout, and let the state check below report the failure.
    target = ('SHELL,LOGIN,UBOOT' if not args.no_login else 'SHELL,UBOOT') + ',FROZEN,PANIC'
    if not _wait_state(device, target, args.timeout):
        if getattr(args, 'capture', False):
            _boot_capture(device, _cap_baseline, timeout=1,
                          digest_lines=args.digest_lines, capture_file=args.capture_file,
                          as_json=args.json, quiet=args.quiet, do_wait=False)
        sys.exit(1)  # _wait_state already printed DAEMON_DIED or TIMEOUT

    # Verify this is a NEW shell, not the pre-reboot one. Only meaningful when we
    # are actually looking at a shell: a board that comes back to a login prompt
    # has no post-reboot prompt yet, so the only timestamp available is the
    # pre-reboot one and the check fires on every successful reboot.
    _st_now = json.loads(sf.read_text()).get('state', '') if sf.exists() else ''
    if sf.exists() and not args.quiet and _st_now == 'SHELL':
        prompt_ago = json.loads(sf.read_text()).get('last_prompt_ago')
        if prompt_ago is not None:
            approx_prompt_wall = time.time() - prompt_ago
            if approx_prompt_wall < t_reboot_sent - 1.0:
                print('WARNING: shell prompt predates reboot command — '
                      'board may not have rebooted', file=sys.stderr)

    # Auto-login if board is at LOGIN prompt
    sf = devdir(device) / 'status.json'
    state = json.loads(sf.read_text()).get('state', '') if sf.exists() else ''
    if state == 'LOGIN' and not args.no_login:
        _do_send(device, args.user, wait=r'Password|[\$#>]\s*$', timeout=10)
        state = json.loads(sf.read_text()).get('state', '') if sf.exists() else ''
        if state == 'PASSWORD' and args.password is not None:
            _do_send(device, args.password or '', wait=r'[\$#>]\s*$', timeout=10)

    # Re-read state — login sequence may have changed it
    state = json.loads(sf.read_text()).get('state', '') if sf.exists() else ''
    if args.setup_terminal and state == 'SHELL':
        _do_send(device, 'stty cols 220 rows 50', timeout=5)

    state = json.loads(sf.read_text()).get('state', '?') if sf.exists() else '?'
    if getattr(args, 'capture', False):
        _boot_capture(device, _cap_baseline, timeout=1,
                      digest_lines=args.digest_lines, capture_file=args.capture_file,
                      as_json=args.json, quiet=args.quiet, do_wait=False)
    elif args.json:
        print(json.dumps({'state': state, 'device': device}))
    elif not args.quiet:
        print(f'Board back: state={state}')
    sys.exit(_reboot_exit_code(went_down, state))


def cmd_login(args):
    """Handle the board login sequence (username + optional password).

    Detects current state and sends credentials accordingly.
    TI boards: root with no password (default).

    Can be called after reboot or whenever the board is at a login prompt.
    """
    device = args.device
    sf = devdir(device) / 'status.json'
    if not sf.exists():
        print(f'No daemon for {device}', file=sys.stderr); sys.exit(1)

    _st = json.loads(sf.read_text())
    state = _st.get('state', 'UNKNOWN')
    if state == 'SHELL' or (state == 'QUIET' and _st.get('quiet_from') == 'SHELL'):
        print('Already at shell'); return
    if state == 'BOOTING':
        _wait_state(device, 'LOGIN', getattr(args, 'timeout', 90) or 90)
        _st = json.loads(sf.read_text())
        state = _st.get('state', 'UNKNOWN')
    # A console that went quiet AT a login prompt is still at it — treat the
    # parked state as the real one, or auto-login is inert for the commonest case.
    if state == 'QUIET' and _st.get('quiet_from') in ('LOGIN', 'PASSWORD'):
        state = _st['quiet_from']
    if state not in ('LOGIN', 'PASSWORD', 'UNKNOWN'):
        print(f'Unexpected state: {state} (need LOGIN or PASSWORD)', file=sys.stderr); sys.exit(1)

    # Skip username if already at PASSWORD prompt
    if state != 'PASSWORD':
        _do_send(device, args.user, wait=r'Password|[\$#>]\s*$', timeout=10)

    # Check if password was requested
    state = json.loads(sf.read_text()).get('state', '') if sf.exists() else ''
    if state == 'PASSWORD':
        _do_send(device, args.password or '', wait=r'[\$#>]\s*$', timeout=10)

    # Verify shell
    _wait_state(device, 'SHELL', 15)
    state = json.loads(sf.read_text()).get('state', '?') if sf.exists() else '?'
    print(f'Logged in: state={state}')
    sys.exit(0 if state == 'SHELL' else 1)


def _get_host_ip_for(board_ip):
    """Find the host IP on the same subnet as the board."""
    import socket
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect((board_ip, 80))
        return s.getsockname()[0]
    except Exception:
        return None
    finally:
        s.close()


def _upload_via_network(args):
    """Upload via temporary HTTP server — ~1MB/s vs ~1KB/s for serial base64.
    Board needs network access and wget. Inspired by Hermes deploy_serial.py pattern."""
    import http.server, threading, socket
    host_path = Path(args.hostfile)
    if not host_path.exists():
        print(f'Not found: {host_path}', file=sys.stderr); sys.exit(1)

    board_path = args.boardpath
    if board_path.endswith('/'):
        board_path += host_path.name

    # Detect board IP from args or from the board itself
    board_ip = args.board_ip
    if not board_ip:
        # Ask the board for its IP
        result = _do_send(args.device,
            "ip route get 1.1.1.1 2>/dev/null | awk '{print $7;exit}' || hostname -I | awk '{print $1}'",
            timeout=5, no_wrap=True)
        board_ip = (result.get('output', '') if result else '').strip().split()[0] if result else ''
        if not board_ip:
            print('Cannot detect board IP. Specify --board-ip.', file=sys.stderr); sys.exit(1)

    host_ip = _get_host_ip_for(board_ip)
    if not host_ip:
        print(f'Cannot find host IP on same subnet as {board_ip}', file=sys.stderr); sys.exit(1)

    # Start temporary HTTP server serving just this file's directory
    serve_dir = str(host_path.parent)
    port = args.http_port

    class SilentHandler(http.server.SimpleHTTPRequestHandler):
        def __init__(self, *a, **kw):
            super().__init__(*a, directory=serve_dir, **kw)
        def log_message(self, *_): pass  # suppress logs

    httpd = http.server.HTTPServer(('0.0.0.0', port), SilentHandler)
    thread = threading.Thread(target=httpd.serve_forever, daemon=True)
    thread.start()

    url = f'http://{host_ip}:{port}/{host_path.name}'
    size = host_path.stat().st_size
    if not args.quiet:
        print(f'HTTP server: {url}  ({size} bytes)')

    try:
        # Ensure destination directory exists
        _do_send(args.device, f'mkdir -p "$(dirname \'{board_path}\')"', timeout=5)

        # Download on the board
        result = _do_send(args.device,
            f'wget -q -O "{board_path}" "{url}" && wc -c < "{board_path}"',
            timeout=60, no_wrap=True)

        if result and not result.get('timed_out'):
            actual = _trailing_int(result.get('output', ''))
            if actual == size:
                print(f'✓ {board_path} ({size} bytes) via HTTP')
                return
            else:
                print(f'Size mismatch: expected {size}, got {actual!r}', file=sys.stderr)
        else:
            print('Upload timed out or failed', file=sys.stderr)
        sys.exit(1)
    finally:
        httpd.shutdown()


def _trailing_int(text):
    """Last all-digit token in text, or None.

    `wc -c` output comes back with the echoed command in front of it, so the
    whole string is never a bare number and str.isdigit() on it always fails —
    which reported every successful upload as a size mismatch.
    """
    for tok in reversed((text or '').split()):
        if tok.isdigit():
            return int(tok)
    return None


def cmd_upload(args):
    """Upload a file to the board.

    Two modes:
      Serial (default): base64 encoding over serial. No network needed.
        Speed: ~1 KB/s. Good for small files (modules, DTBs, scripts).
      Network (--via-network): starts HTTP server on host, board uses wget.
        Speed: ~1 MB/s. Requires board to have network access and wget.
        Automatically detects host IP on the board's subnet.

    Examples:
      serial-agent upload DEVICE ./my.ko /lib/modules/6.x/extra/
      serial-agent upload DEVICE ./large.bin /tmp/ --via-network
      serial-agent upload DEVICE ./large.bin /tmp/ --via-network --board-ip 192.168.1.100
    """
    # A base64 chunk stream typed into getty is the worst version of this bug:
    # every chunk becomes a failed username. Ask first, like every other sender.
    _maybe_auto_login(argparse.Namespace(device=args.device, user="root",
                                         password=None, no_login=False,
                                         login=False))
    if args.via_network:
        _upload_via_network(args)
        return
    import base64
    device = args.device
    host_path = Path(args.hostfile)
    if not host_path.exists():
        print(f'Not found: {host_path}', file=sys.stderr); sys.exit(1)

    board_path = args.boardpath
    if board_path.endswith('/'):
        board_path += host_path.name

    data = host_path.read_bytes()
    b64  = base64.b64encode(data).decode('ascii')
    size = len(data)

    if not args.quiet:
        print(f'Uploading {host_path.name} ({size} bytes) → {board_path}')

    if _human_session_active(device) and not args.quiet:
        print(f'NOTE: human tio session active — upload bytes will appear in the terminal',
              file=sys.stderr)

    # Ensure destination directory exists
    _do_send(device, f'mkdir -p "$(dirname \'{board_path}\')"', timeout=5)

    # Write base64 in chunks via printf (avoids shell expansion issues)
    tmp = '/tmp/_sa_upload.b64'
    _do_send(device, f'printf "" > {tmp}', timeout=5)  # create/truncate

    CHUNK = 72   # base64 chars per chunk (54 raw bytes); stays well within command limits
    chunks = [b64[i:i+CHUNK] for i in range(0, len(b64), CHUNK)]
    total  = len(chunks)

    for i, chunk in enumerate(chunks, 1):
        if not args.quiet and (i % 50 == 0 or i == total):
            print(f'  {i}/{total} chunks ({i*100//total}%)', flush=True)
        r = _do_send(device, f'printf "%s" "{chunk}" >> {tmp}', timeout=5)
        if r and r.get('timed_out'):
            print(f'Upload timed out at chunk {i}/{total}', file=sys.stderr)
            _do_send(device, f'rm -f {tmp}', timeout=5)
            sys.exit(1)

    # Decode and verify
    result = _do_send(device,
        f'base64 -d {tmp} > "{board_path}" && rm {tmp} '
        f'&& wc -c < "{board_path}"',
        timeout=30, no_wrap=True)

    if result and not result.get('timed_out'):
        actual = _trailing_int(result.get('output', ''))
        if actual == size:
            print(f'✓ {board_path} ({size} bytes)')
            sys.exit(0)
        else:
            print(f'Size mismatch: expected {size}, got {actual}', file=sys.stderr)
    sys.exit(1)


def cmd_run(args):
    """Execute a multi-line shell script on the board via base64 transfer.

    Writes the script to /tmp, executes it, captures output, cleans up.
    Useful for complex test sequences, board configuration, or any multi-step
    operation that would be tedious to send line by line.

    Example:
      serial-agent run DEVICE test_audio.sh --json --timeout 60
      echo 'aplay -l; arecord -l' | serial-agent run DEVICE - --capture
    """
    import base64
    device = args.device
    _maybe_auto_login(args)

    # Read script
    script_src = args.script
    if script_src == '-':
        script = sys.stdin.read()
    elif Path(script_src).exists():
        script = Path(script_src).read_text()
    else:
        script = script_src  # treat as inline script text

    if not script.strip():
        print('Empty script', file=sys.stderr); sys.exit(1)

    # Verify board is ready before uploading script
    sf = devdir(device) / 'status.json'
    s = json.loads(sf.read_text()) if sf.exists() else {}
    state = s.get('state', 'UNKNOWN')
    if _is_uboot(s) or state in ('LOGIN', 'PASSWORD', 'BOOTING', 'PANIC',
                                   'FROZEN', 'DEAD'):
        print(f'Board not at shell (state={state}). Run: serial-agent login {device}',
              file=sys.stderr); sys.exit(1)
    if state == 'RUNNING':
        if not _wait_state(device, 'SHELL', 30, print_output=False):
            print(f'Board stuck in RUNNING state on {device}', file=sys.stderr); sys.exit(1)
    # DEAD is ok if board had a shell prompt before (just quiet) — let the timeout decide

    if _human_session_active(device):
        print(f'NOTE: human tio session active — script bytes will appear in the terminal',
              file=sys.stderr)

    # Encode and transfer script in 72-char chunks (same approach as cmd_upload).
    # A single printf of the full base64 risks exceeding serial input buffer limits
    # for larger scripts. Chunked transfer is reliable at any script size.
    b64 = base64.b64encode(script.encode()).decode('ascii')
    tmp = f'/tmp/_sa_run_{os.getpid()}.sh'   # PID-scoped to avoid parallel collisions
    b64tmp = f'/tmp/_sa_run_{os.getpid()}.b64'
    _do_send(device, f'printf "" > {b64tmp}', timeout=5)
    CHUNK = 72
    chunks = [b64[i:i+CHUNK] for i in range(0, len(b64), CHUNK)]
    for chunk in chunks:
        r = _do_send(device, f'printf "%s" "{chunk}" >> {b64tmp}', timeout=5)
        if r and r.get('timed_out'):
            print(f'Script upload timed out during transfer', file=sys.stderr)
            _do_send(device, f'rm -f {b64tmp}', timeout=5)
            sys.exit(1)
    r = _do_send(device, f'base64 -d {b64tmp} > {tmp} && chmod +x {tmp} && rm {b64tmp}',
                 timeout=10)
    if not r or r.get('timed_out'):
        print(f'Script decode failed on board', file=sys.stderr); sys.exit(1)

    # Execute and capture (set wide terminal so script output doesn't wrap)
    result = _do_send(device,
        f'stty cols 220 rows 50 2>/dev/null; {tmp}; _rc=$?; rm -f {tmp}; echo "{EXITCODE_TAG}:$_rc"',
        wait=rf'{EXITCODE_TAG}:\d+|[\$#>]\s*$',
        timeout=args.timeout, no_wrap=getattr(args, 'no_wrap', False))

    if result:
        # _clean_output already extracted the exit code AND removed the tag line,
        # so re-parsing its output for the tag always found nothing and every run
        # exited 0 regardless of what the script did.
        exit_code = result.get('exit_code')
        result['output'] = (result.get('output') or '').strip()

        if args.json:
            print(json.dumps(result, indent=2))
        elif args.capture:
            print(result['output'])
        else:
            print(result['output'])
        sys.exit(exit_code if exit_code is not None else (0 if not result.get('timed_out') else 1))
    sys.exit(1)


def cmd_health(args):
    """Quick board health snapshot: state, memory, load, kernel, uptime.

    Returns JSON with board vitals. Useful as a pre-flight check before
    running tests, or for monitoring board health between test runs.
    """
    device = args.device
    sf = devdir(device) / 'status.json'
    if not sf.exists():
        print(json.dumps({'state': 'NO_DAEMON'})); sys.exit(1)

    s = json.loads(sf.read_text())
    state = s.get('state', 'UNKNOWN')
    health = {'state': state, 'device': device,
              'last_output_ago': s.get('last_output_ago'),
              'prompt': s.get('prompt_text')}

    if state == 'RUNNING':
        _wait_state(device, 'SHELL', 10, print_output=False)
        s = json.loads(sf.read_text())
        state = s.get('state', 'UNKNOWN')
        health['state'] = state

    # A board quiet at a shell is still at a shell. Gating on the exact name
    # reported it unhealthy with no error text whenever the keepalive was
    # suppressed, which is any time a human tio session is open.
    if state == 'SHELL' or (state == 'QUIET' and s.get('quiet_from') == 'SHELL'):
        # Gather vitals with a single compound command
        vitals_cmd = (
            'printf "UNAME:%s\\n" "$(uname -r)"; '
            'printf "UPTIME:%s\\n" "$(cut -d. -f1 /proc/uptime)"; '
            'printf "MEM_FREE:%s\\n" "$(grep MemAvailable /proc/meminfo | awk \'{print $2}\')"; '
            'printf "MEM_TOTAL:%s\\n" "$(grep MemTotal /proc/meminfo | awk \'{print $2}\')"; '
            'printf "LOAD:%s\\n" "$(cut -d\' \' -f1 /proc/loadavg)"'
        )
        result = _do_send(device, vitals_cmd, timeout=10, no_wrap=True)
        if result and not result.get('timed_out'):
            for line in result.get('output', '').splitlines():
                if ':' in line:
                    k, v = line.split(':', 1)
                    k = k.strip().lower()
                    v = v.strip()
                    if k == 'mem_free':
                        health['mem_free_kb'] = int(v) if v.isdigit() else v
                    elif k == 'mem_total':
                        health['mem_total_kb'] = int(v) if v.isdigit() else v
                    elif k == 'uptime':
                        health['uptime_sec'] = int(v) if v.isdigit() else v
                    elif k in ('uname', 'load'):
                        health[k] = v
            if 'mem_free_kb' in health and 'mem_total_kb' in health:
                health['mem_pct_used'] = round(
                    100 * (health['mem_total_kb'] - health['mem_free_kb'])
                    / health['mem_total_kb'], 1)

    print(json.dumps(health, indent=2))
    # State alone is not health: at UBOOT/LOGIN/PANIC/QUIET nothing was gathered.
    sys.exit(0 if any(k in health for k in
                      ('uname', 'uptime_sec', 'mem_free_kb', 'load')) else 1)


def cmd_ser2net_gen(args):
    """Generate /etc/ser2net.yaml from serial-boards.conf + current device state.
    Assigns TCP ports starting from --start-port. Run after plugging boards in."""
    import subprocess, shutil
    sd = shutil.which('serial-discover')
    if not sd:
        print('serial-discover not found', file=sys.stderr); sys.exit(1)

    try:
        raw = subprocess.check_output([sd, '--json'], stderr=subprocess.DEVNULL, timeout=15)
        devices = json.loads(raw)
    except Exception as e:
        print(f'serial-discover failed: {e}', file=sys.stderr); sys.exit(1)

    # Deduplicate by serial. For each serial, prefer LIVE/OPEN port (the console port)
    # over dead ports — ser2net needs a valid device path for the right interface.
    seen = {}
    for d in devices:
        ser = d['serial']
        if not ser or not d.get('label'):
            continue
        if ser not in seen:
            seen[ser] = d
        elif d['state'] in ('LIVE', 'OPEN') and seen[ser]['state'] not in ('LIVE', 'OPEN'):
            seen[ser] = d   # upgrade to live port

    if not seen:
        print('No labeled boards found. Run serial-agent auto-label first.',
              file=sys.stderr); sys.exit(1)

    port = args.start_port
    blocks = []
    mapping = []
    for ser, d in seen.items():
        label = d['label']
        safe  = re.sub(r'[^A-Za-z0-9_-]', '_', label)
        baud  = d['baud']
        dev   = d['device']
        blocks.append(
            f'connection: &{safe}\n'
            f'  accepter: tcp,{port}\n'
            f'  connector: serialdev,{dev},{baud}n81,local\n'
            f'  options:\n'
            f'    banner: "\\r\\n{label} ({ser}) @ {baud}\\r\\n"\n'
        )
        mapping.append((label, dev, port, baud))
        port += 1

    from datetime import date
    yaml_out = (
        f'# Generated by serial-agent ser2net-gen  {date.today()}\n'
        f'# sudo cp {args.output} /etc/ser2net.yaml && sudo systemctl restart ser2net\n'
        f'%YAML 1.1\n---\n\n'
        + '\n'.join(blocks)
    )

    if args.output == '-':
        print(yaml_out)
    else:
        Path(args.output).write_text(yaml_out)
        print(f'Written to {args.output}')

    print('\nBoard → TCP port:')
    for label, dev, tcp_port, baud in mapping:
        print(f'  {label:25} {dev}  →  tcp:{tcp_port}  ({baud} baud)')
    print(f'\nInstall:')
    print(f'  sudo cp {args.output} /etc/ser2net.yaml')
    print(f'  sudo systemctl restart ser2net')
    print(f'\nThen:')
    print(f'  serial-agent discover   # ser2net_tcp field will be populated')
    print(f'  tio.sh 1                # auto-connects via TCP if daemon is running')


def cmd_list(args):
    """List all devices with running serial-agent daemons.
    Quick overview — use 'status DEVICE' for full detail on one device."""
    if not AGENT_BASE.exists():
        print('No daemons running'); return
    if getattr(args, 'verbose', False) and not args.json:
        for _dd in sorted(AGENT_BASE.iterdir()):
            _sf = _dd / 'status.json'
            if not (_dd / 'daemon.pid').exists() or not _sf.exists(): continue
            try: _s = json.loads(_sf.read_text())
            except (OSError, ValueError): continue
            print(f"{_dd.name:14} pid={_s.get('pid','?')} relay={_s.get('relay','-')} "
                  f"idle_timeout={_s.get('idle_timeout','?')} port_held={_s.get('port_held','?')}")
        print()
    rows = []
    for ddir in sorted(AGENT_BASE.iterdir()):
        if not ddir.is_dir(): continue
        pf = ddir / 'daemon.pid'; sf = ddir / 'status.json'
        if not pf.exists(): continue
        try:
            os.kill(int(pf.read_text().strip()), 0)
        except (OSError, ValueError):
            continue
        state = via = '?'; buf_lines = 0; prompt = ''; dev_path = f'/dev/{ddir.name}'
        if sf.exists():
            try:
                s = json.loads(sf.read_text())
                state = s.get('state','?'); via = s.get('via','?')
                dev_path = s.get('device', dev_path)
                if state == 'QUIET' and s.get('quiet_from'):
                    state = f"QUIET\u2190{s['quiet_from']}"
                buf_lines = s.get('buf_lines', 0); prompt = s.get('prompt_text','')
            except Exception: pass
        if via == 'direct' and len(_device_holders(dev_path)) > 1:
            state = 'SPLIT!'
        rows.append((ddir.name, state, via, buf_lines, prompt))
    if not rows:
        print('No daemons running'); return
    if args.json:
        print(json.dumps([{'device': f'/dev/{r[0]}', 'state': r[1], 'via': r[2],
                           'buf_lines': r[3], 'prompt': r[4]} for r in rows], indent=2))
        return
    G='\033[32m'; C='\033[36m'; Y='\033[33m'; D='\033[2m'; R='\033[31m'; B='\033[1m'; N='\033[0m'
    def _state_fmt(s):
        if s in ('SHELL', 'RUNNING'):   return f'{G}{s:<9}{N}'
        if s in ('UBOOT', 'BOOTING'):   return f'{Y}{s:<9}{N}'
        if s in ('LOGIN', 'PASSWORD'):  return f'{C}{s:<9}{N}'
        if s == 'SPLIT!':               return f'{R}{B}{s:<9}{N}'
        if s in ('DEAD', 'PANIC') or s.startswith('QUIET←PANIC'):
            return f'{R}{s:<9}{N}'
        if s == 'FROZEN':               return f'{Y}{s:<9}{N}'
        return f'{D}{s:<9}{N}'
    print(f'{B}{"Device":<14} {"State":<9} {"Via":<28} {"Buf":>5}  Prompt{N}')
    print('─' * 74)
    for name, state, via, buf_lines, prompt in rows:
        print(f'{name:<14} {_state_fmt(state)} {via:<28} {buf_lines:>5}  {D}{prompt}{N}')


def cmd_ops(args):
    """Print recent operations from ops.log for a device.

    Each line is a JSON record: {ts, op, pid, ...command-specific fields}.
    Human-readable by default; --json prints raw JSON lines.
    """
    log_file = devdir(args.device) / 'ops.log'
    if not log_file.exists():
        print('No operations logged yet.')
        return
    lines = log_file.read_text().splitlines()
    tail = lines[-args.lines:]
    if args.json:
        print('\n'.join(tail))
        return
    for raw in tail:
        try:
            e = json.loads(raw)
            fields = ' '.join(f'{k}={v}' for k, v in e.items()
                              if k not in ('ts', 'op', 'pid'))
            print(f'[{e.get("ts","")}] {e.get("op","?"):12s}  {fields}')
        except (json.JSONDecodeError, KeyError):
            print(raw)


def cmd_attach(args):
    """Launch the configured terminal directly on a daemon's device.
    Shorthand for: serial-connect /dev/DEVICE  (bypasses the menu)"""
    import shutil
    sc = shutil.which('serial-connect')
    if not sc:
        print('serial-connect not found in PATH', file=sys.stderr); sys.exit(1)
    os.execv(sc, [sc, args.device])


def cmd_test(args):
    """Self-test using a virtual pty pair (no real hardware needed).

    Creates a socat loopback (two connected PTYs), runs a daemon on one end,
    injects board output into the other end, and validates:
      1. daemon starts and holds the port
      2. startup probe fires (CR sent to board within 2s)
      3. injected shell prompt → state SHELL
      4. send() delivers command and captures output
      5. relay TCP client connects and receives data
      6. human_session stops cmd_stop; --force overrides it
      7. daemon exits cleanly (pid file removed)

    Requires: socat
    """
    import fcntl, shutil, socket, subprocess, tempfile, threading

    # This suite is NOT concurrency-safe: it binds listeners, creates ptys and
    # takes lock paths that a second run collides with, producing failures that
    # look like real defects. Refuse rather than mis-fail.
    _lk = open('/tmp/serial-agent-test.lock', 'w')
    try:
        fcntl.flock(_lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print('another `serial-agent test` is already running — this suite is not '
              'concurrency-safe; wait for it to finish', file=sys.stderr)
        sys.exit(2)
    _lk.write(f'{os.getpid()}\n'); _lk.flush()

    verbose = args.verbose
    passed = 0
    failed = 0

    def ok(msg):
        nonlocal passed; passed += 1
        print(f'  \033[32m✓\033[0m  {msg}')

    def fail(msg, detail=''):
        nonlocal failed; failed += 1
        s = f'  \033[31m✗\033[0m  {msg}'
        if detail: s += f'\n     {detail}'
        print(s)

    def check(cond, msg, detail=''):
        if cond: ok(msg)
        else:    fail(msg, detail)

    def watcher_attached(fifo, timeout=3.0):
        """Block until a 'watch' process holds the read end of `fifo`.

        The daemon drops any chunk pushed while output.fifo has no reader, so
        injecting board output on a fixed sleep races the watcher's own startup
        (~0.1s idle, past 0.3s under load) and the watcher then waits out its
        whole timeout.  O_WRONLY|O_NONBLOCK returns ENXIO until a reader is on
        the pipe -- the same syscall the daemon's push uses to detect one.
        """
        _dl = time.time() + timeout
        while time.time() < _dl:
            try:
                _wfd = os.open(str(fifo), os.O_WRONLY | os.O_NONBLOCK)
                os.close(_wfd)
                return True
            except OSError:
                time.sleep(0.02)
        return False

    # ── Unit: boot-digest + freeze/panic patterns (no hardware needed) ─────────
    print(f'\nserial-agent self-test\n{"─"*40}')
    print('  boot digest + patterns (unit)')
    _panic_hits = ['Kernel panic - not syncing', 'Internal error: Oops: 96000005',
                   'Unable to handle kernel NULL pointer dereference', 'Call trace:',
                   'Unhandled fault: alignment', 'SError Interrupt on CPU0',
                   'watchdog: BUG: soft lockup - CPU#0 stuck for 22s', 'data abort',
                   'rcu: INFO: rcu_sched detected stalls on CPUs']
    check(all(RE_PANIC.search(s) for s in _panic_hits),
          'RE_PANIC matches real kernel/U-Boot fault strings',
          'missed: ' + '; '.join(s for s in _panic_hits if not RE_PANIC.search(s)))
    _panic_miss = ['Starting kernel ...', 'random: crng init done',
                   'debug: enabling feature x', 'systemd[1]: Reached target Basic System.']
    check(not any(RE_PANIC.search(s) for s in _panic_miss),
          'RE_PANIC does not false-fire on benign boot lines',
          'fired: ' + '; '.join(s for s in _panic_miss if RE_PANIC.search(s)))
    _boot = [f'[00:00:0{i%10}.000] [    {i}.000000] init step {i}' for i in range(500)]
    _boot[200] = '[00:00:03.000] [    3.100000] Kernel panic - not syncing: attempted to kill init!'
    _boot[201] = '[00:00:03.000] [    3.200000] Call trace:'
    _sum, _dig = _boot_digest(_boot, tail=10)
    _digtext = '\n'.join(_dig)
    check(_sum['fatal'] == 2 and 'Kernel panic' in _digtext,
          '_boot_digest keeps every fatal line', f"fatal={_sum['fatal']}")
    check(len(_dig) < len(_boot) and '…' in _digtext,
          '_boot_digest elides the benign firehose', f'{len(_dig)} of {len(_boot)} lines')
    check('init step 499' in _digtext,
          '_boot_digest preserves the boot tail (pre-prompt / pre-freeze context)')
    check(abs((_sum['boot_secs'] or 0) - 499.0) < 0.01,
          '_boot_digest extracts kernel boot time', f"boot_secs={_sum['boot_secs']}")
    _gapped = _boot + ['[00:00:05.000] <<serial-agent GAP 1.2s — port reopened; '
                       'board output during this window may be lost>>']
    check(_boot_digest(_gapped)[0]['gap'], '_boot_digest flags a reconnect gap')
    # Cap regression: a flood of error lines must NOT blow up the digest (the
    # budget<=0 slice bug kept the whole list; guard it stays bounded).
    _noisy = [f'[00:00:00.000] error: thing {i} failed' for i in range(3000)]
    _cap_sum, _cap_dig = _boot_digest(_noisy, tail=30, max_hits=120)
    check(len(_cap_dig) < 400 and _cap_sum['errors'] == 3000,
          '_boot_digest caps a flood of errors (no runaway digest)',
          f'digest={len(_cap_dig)} lines')

    if not shutil.which('socat'):
        print('serial-agent test requires socat (sudo apt install socat)', file=sys.stderr)
        sys.exit(1)

    # Create a temp dir for the virtual device + daemon state
    with tempfile.TemporaryDirectory(prefix='sa-test-') as td:
        td = Path(td)
        pty_a = td / 'pty-a'   # daemon connects here
        pty_b = td / 'pty-b'   # test harness writes here (simulates board)

        # socat loopback: two connected PTYs
        socat_proc = subprocess.Popen(
            ['socat',
             f'pty,raw,echo=0,link={pty_a}',
             f'pty,raw,echo=0,link={pty_b}'],
            stderr=subprocess.DEVNULL)
        # wait for both PTYs to appear
        deadline = time.time() + 3
        while time.time() < deadline:
            if pty_a.exists() and pty_b.exists():
                break
            time.sleep(0.05)
        check(pty_a.exists() and pty_b.exists(),
              'socat virtual pty pair created')
        if not pty_a.exists():
            socat_proc.terminate(); return

        vdev = str(pty_a)
        env = os.environ.copy()
        env['SERIAL_AGENT_BASE'] = str(td / 'state')

        # ── Test 1: daemon starts ─────────────────────────────────────────
        # Use DEVNULL (not PIPE/capture_output) so subprocess.run returns
        # promptly.  The daemon double-forks and detaches, but inherited pipe
        # write-ends can cause subprocess.run to block waiting for EOF.
        r = subprocess.run(
            [sys.argv[0], 'start', vdev, '--baud', '115200', '--idle-timeout', '0'],
            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True, env=env)
        if verbose and r.stderr: print(f'     start stderr: {r.stderr.strip()}')
        pid_file = Path(env['SERIAL_AGENT_BASE']) / Path(vdev).name / 'daemon.pid'
        # Give daemon up to 2s to write pid file
        deadline = time.time() + 2
        while time.time() < deadline and not pid_file.exists():
            time.sleep(0.05)
        daemon_pid = None
        try:
            daemon_pid = int(pid_file.read_text().strip())
            os.kill(daemon_pid, 0)
            ok(f'daemon started (PID {daemon_pid})')
        except Exception as e:
            fail('daemon did not start', str(e))
            socat_proc.terminate(); return

        # ── Test 2: startup probe (CR sent to board within 2s) ────────────
        # Open pty_b in non-blocking mode, wait for the CR byte
        fd_b = os.open(str(pty_b), os.O_RDWR | os.O_NONBLOCK)
        probe_received = False
        deadline = time.time() + 2
        while time.time() < deadline:
            try:
                data = os.read(fd_b, 64)
                if b'\r' in data:
                    probe_received = True
                    break
            except OSError:
                time.sleep(0.05)
        check(probe_received, 'startup probe CR received at board within 2s')

        # ── Test 3: shell prompt → state SHELL ───────────────────────────
        # Inject a shell prompt into pty_b so daemon sees it
        os.write(fd_b, b'\r\nroot@testboard:~# ')
        deadline = time.time() + 2
        sf = Path(env['SERIAL_AGENT_BASE']) / Path(vdev).name / 'status.json'
        shell_state = False
        while time.time() < deadline:
            try:
                s = json.loads(sf.read_text())
                if s.get('state') == 'SHELL':
                    shell_state = True; break
            except Exception:
                pass
            time.sleep(0.05)
        check(shell_state, 'injected prompt → state SHELL',
              'check daemon log for details' if not shell_state else '')

        # ── Test 3b: prompt split across two reads is learned whole ───────
        # A shell prompt carries no trailing newline, so an os.read() boundary
        # lands inside it routinely. State detection must see the stitched line,
        # not the raw chunk — matching the chunk alone recorded fragments like
        # '-evm:~#' as prompt_text and put them in `list` and status.json.
        os.write(fd_b, b'\r\n')
        time.sleep(0.4)
        os.write(fd_b, b'root@splitboard')
        time.sleep(0.4)
        os.write(fd_b, b':~# ')
        deadline = time.time() + 2
        split_prompt = ''
        while time.time() < deadline:
            try:
                s = json.loads(sf.read_text())
                split_prompt = s.get('prompt_text', '')
                if split_prompt == 'root@splitboard:~#':
                    break
            except Exception:
                pass
            time.sleep(0.05)
        check(split_prompt == 'root@splitboard:~#',
              'prompt split across reads is learned whole, not as a fragment',
              f'prompt_text={split_prompt!r}')

        # ── Test 4: send() delivers command, output captured ──────────────
        # We can't do a full round-trip without an interactive shell, but we
        # can verify the command bytes reach the board side.
        recv_buf = []
        board_reader_stop = threading.Event()
        def _read_board():
            while not board_reader_stop.is_set():
                try:
                    d = os.read(fd_b, 256)
                    recv_buf.append(d)
                except OSError:
                    time.sleep(0.02)
        t = threading.Thread(target=_read_board, daemon=True); t.start()

        # Write a command to the FIFO directly
        fifo = Path(env['SERIAL_AGENT_BASE']) / Path(vdev).name / 'input.fifo'
        cmd_bytes = b'echo hello\n'
        sent = False
        for _ in range(20):
            try:
                ffd = os.open(str(fifo), os.O_WRONLY | os.O_NONBLOCK)
                os.write(ffd, cmd_bytes); os.close(ffd)
                sent = True; break
            except OSError:
                time.sleep(0.05)
        # Give the thread time to receive it
        time.sleep(0.3)
        board_saw_cmd = any(b'echo hello' in b for b in recv_buf)
        check(sent and board_saw_cmd,
              'FIFO send reaches board side',
              f'sent={sent} board_saw={board_saw_cmd}')

        # ── Test 5: relay TCP client receives data ─────────────────────────
        relay_ok = False
        try:
            s2 = json.loads(sf.read_text())
            relay_addr = s2.get('relay', '')
            if relay_addr:
                host, port = relay_addr.split(':')
                sock = socket.socket()
                sock.settimeout(2)
                sock.connect((host, int(port)))
                # connect() returns on the kernel handshake, but the daemon
                # broadcasts only to clients its accept loop has registered —
                # board data written inside that window is dropped, not queued.
                # Re-inject until it lands; still fails in <=3s if it never does.
                sock.settimeout(0.5)
                _dl = time.time() + 3
                while time.time() < _dl and not relay_ok:
                    os.write(fd_b, b'relay-test-data\r\n')
                    try:
                        relay_ok = b'relay-test-data' in sock.recv(256)
                    except socket.timeout:
                        pass
                sock.close()
        except Exception as e:
            if verbose: print(f'     relay error: {e}')
        check(relay_ok, 'relay TCP client receives board data')

        # ── Test 6: output.fifo exists and is a real FIFO ─────────────────
        import stat as _stat
        ofifo = Path(env['SERIAL_AGENT_BASE']) / Path(vdev).name / 'output.fifo'
        fifo_is_fifo = ofifo.exists() and _stat.S_ISFIFO(ofifo.stat().st_mode)
        check(fifo_is_fifo, 'output.fifo created as a FIFO')

        # ── Test 7: watch returns the instant a pattern matches (push) ────
        if fifo_is_fifo:
            wp = subprocess.Popen(
                [sys.argv[0], 'watch', vdev, '--until', 'PONGTOKEN', '--timeout', '5'],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env)
            watcher_attached(ofifo)
            os.write(fd_b, b'\r\nsome noise line\r\nPONGTOKEN is here\r\n')
            try:
                w_out, w_err = wp.communicate(timeout=6)
            except subprocess.TimeoutExpired:
                wp.kill(); w_out, w_err = wp.communicate()
            watch_ok = False
            try:
                wj = json.loads(w_out.strip().splitlines()[-1])
                watch_ok = wj.get('matched') is not None
            except Exception:
                pass
            check(watch_ok, 'watch returns on pattern match (push channel)',
                  f'rc={wp.returncode} out={w_out!r} err={w_err!r}' if not watch_ok else '')
        else:
            fail('watch returns on pattern match (push channel)', 'no output.fifo')

        # ── Test 8: fused send+watch round-trip (--send then --until) ─────
        if fifo_is_fifo:
            del recv_buf[:]   # reuse Test 4's board-side reader
            wp = subprocess.Popen(
                [sys.argv[0], 'watch', vdev, '--send', 'PINGCMD',
                 '--until', 'PONGTOKEN', '--timeout', '5'],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env)
            # when the daemon forwards PINGCMD to the board side, reply
            _dl = time.time() + 3; replied = False
            while time.time() < _dl:
                if any(b'PINGCMD' in b for b in recv_buf):
                    os.write(fd_b, b'\r\nPONGTOKEN ok\r\n'); replied = True; break
                time.sleep(0.02)
            try:
                w_out, w_err = wp.communicate(timeout=6)
            except subprocess.TimeoutExpired:
                wp.kill(); w_out, w_err = wp.communicate()
            fused_ok = False
            try:
                wj = json.loads(w_out.strip().splitlines()[-1])
                fused_ok = wj.get('matched') is not None
            except Exception:
                pass
            check(replied and fused_ok, 'fused send+watch round-trip',
                  f'replied={replied} out={w_out!r} err={w_err!r}'
                  if not (replied and fused_ok) else '')
        else:
            fail('fused send+watch round-trip', 'no output.fifo')

        # ── Test 9: back-to-back watch — 2nd matches via PUSH, not backstop ──
        # Regression: a stale write-fd from the 1st watcher must not eat the 1st
        # chunk the 2nd watcher needs (that stalled it to the ~10s stream.log
        # backstop — caught on real hardware). A push match returns in ms.
        if fifo_is_fifo:
            w1 = subprocess.Popen(
                [sys.argv[0], 'watch', vdev, '--until', 'RECON_A', '--timeout', '5'],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, text=True, env=env)
            a1 = watcher_attached(ofifo); os.write(fd_b, b'\r\nRECON_A here\r\n')
            try: w1.communicate(timeout=6)
            except subprocess.TimeoutExpired: w1.kill(); w1.communicate()
            w2 = subprocess.Popen(
                [sys.argv[0], 'watch', vdev, '--until', 'RECON_B', '--timeout', '5'],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env)
            a2 = watcher_attached(ofifo); os.write(fd_b, b'\r\nRECON_B here\r\n')
            try: r_out, r_err = w2.communicate(timeout=6)
            except subprocess.TimeoutExpired: w2.kill(); r_out, r_err = w2.communicate()
            recon_ok = False; r_ms = None
            try:
                rj = json.loads(r_out.strip().splitlines()[-1])
                r_ms = rj.get('elapsed_ms')
                recon_ok = rj.get('matched') is not None and r_ms is not None and r_ms < 2500
            except Exception:
                pass
            check(recon_ok, 'back-to-back watch matches via push (no backstop stall)',
                  f'attached={a1},{a2} elapsed_ms={r_ms} '
                  f'(>=2500 = fell to stream.log backstop)' if not recon_ok else '')
        else:
            fail('back-to-back watch matches via push (no backstop stall)', 'no output.fifo')

        # ── Test 10: human_session blocks cmd_stop; --force overrides ──────
        hs = Path(env['SERIAL_AGENT_BASE']) / Path(vdev).name / 'human_session'
        hs.write_text(f'{os.getpid()}\n{time.time()}\n')

        # stop without --force should refuse
        r = subprocess.run(
            [sys.argv[0], 'stop', vdev],
            capture_output=True, text=True, env=env)
        stop_refused = r.returncode != 0 and 'human session' in r.stderr
        check(stop_refused, 'cmd_stop refused while human_session active',
              r.stderr.strip() if not stop_refused else '')

        # stop --force should succeed
        r = subprocess.run(
            [sys.argv[0], 'stop', '--force', vdev],
            capture_output=True, text=True, env=env)
        check(r.returncode == 0, 'cmd_stop --force succeeds',
              r.stderr.strip() if r.returncode != 0 else '')

        # ── Test 7: daemon exits cleanly (pid file removed) ───────────────
        time.sleep(0.5)
        pid_gone = not pid_file.exists() or not os.path.exists(f'/proc/{daemon_pid}')
        check(pid_gone, 'daemon exited cleanly (pid file removed)')

        # Stop the reader before the fd number is freed: a live reader on a
        # recycled fd consumes a later test's file and leaves it at EOF.
        board_reader_stop.set(); t.join(timeout=2)
        os.close(fd_b)
        socat_proc.terminate()
        socat_proc.wait()

    # ── ser2net mode: auto-detect + socket data path + watch over TCP ──────────
    print(f'\nser2net mode\n{"─"*40}')
    with tempfile.TemporaryDirectory(prefix='sa-s2n-') as td2:
        td2 = Path(td2)
        board_pty = td2 / 'boardpty'          # the "board" serial side
        # Ephemeral port + per-PID device name: two concurrent `serial-agent test`
        # runs must not fight over a listener or a lock path.
        with socket.socket() as _ps:
            _ps.bind(('127.0.0.1', 0)); port = _ps.getsockname()[1]
        vdev2 = f'/dev/fake_s2n_dev{os.getpid()}'
        s2conf = td2 / 'ser2net.yaml'
        s2conf.write_text(
            "connection: &con\n"
            f"    accepter: tcp,{port}\n"
            f"    connector: serialdev,{vdev2},115200n81,local\n")
        # fake ser2net: PTY (board) opened first so it exists before the daemon
        # connects; TCP-LISTEN is where the daemon attaches.
        s2proc = subprocess.Popen(
            ['socat', f'PTY,link={board_pty},raw,echo=0',
             f'TCP-LISTEN:{port},reuseaddr'], stderr=subprocess.DEVNULL)
        deadline = time.time() + 3
        while time.time() < deadline and not board_pty.exists():
            time.sleep(0.05)
        check(board_pty.exists(), 'fake ser2net (socat TCP-LISTEN↔PTY) created')

        env2 = os.environ.copy()
        env2['SERIAL_AGENT_BASE']   = str(td2 / 'state')
        env2['SERIAL_SER2NET_CONF'] = str(s2conf)
        r = subprocess.run([sys.argv[0], 'start', vdev2, '--idle-timeout', '0'],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                           text=True, env=env2)
        auto = 'routing through it' in r.stdout
        check(auto, 'start auto-detected ser2net from config',
              f'stdout={r.stdout!r}' if not auto else '')

        sf2 = Path(env2['SERIAL_AGENT_BASE']) / Path(vdev2).name / 'status.json'
        via_tcp = False
        deadline = time.time() + 3
        while time.time() < deadline:
            try:
                if json.loads(sf2.read_text()).get('via', '').startswith('tcp:'):
                    via_tcp = True; break
            except Exception:
                pass
            time.sleep(0.05)
        check(via_tcp, 'daemon connected via ser2net TCP (via=tcp:...)')

        try:
            fdb2 = os.open(str(board_pty), os.O_RDWR | os.O_NONBLOCK)
        except OSError:
            fdb2 = -1
        shell2 = False
        if fdb2 >= 0:
            os.write(fdb2, b'\r\nroot@s2n-board:~# ')
            deadline = time.time() + 3
            while time.time() < deadline:
                try:
                    if json.loads(sf2.read_text()).get('state') == 'SHELL':
                        shell2 = True; break
                except Exception:
                    pass
                time.sleep(0.05)
        check(shell2, 'ser2net socket data reaches _append (state → SHELL)')

        watch2 = False
        ofifo2 = Path(env2['SERIAL_AGENT_BASE']) / Path(vdev2).name / 'output.fifo'
        if fdb2 >= 0 and ofifo2.exists():
            wp = subprocess.Popen(
                [sys.argv[0], 'watch', vdev2, '--until', 'S2N_PUSH', '--timeout', '5'],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, env=env2)
            watcher_attached(ofifo2); os.write(fdb2, b'\r\nS2N_PUSH ok\r\n')
            try: wo, _ = wp.communicate(timeout=6)
            except subprocess.TimeoutExpired: wp.kill(); wo, _ = wp.communicate()
            try: watch2 = json.loads(wo.strip().splitlines()[-1]).get('matched') is not None
            except Exception: pass
        check(watch2, 'watch works through ser2net (push over TCP transport)')

        subprocess.run([sys.argv[0], 'stop', '--force', vdev2],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env2)
        if fdb2 >= 0: os.close(fdb2)
        s2proc.terminate(); s2proc.wait()

    # ── Unit: login-prompt detection before sending ───────────────────────────
    # A command sent to a console parked at LOGIN is consumed as a username, then
    # a password, then 'Login incorrect'. Nothing runs and nothing useful echoes,
    # which reads as the board dropping input — so sends auto-login by default.
    print('  login-prompt detection (unit)')
    for _st, _qf, _ex, _want in [
            ('SHELL',    '',         False, False),
            ('LOGIN',    '',         False, True),
            ('PASSWORD', '',         False, True),
            ('QUIET',    'LOGIN',    False, True),
            ('QUIET',    'PASSWORD', False, True),
            ('QUIET',    'SHELL',    False, False),
            ('BOOTING',  '',         False, False),   # auto must not become a 90s wait
            ('BOOTING',  '',         True,  True),    # --login opts into that wait
            ('UNKNOWN',  '',         False, False)]:
        _got = _needs_login({'state': _st, 'quiet_from': _qf}, _ex)
        check(_got == _want,
              f'_needs_login: {_st}{"←" + _qf if _qf else ""}'
              f'{" --login" if _ex else ""} → {_want}', f'got {_got}')

    # ── Unit: one daemon per tty (duplicate-daemon guard) ─────────────────────
    # Two daemons on one tty make the kernel hand each byte to exactly one of
    # them, so a console shows roughly every other character.  daemon.pid alone
    # cannot prevent that — it gets deleted by hand during a restart while the
    # old daemon lives on.  Fixture is a bare pty with the slave closed, so
    # fuser reports only real openers (socat's pty,link= would hold one itself).
    print('  duplicate-daemon guard (unit)')
    import pty as _pty
    _gm, _gs = _pty.openpty()
    _gdev = os.ttyname(_gs)
    os.close(_gs)
    _gtd = Path(tempfile.mkdtemp(prefix='sa-guard-'))
    _genv = os.environ.copy(); _genv['SERIAL_AGENT_BASE'] = str(_gtd)
    _gpidf = _gtd / Path(_gdev).name / 'daemon.pid'

    def _sa(*a):
        """Run a serial-agent subcommand; capture via files, not pipes — the
        daemon double-forks and an inherited pipe write-end can stall run()."""
        _o, _e = _gtd / '.out', _gtd / '.err'
        with open(_o, 'w') as fo, open(_e, 'w') as fe:
            r = subprocess.run([sys.argv[0], *a], stdout=fo, stderr=fe,
                               text=True, env=_genv, timeout=30)
        return r.returncode, _o.read_text(), _e.read_text()

    _leech = None
    try:
        _rc, _out, _err = _sa('start', _gdev, '--idle-timeout', '0')
        check('daemon PID' in _out, 'guard: first start succeeds', f'{_out!r} {_err!r}')
        _rc, _out, _err = _sa('start', _gdev, '--idle-timeout', '0')
        check('ALREADY' in _out, 'guard: pidfile guard blocks a 2nd start', repr(_out))

        # The documented restart recipe removes daemon.pid by hand.  The live
        # daemon must be adopted back, never joined by a second one.
        _gpidf.unlink(missing_ok=True)
        _rc, _out, _err = _sa('start', _gdev, '--idle-timeout', '0')
        check('ADOPTED' in _out and _rc == 0,
              'guard: orphan adopted after daemon.pid removed', f'rc={_rc} {_out!r}')
        check(len(_device_holders(_gdev)) == 1,
              'guard: still exactly one holder on the tty')
        check(_gpidf.exists() and _gpidf.read_text().strip().isdigit(),
              'guard: adoption restores daemon.pid')
        # Adoption must not strip the running daemon of its control files.
        check((_gtd / Path(_gdev).name / 'status.json').exists(),
              'guard: adoption preserves the live daemon status.json')

        # A second reader is reported, not silently tolerated.
        _leech = subprocess.Popen(
            [sys.executable, '-c',
             'import os,sys,time;os.open(sys.argv[1],os.O_RDONLY|os.O_NOCTTY);'
             'time.sleep(30)', _gdev])
        time.sleep(0.5)
        _rc, _out, _err = _sa('list')
        check('SPLIT!' in _out, 'guard: list flags SPLIT! when a 2nd reader holds the tty',
              repr(_out))
        _leech.terminate(); _leech.wait(timeout=5); _leech = None
        time.sleep(0.4)
        _rc, _out, _err = _sa('list')
        check('SPLIT!' not in _out, 'guard: SPLIT! clears when the 2nd reader exits')

        check(_is_real_serial('/dev/ttyUSB5') and _is_real_serial('/dev/ttyACM0')
              and not _is_real_serial(_gdev),
              'guard: hard refusal scoped to real UARTs, not ptys')
    finally:
        if _leech is not None:
            _leech.terminate()
        subprocess.run([sys.argv[0], 'stop', _gdev, '--force'],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=_genv)
        os.close(_gm)
        shutil.rmtree(_gtd, ignore_errors=True)

    # ── Unit: probe_tty daemon-state mapping (QUIET/PANIC surfaced, not dead) ──
    # Stages a fake daemon dir under /tmp/serial-agent (status.json in the
    # daemon's real indent=2 format) and runs the real bash probe_tty against
    # it: QUIET reached from a live state surfaces as LIVE (idle board ≠ dead
    # cable; display carries only LIVE/OPEN/FAIL/dead, QUIET stays internal to
    # the daemon), PANIC (incl. QUIET←PANIC) as PANIC; silence from UNKNOWN
    # stays DEAD.  probe_tty output goes to a file, not a pipe — pipe capture
    # of these subprocesses intermittently read empty in-suite.
    print('  probe_tty state mapping (unit)')
    _common = _SCRIPT_DIR / 'serial-common.sh'
    _fake = f'ttyFAKEPROBE{os.getpid()}'   # per-PID: concurrent runs must not share a fixture
    _fdir = Path('/tmp/serial-agent') / _fake
    _fdir.mkdir(parents=True, exist_ok=True)
    try:
        (_fdir / 'daemon.pid').write_text(str(os.getpid()))
        with tempfile.TemporaryDirectory(prefix='sa-probe-') as _ptd:
            _pout = Path(_ptd) / 'probe.out'
            _cases = [
                    ('SHELL',   '',        'LIVE'),
                    ('BOOTING', '',        'LIVE'),
                    ('QUIET',   'LOGIN',   'LIVE'),
                    ('QUIET',   'SHELL',   'LIVE'),
                    ('QUIET',   'UNKNOWN', 'DEAD'),
                    ('QUIET',   'PANIC',   'PANIC'),
                    ('PANIC',   'PANIC',   'PANIC'),
                    ('FROZEN',  'BOOTING', 'FROZEN'),
                    ('UNKNOWN', '',        'DEAD')]
            for _st, _qf, _want in _cases:
                _tmpst = _fdir / 'status.json.tmp'
                _tmpst.write_text(json.dumps(
                    {'quiet_from': _qf, 'state': _st, 'prompt_text': 'x'},
                    indent=2))
                _tmpst.rename(_fdir / 'status.json')
                _pr = subprocess.run(
                    ['bash', '-c',
                     f'source "{_common}"; '
                     f'probe_tty /dev/{_fake} 115200 > "{_pout}"'],
                    capture_output=True, text=True, timeout=10)
                _out = _pout.read_text().strip() if _pout.exists() else ''
                _got = (_out.split('|') or [''])[0]
                check(_got == _want,
                      f'probe_tty: state={_st} quiet_from={_qf or "-"} → {_want}',
                      f'got {_out!r} rc={_pr.returncode} '
                      f'err={_pr.stderr.strip()[:160]!r}')
    finally:
        shutil.rmtree(_fdir, ignore_errors=True)

    # ── Integration: FROZEN detection + snapshot ──────────────────────────────
    # Dedicated daemon with a short DEAD_AFTER so a mid-boot silence trips FROZEN
    # in ~1.2s instead of 30s.  Isolated (own socat pair + state dir) so the low
    # threshold cannot disturb the other tests.
    if shutil.which('socat'):
        with tempfile.TemporaryDirectory(prefix='sa-frz-') as tf:
            tf = Path(tf)
            pa, pb = tf / 'pa', tf / 'pb'
            fz = subprocess.Popen(
                ['socat', f'pty,raw,echo=0,link={pa}', f'pty,raw,echo=0,link={pb}'],
                stderr=subprocess.DEVNULL)
            dl = time.time() + 3
            while time.time() < dl and not (pa.exists() and pb.exists()):
                time.sleep(0.05)
            fenv = os.environ.copy()
            fenv['SERIAL_AGENT_BASE'] = str(tf / 'state')
            fenv['SERIAL_DEAD_AFTER'] = '1.2'
            subprocess.run([sys.argv[0], 'start', str(pa), '--idle-timeout', '0'],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=fenv)
            fdir  = Path(fenv['SERIAL_AGENT_BASE']) / pa.name
            fpid  = fdir / 'daemon.pid'
            dl = time.time() + 2
            while time.time() < dl and not fpid.exists():
                time.sleep(0.05)
            fzsf   = fdir / 'status.json'
            fzsnap = fdir / 'frozen.snapshot'
            fdb = os.open(str(pb), os.O_RDWR | os.O_NONBLOCK)
            try: os.read(fdb, 256)           # drain the startup-probe CR
            except OSError: pass
            # Inject a mid-boot kernel line, then go silent → should trip FROZEN.
            os.write(fdb, b'\r\n[    1.234567] mmc0: starting card init\r\n')
            got_frozen = False
            dl = time.time() + 6
            while time.time() < dl:
                try:
                    if json.loads(fzsf.read_text()).get('state') == 'FROZEN':
                        got_frozen = True; break
                except Exception:
                    pass
                time.sleep(0.1)
            _fst = (json.loads(fzsf.read_text()).get('state', '?')
                    if fzsf.exists() else '?')
            check(got_frozen, 'mid-boot silence → state FROZEN (not QUIET)', f'state={_fst}')
            check(got_frozen and fzsnap.exists()
                  and 'mmc0: starting card init' in fzsnap.read_text(),
                  'FROZEN snapshots pre-freeze output to frozen.snapshot')
            os.close(fdb)
            subprocess.run([sys.argv[0], 'stop', '--force', str(pa)],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=fenv)
            fz.terminate(); fz.wait()

    # ── Regression: prompt-then-silent → QUIET, not false FROZEN ──────────────
    # The ttyUSB1 case: board reached a shell prompt, a late boot-ish line flipped
    # state back to BOOTING, then it went idle.  Must classify QUIET (healthy idle),
    # not FROZEN — a prompt was seen, so it is not a mid-boot hang.
    if shutil.which('socat'):
        with tempfile.TemporaryDirectory(prefix='sa-qui-') as tf:
            tf = Path(tf)
            pa, pb = tf / 'pa', tf / 'pb'
            qz = subprocess.Popen(
                ['socat', f'pty,raw,echo=0,link={pa}', f'pty,raw,echo=0,link={pb}'],
                stderr=subprocess.DEVNULL)
            dl = time.time() + 3
            while time.time() < dl and not (pa.exists() and pb.exists()):
                time.sleep(0.05)
            qenv = os.environ.copy()
            qenv['SERIAL_AGENT_BASE'] = str(tf / 'state')
            qenv['SERIAL_DEAD_AFTER'] = '1.2'
            subprocess.run([sys.argv[0], 'start', str(pa), '--idle-timeout', '0'],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=qenv)
            qdir = Path(qenv['SERIAL_AGENT_BASE']) / pa.name
            qpid = qdir / 'daemon.pid'
            dl = time.time() + 2
            while time.time() < dl and not qpid.exists():
                time.sleep(0.05)
            qsf = qdir / 'status.json'
            qdb = os.open(str(pb), os.O_RDWR | os.O_NONBLOCK)
            try: os.read(qdb, 256)           # drain the startup-probe CR
            except OSError: pass
            # Reach a shell prompt (sets t_prompt), then emit a late boot line
            # that flips state back to BOOTING, then go silent.
            os.write(qdb, b'\r\nroot@testboard:~# ')
            dl = time.time() + 4
            while time.time() < dl:
                try:
                    if json.loads(qsf.read_text()).get('state') == 'SHELL': break
                except Exception: pass
                time.sleep(0.05)
            os.write(qdb, b'\r\n[    2.345678] mmc0: re-tuning failed\r\n')
            got_quiet = False
            dl = time.time() + 6
            while time.time() < dl:
                try:
                    if json.loads(qsf.read_text()).get('state') == 'QUIET':
                        got_quiet = True; break
                except Exception: pass
                time.sleep(0.1)
            _qst = (json.loads(qsf.read_text()).get('state', '?')
                    if qsf.exists() else '?')
            check(got_quiet,
                  'prompt-then-BOOTING silence → QUIET (not false FROZEN)',
                  f'state={_qst}')
            os.close(qdb)
            subprocess.run([sys.argv[0], 'stop', '--force', str(pa)],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=qenv)
            qz.terminate(); qz.wait()

    total = passed + failed
    print(f'\n{"─"*40}')
    if failed == 0:
        print(f'\033[32mAll {total} tests passed.\033[0m\n')
    else:
        print(f'\033[31m{failed}/{total} tests FAILED.\033[0m\n')
        sys.exit(1)


def cmd_clean(args):
    import shutil
    if args.device:
        device = args.device
        if re.match(r'^\d+$', device): device = f'/dev/ttyUSB{device}'
        ddir = AGENT_BASE / devname(device)
        if ddir.exists():
            pf = ddir / 'daemon.pid'
            if pf.exists():
                try:
                    os.kill(int(pf.read_text().strip()), 0)
                    print(f'Daemon is running for {device} — stop it first (serial-agent stop {device})',
                          file=sys.stderr); sys.exit(1)
                except (OSError, ValueError):
                    pass
            shutil.rmtree(ddir); print(f'Cleaned {ddir}')
        else:
            print(f'Nothing to clean for {device}')
    else:
        if not AGENT_BASE.exists(): print('Nothing to clean'); return
        cleaned = 0
        for d in AGENT_BASE.iterdir():
            if not d.is_dir(): continue
            pf = d / 'daemon.pid'
            if pf.exists():
                try:
                    os.kill(int(pf.read_text().strip()), 0)
                    print(f'  Skipping {d.name} (daemon running)'); continue
                except (OSError, ValueError): pass
            shutil.rmtree(d); print(f'  Cleaned {d.name}'); cleaned += 1
        print(f'Cleaned {cleaned} dir(s)')


# ══════════════════════════════════════════════════════════════════════════════
# Argument parsing
# ══════════════════════════════════════════════════════════════════════════════
def main():
    p = argparse.ArgumentParser(
        prog='serial-agent',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description='Serial console daemon and CLI for automation agents\n'
                    'Run with any subcommand -h for details.')
    sub = p.add_subparsers(dest='cmd', required=True)

    def dev(sp, required=True):
        sp.add_argument('device', **(dict() if required else dict(nargs='?', default=None)),
                        help='/dev/ttyUSBx or just the number e.g. 1')

    # ── Daemon lifecycle ───────────────────────────────────────────────────────
    sp = sub.add_parser('start'); dev(sp); sp.set_defaults(func=cmd_start)
    sp.add_argument('--tcp',  metavar='HOST:PORT',
                    help='Connect via this TCP endpoint (ser2net). Overrides auto-detect.')
    sp.add_argument('--no-ser2net', action='store_true',
                    help='Force direct port access even if ser2net is configured for it')
    sp.add_argument('--baud', type=int, default=115200)
    sp.add_argument('--lines',type=int, default=DEFAULT_LINES)
    sp.add_argument('--idle-timeout', type=int, default=0, dest='idle_timeout',
                    metavar='SECS',
                    help='Auto-stop after SECS idle seconds with no relay clients (0=never, default). '
                         'A non-zero value selects on-demand mode: the daemon only holds the '
                         'port while a relay client is connected, so send/read do not work '
                         'between connections. Use it only when another tool needs the port.')

    sp = sub.add_parser('stop');   dev(sp); sp.set_defaults(func=cmd_stop)
    sp.add_argument('--force', action='store_true',
                    help='Stop even if a human tio session is active')
    sp = sub.add_parser('status'); dev(sp); sp.set_defaults(func=cmd_status)
    sp = sub.add_parser('path');   dev(sp); sp.set_defaults(func=cmd_path)

    # ── Liveness ───────────────────────────────────────────────────────────────
    sp = sub.add_parser('alive'); dev(sp); sp.set_defaults(func=cmd_alive)
    sp.add_argument('--timeout', type=float, default=5.0)

    sp = sub.add_parser('wait-alive'); dev(sp)
    sp.add_argument('--timeout', type=float, default=120.0)
    def _wait_alive(a): a.state = 'SHELL,LOGIN,PASSWORD,UBOOT'; cmd_wait_state(a)
    sp.set_defaults(func=_wait_alive)

    sp = sub.add_parser('wait-state',
        help='Block until state reached (inotifywait if available, else 50ms poll)')
    dev(sp); sp.set_defaults(func=cmd_wait_state)
    sp.add_argument('state', help='e.g. SHELL  or  SHELL,LOGIN')
    sp.add_argument('--timeout', type=float, default=120.0)

    # ── Observation ────────────────────────────────────────────────────────────
    sp = sub.add_parser('read'); dev(sp); sp.set_defaults(func=cmd_read)
    sp.add_argument('--lines', type=int, default=50)
    sp.add_argument('--no-timestamps', action='store_true',
                    help='Strip [HH:MM:SS.mmm] prefix — clean output for text processing')

    sp = sub.add_parser('events'); dev(sp); sp.set_defaults(func=cmd_events)
    sp.add_argument('--lines', type=int, default=20)

    sp = sub.add_parser('tail'); dev(sp); sp.set_defaults(func=cmd_tail)
    sp.add_argument('--lines', '-n', type=int, default=20, metavar='N',
                    help='Backlog lines to print before following (default 20)')
    sp.add_argument('--no-timestamps', action='store_true')
    sp.add_argument('--timeout', type=float, default=0,
                    metavar='SECS', help='Exit after SECS seconds (0=no limit)')

    # ── Sending ────────────────────────────────────────────────────────────────
    sp = sub.add_parser('send',
        help='Send command; --json for structured output, --capture for clean stdout')
    dev(sp); sp.set_defaults(func=cmd_send)
    sp.add_argument('--no-login', action='store_true',
                    help='Do not auto-login when the console is at a login prompt')
    sp.add_argument('--login', action='store_true',
                    help='Also wait through BOOTING for the login prompt '
                         '(auto-login at LOGIN/PASSWORD is already the default)')
    sp.add_argument('command')
    sp.add_argument('--wait', metavar='PATTERN', default=r'[\$#>]\s*$',
                    help='Wait for regex after sending (default: shell prompt)')
    sp.add_argument('--until', dest='wait', metavar='PATTERN',
                    help="Alias for --wait (watch's flag name, accepted here too)")
    sp.add_argument('--no-wait', dest='wait', action='store_const', const=None,
                    help='Fire and forget — do not wait for response')
    sp.add_argument('--timeout', type=float, default=30.0)
    sp.add_argument('--no-wrap', action='store_true',
                    help='Prepend COLUMNS=32767 to prevent board terminal from wrapping output')
    sp.add_argument('--json', action='store_true',
                    help='Return {"output","state","elapsed_ms","exit_code","timed_out"}')
    sp.add_argument('--capture', action='store_true',
                    help='Print only clean stdout (no timestamps, no prompt, no echo)')
    sp.add_argument('--exit-code', action='store_true',
                    help='Append ; echo EXITCODE:$? and parse exit code into result')
    sp.add_argument('--all', action='store_true',
                    help='Send to ALL boards with running daemons (ignores DEVICE)')

    sp = sub.add_parser('expect',
        help='Wait for first of multiple patterns; returns JSON {"matched","output","elapsed_ms"}')
    dev(sp); sp.set_defaults(func=cmd_expect)
    sp.add_argument('pattern', nargs='?', metavar='REGEX',
                    help='Bare pattern; equivalent to --on match=REGEX')
    sp.add_argument('--on', action='append', metavar='KEY=REGEX',
                    help='Pattern to watch for, e.g. --on READY="~#" --on PANIC="Kernel panic"')
    sp.add_argument('--timeout', type=float, default=60.0)

    sp = sub.add_parser('watch',
        help='Real-time push read: return the instant a pattern matches (no polling). '
             'Optionally --send a command first. JSON {"matched","output","elapsed_ms"}')
    dev(sp); sp.set_defaults(func=cmd_watch)
    sp.add_argument('--until', action='append', metavar='REGEX',
                    help='Pattern to stop on (repeatable); any match returns. Keyed u0,u1,...')
    sp.add_argument('--pattern', dest='until', action='append', metavar='REGEX',
                    help='Alias for --until')
    sp.add_argument('--on', action='append', metavar='KEY=REGEX',
                    help='Named pattern (repeatable); the matched KEY is reported')
    sp.add_argument('--send', metavar='CMD',
                    help='Command to send after the read side is open (no early output missed)')
    sp.add_argument('--no-login', action='store_true',
                    help='Do not auto-login when the console is at a login prompt')
    sp.add_argument('--login', action='store_true',
                    help='Also wait through BOOTING for the login prompt '
                         '(auto-login at LOGIN/PASSWORD is already the default)')
    sp.add_argument('--timeout', type=float, default=30.0)
    sp.add_argument('--json', action='store_true', help='(output is JSON regardless)')

    sp = sub.add_parser('wait'); dev(sp); sp.set_defaults(func=cmd_wait)
    sp.add_argument('pattern')
    sp.add_argument('--timeout', type=float, default=30.0)

    # ── Discovery & setup ──────────────────────────────────────────────────────
    sp = sub.add_parser('discover',
        help='JSON list of all ports with ser2net/daemon info; no hardcoding needed')
    sp.set_defaults(func=cmd_discover)
    sp.add_argument('--board',  metavar='PATTERN', help='Filter by label/hostname (regex)')
    sp.add_argument('--serial', metavar='PARTIAL', help='Filter by USB serial (partial match)')
    sp.add_argument('--live',   action='store_true', help='Only LIVE or OPEN ports')

    sp = sub.add_parser('connect',
        help='Discover + start daemon + optionally wait — one call replaces the chain')
    sp.set_defaults(func=cmd_connect)
    sp.add_argument('--board',      metavar='PATTERN')
    sp.add_argument('--serial',     metavar='PARTIAL')
    sp.add_argument('--device',     metavar='DEV',
                    help='Skip discovery; use this port directly')
    sp.add_argument('--wait-shell', action='store_true',
                    help='Block until SHELL/LOGIN/PASSWORD reached')
    sp.add_argument('--setup-terminal', action='store_true',
                    help='After --wait-shell, run stty cols 220 rows 50 to prevent wrapping')
    sp.add_argument('--timeout',    type=float, default=90.0)
    sp.add_argument('--user',       default='root', help='Login username (default: root)')
    sp.add_argument('--password',   default=None,   help='Login password (None=skip if not prompted)')
    sp.add_argument('--json',       action='store_true')

    sp = sub.add_parser('auto-label',
        help='Generate unique labels (hostname-serial6) for unlabeled LIVE boards')
    sp.set_defaults(func=cmd_auto_label)
    sp.add_argument('--dry-run', action='store_true')
    sp.add_argument('--yes', '-y', action='store_true')

    # ── Embedded dev operations ────────────────────────────────────────────────
    sp = sub.add_parser('reboot',
        help='Reboot board, wait for it to return, optionally auto-login')
    dev(sp); sp.set_defaults(func=cmd_reboot)
    sp.add_argument('--cmd',            default=None,
                    help='Reset command (default: reboot, or reset at a U-Boot prompt)')
    sp.add_argument('--timeout',        type=float, default=120.0)
    sp.add_argument('--no-login',       action='store_true', help='Do not auto-login after reboot (a console already at login: is still logged in first, or the reboot would be typed as a username)')
    sp.add_argument('--login',          action='store_true', help='(no-op, auto-login is default)')
    sp.add_argument('--user',           default='root')
    sp.add_argument('--password',       default=None, help='Login password (None=skip if not prompted)')
    sp.add_argument('--setup-terminal', action='store_true', help='Run stty cols 220 after shell')
    sp.add_argument('--quiet',          action='store_true')
    sp.add_argument('--json',           action='store_true')
    sp.add_argument('--capture',        action='store_true',
                    help='After reboot, print a filtered boot digest + write the full boot log')
    sp.add_argument('--capture-file',   metavar='PATH', default=None,
                    help='Where to write the full boot log (default /tmp/serial-connect-boot/<dev>.boot.log)')
    sp.add_argument('--digest-lines',   type=int, default=BOOT_DIGEST_TAIL,
                    help=f'Boot-tail lines always kept in the digest (default {BOOT_DIGEST_TAIL})')

    sp = sub.add_parser('boot',
        help='Capture an externally-triggered boot: wait for prompt/hang, print a '
             'digest + write the full boot log. Does NOT send reboot (use --reset-cmd).')
    dev(sp); sp.set_defaults(func=cmd_boot)
    sp.add_argument('--reset-cmd',      metavar='CMD', default=None,
                    help='Send CMD first to trigger the boot (e.g. reboot); default: wait for external reset')
    sp.add_argument('--timeout',        type=float, default=120.0)
    sp.add_argument('--capture-file',   metavar='PATH', default=None)
    sp.add_argument('--digest-lines',   type=int, default=BOOT_DIGEST_TAIL)
    sp.add_argument('--quiet',          action='store_true')
    sp.add_argument('--json',           action='store_true')

    sp = sub.add_parser('login',
        help='Send username/password and wait for shell prompt')
    dev(sp); sp.set_defaults(func=cmd_login)
    sp.add_argument('--user',     default='root')
    sp.add_argument('--password', default=None)
    sp.add_argument('--timeout',  type=float, default=90.0)

    sp = sub.add_parser('upload',
        help='Upload file: base64 serial (default, no network) or --via-network (wget, ~1MB/s)')
    dev(sp); sp.set_defaults(func=cmd_upload)
    sp.add_argument('hostfile',        help='Local file to upload')
    sp.add_argument('boardpath',       help='Destination path on board (dir/ appends filename)')
    sp.add_argument('--via-network',   action='store_true',
                    help='Use HTTP server + wget (~1MB/s vs ~1KB/s serial); board needs network+wget')
    sp.add_argument('--board-ip',      metavar='IP',
                    help='Board IP (auto-detected if omitted; only for --via-network)')
    sp.add_argument('--http-port',     type=int, default=8877,
                    help='Temporary HTTP server port (default 8877)')
    sp.add_argument('--quiet',         action='store_true')

    sp = sub.add_parser('run',
        help='Execute a shell script on the board (file, - for stdin, or inline text)')
    dev(sp); sp.set_defaults(func=cmd_run)
    sp.add_argument('script',     help='Script file, - for stdin, or inline shell text')
    sp.add_argument('--timeout',  type=float, default=60.0)
    sp.add_argument('--json',     action='store_true')
    sp.add_argument('--capture',  action='store_true')
    sp.add_argument('--no-wrap',  action='store_true')
    sp.add_argument('--no-login', action='store_true',
                    help='Do not auto-login when the console is at a login prompt')
    sp.add_argument('--login', action='store_true',
                    help='Also wait through BOOTING for the login prompt '
                         '(auto-login at LOGIN/PASSWORD is already the default)')

    sp = sub.add_parser('health',
        help='Board health snapshot: state, memory, load, kernel version')
    dev(sp); sp.set_defaults(func=cmd_health)

    sp = sub.add_parser('ser2net-gen',
        help='Generate /etc/ser2net.yaml from serial-boards.conf')
    sp.set_defaults(func=cmd_ser2net_gen)
    sp.add_argument('--start-port', type=int, default=3001)
    sp.add_argument('--output', default='/tmp/ser2net.yaml',
                    help='Output path, or - for stdout')

    sp = sub.add_parser('list', help='List all devices with running daemons')
    sp.set_defaults(func=cmd_list)
    sp.add_argument('--json', action='store_true')
    sp.add_argument('--verbose', '-v', action='store_true',
                    help='Also print each daemon pid, relay and idle-timeout')

    sp = sub.add_parser('attach', help='Launch terminal directly on daemon device (bypasses menu)')
    dev(sp); sp.set_defaults(func=cmd_attach)

    sp = sub.add_parser('test',
        help='Self-test using a virtual pty pair (no real hardware needed)')
    sp.set_defaults(func=cmd_test)
    sp.add_argument('--verbose', '-v', action='store_true',
                    help='Show extra output (daemon stdout, relay details)')

    sp = sub.add_parser('clean'); sp.set_defaults(func=cmd_clean)
    sp.add_argument('device', nargs='?', default=None)

    sp = sub.add_parser('ops', help='Print recent operations from ops.log')
    dev(sp); sp.set_defaults(func=cmd_ops)
    sp.add_argument('--lines', type=int, default=20, help='Number of entries (default 20)')
    sp.add_argument('--json', action='store_true', help='Raw JSON output')

    args = p.parse_args()
    if hasattr(args, 'device') and args.device:
        if re.match(r'^\d+$', args.device):
            args.device = f'/dev/ttyUSB{args.device}'
        elif re.match(r'^tty\w+$', args.device):
            args.device = f'/dev/{args.device}'
    _max_t = int(os.environ.get('SERIAL_AGENT_MAX_TIMEOUT', '0') or '0')
    if _max_t > 0 and hasattr(args, 'timeout'):
        args.timeout = min(args.timeout, float(_max_t))
    args.func(args)


if __name__ == '__main__':
    main()
