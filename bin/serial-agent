#!/usr/bin/env python3
"""
serial-agent — Serial console daemon and CLI for automation agents.

══════════════════════════════════════════════════════════════════════════════
ARCHITECTURE
══════════════════════════════════════════════════════════════════════════════

  ┌─────────────────┐   TCP/direct   ┌──────────────┐   ring buffer
  │  ser2net / port │ ◄─────────────►│serial-daemon │──────────────► ~/var/serial-agent/ttyUSBx/
  └─────────────────┘                └──────┬───────┘   buf.log, status.json, events.log
           ▲                                │ FIFO input
           │ TCP (shared)          ┌────────▼────────┐
           │                       │  serial-agent   │ ← agent CLI
  ┌────────┴────────┐              │                 │
  │  tio.sh / human │              └─────────────────┘
  └─────────────────┘

Storage: ~/var/serial-agent/ (disk, not tmpfs)
         /tmp/serial-agent → ~/var/serial-agent  (symlink, auto-created, clears on reboot)

══════════════════════════════════════════════════════════════════════════════
DYNAMIC DISCOVERY — no hardcoding device paths or board names
══════════════════════════════════════════════════════════════════════════════

  Fields in discover JSON:
    label     User-set in ~/.config/serial-boards.conf — STABLE, USE THIS
    hostname  Board console hostname — fragile (rootfs-dependent)
    serial    USB adapter serial# — unique per physical device

  One-shot setup (no manual chain):
    serial-agent connect --board "$BOARD" --wait-shell

  Full automation example:
    BOARD="${BOARD:?Set BOARD= from serial-boards.conf}"
    serial-agent connect --board "$BOARD" --wait-shell --timeout 90
    result=$(serial-agent send "$dev" "uname -r" --json)
    echo "$result" | python3 -c "import sys,json; print(json.load(sys.stdin)['output'])"

  Label your boards:
    serial-agent auto-label -y     # or manually in ~/.config/serial-boards.conf

══════════════════════════════════════════════════════════════════════════════
STATE MACHINE
══════════════════════════════════════════════════════════════════════════════

  State      Meaning                          Agent action
  ─────────  ───────────────────────────────  ──────────────────────────────
  SHELL      At a shell prompt                ✓ Safe to send; alive confirmed
  RUNNING    Command executing                ✓ Alive; wait for SHELL before sending
  LOGIN      Waiting for username             Send username; wait for Password
  PASSWORD   Waiting for password             Send password; wait for SHELL
  BOOTING    Kernel/init messages             Wait for SHELL (10-60s typical)
  DEAD       No output for >30s              ✗ Board off or hung
  UNKNOWN    Daemon just started              Run alive or connect

  Status JSON fields:
    state            — one of the above
    last_output_ago  — seconds since any byte received
    last_prompt_ago  — seconds since last shell prompt
    prompt_text      — last detected prompt string

══════════════════════════════════════════════════════════════════════════════
MINIMISING TIMEOUTS
══════════════════════════════════════════════════════════════════════════════

  1. Check state first — never send to a RUNNING board
  2. Match --timeout to the command (ls=3s, make=300s)
  3. alive is instant for SHELL/RUNNING with recent output
  4. wait-state uses inotifywait (instant) if available, else 50ms polling
  5. send --json returns clean structured output — no parsing needed
  6. expect handles multi-outcome boards (panic, login, shell) in one call

══════════════════════════════════════════════════════════════════════════════
COMMANDS
══════════════════════════════════════════════════════════════════════════════

  Discovery & setup (no hardcoding):
    auto-label  [--dry-run] [-y]                   generate labels from probe
    discover    [--board PAT] [--serial S] [--live] JSON port list
    connect     [--board PAT] [--serial S] [--wait-shell] [--timeout N] [--json]
    ser2net-gen [--start-port N] [--output FILE]   generate /etc/ser2net.yaml

  Daemon lifecycle:
    start   DEVICE [--tcp HOST:PORT] [--baud N] [--lines N]
    stop    DEVICE
    status  DEVICE                       JSON state + timestamps
    path    DEVICE                       ~/var/serial-agent/ttyUSBx/
    clean   [DEVICE]                     remove stale state dirs

  Observation (no serial traffic):
    read    DEVICE [--lines N] [--no-timestamps]
    events  DEVICE [--lines N]
    tail    DEVICE

  Liveness checks:
    alive      DEVICE [--timeout N]                exit 0=alive; fast cached path
    wait-alive DEVICE [--timeout N]                block until SHELL/LOGIN/PASSWORD
    wait-state DEVICE STATE[,STATE] [--timeout N]  event-driven, inotifywait if available

  Sending:
    send   DEVICE CMD [--wait PAT] [--timeout N]   sends + waits for pattern
           [--json]     structured output {"output","state","elapsed_ms","exit_code"}
           [--capture]  clean stdout only (no timestamps/prompt)
           [--exit-code] append '; echo EXITCODE:$?' and parse result
                        NOTE: commands containing 'exit' terminate the shell
                        before the echo can run — use run DEVICE instead
           [--no-wait]  fire and forget
           [--no-wrap]  prepend COLUMNS=32767 to prevent board terminal wrapping
           [--all]      send to ALL boards with running daemons (ignores DEVICE)
    expect DEVICE --on KEY=REGEX [--on ...] [--timeout N]
           wait for first of multiple patterns; JSON {"matched","output","elapsed_ms"}

══════════════════════════════════════════════════════════════════════════════
EMBEDDED MPU DEVELOPMENT PATTERNS (TI AM62x, AM62D2, etc.)
══════════════════════════════════════════════════════════════════════════════

  ── State machine ─────────────────────────────────────────────────────────
  SHELL    at shell prompt          → send commands
  RUNNING  command executing        → wait-state SHELL (never send to RUNNING)
  UBOOT    U-Boot "=>" prompt       → send U-Boot commands
  LOGIN    "login:" prompt          → serial-agent login DEVICE
  PASSWORD "Password:" prompt       → serial-agent login DEVICE
  BOOTING  kernel log timestamps    → wait-state SHELL --timeout 120
  PANIC    "Kernel panic"/BUG/OOPS  → serial-agent reboot DEVICE
  DEAD     no output 30s            → board off or hung

  ── Speed reference ───────────────────────────────────────────────────────
  Slow (avoid)                    Fast equivalent
  time.sleep(5)                   wait-state DEVICE SHELL --timeout 90
  poll alive every second         wait-state (inotifywait, 0ms latency)
  read buf then grep              send CMD --json (50ms, structured)
  discover+start+wait 3 calls     connect --board X --wait-shell
  reboot + 4 commands             reboot DEVICE --setup-terminal (atomic)

  ── One-time session setup ────────────────────────────────────────────────
  serial-agent auto-label -y                    # label boards from USB serial#
  serial-agent connect --board "$BOARD" \\
      --wait-shell --setup-terminal --timeout 90

  ── Kernel module test cycle ──────────────────────────────────────────────
  serial-agent upload "$DEV" ./my-driver.ko /lib/modules/extra/
  serial-agent send   "$DEV" "modprobe my-driver" --json --exit-code
  serial-agent send   "$DEV" "dmesg | tail -20" --capture --no-wrap
  serial-agent send   "$DEV" "rmmod my-driver" --json --exit-code

  ── DTB overlay test ──────────────────────────────────────────────────────
  serial-agent upload "$DEV" ./k3-am625-sk-audio.dtbo /boot/overlays/
  serial-agent reboot "$DEV" --setup-terminal --timeout 90
  serial-agent send   "$DEV" "ls /proc/device-tree/sound/" --capture

  ── Reboot + verify ───────────────────────────────────────────────────────
  serial-agent reboot "$DEV" --setup-terminal --timeout 120
  serial-agent health "$DEV"
  serial-agent send   "$DEV" "dmesg | grep -ci error" --json --no-wrap

  ── Multi-outcome expect ──────────────────────────────────────────────────
  serial-agent send   "$DEV" "reboot" --no-wait
  serial-agent expect "$DEV" --on "READY=~#" --on "PANIC=Kernel panic" \\
      --on "LOGIN=login:" --timeout 120

  ── Multi-board parallel ──────────────────────────────────────────────────
  serial-agent send --all "uname -r" --json   # all boards simultaneously

  ── U-Boot interaction ────────────────────────────────────────────────────
  serial-agent wait-state "$DEV" UBOOT --timeout 15
  serial-agent send "$DEV" "printenv bootargs" --wait '=>' --timeout 3

  ── run multi-line scripts ────────────────────────────────────────────────
  cat << 'EOF' | serial-agent run "$DEV" - --json --timeout 30
  aplay -l
  arecord -l
  amixer scontents | head -20
  EOF

══════════════════════════════════════════════════════════════════════════════
FILE LAYOUT  ~/var/serial-agent/<devname>/
══════════════════════════════════════════════════════════════════════════════

  daemon.pid   — PID of the running daemon process. Removed on clean exit.
                 Use _daemon_running(device) to check: reads PID and sends
                 kill(pid, 0) — returns False if file missing or PID dead.

  status.json  — Written after every state change and every received byte.
                 Fields: state, last_output_ago, last_prompt_ago,
                 prompt_text, pid, device, baud, via, buf_file, buf_lines.
                 Consumers should read this; never poll buf.log directly.

  buf.log      — Ring buffer of the last N lines (default 500) from the
                 board. Each line is prepended with a [HH:MM:SS.mmm]
                 timestamp. Partial lines are buffered across os.read()
                 calls so split bytes never produce corrupt entries.

  events.log   — State-transition log, max MAX_EVENTS (200) lines.
                 Format: [HH:MM:SS.mmm] PREV → NEW  <prompt_text>
                 Used by _wait_state() via inotifywait for zero-latency
                 wakeup when a target state is reached.

  input.fifo   — Named FIFO for sending commands to the daemon. The daemon's
                 _writer thread holds it open for reading; senders open it
                 O_WRONLY|O_NONBLOCK (fails with ENXIO if no reader yet).
                 Each write is a complete shell command + newline (\n).
                 The FIFO is created once at daemon start and persists until
                 the next start (cleared by cmd_start to prevent stale data).

  daemon.log   — stdout/stderr of the daemon process (append mode).
                 Contains connect/disconnect events and error messages.

══════════════════════════════════════════════════════════════════════════════
DESIGN NOTES
══════════════════════════════════════════════════════════════════════════════

  Serial device flags (O_RDWR | O_NOCTTY | O_NONBLOCK):
    O_NOCTTY   — prevent the device becoming the controlling terminal.
    O_NONBLOCK — open returns immediately even if DCD is not asserted;
                 os.read() raises EAGAIN (errno 11) instead of blocking
                 when no data is available. The daemon's select() loop
                 handles EAGAIN as a spurious wakeup and continues.

  FIFO protocol:
    The _writer thread opens input.fifo with blocking O_RDONLY, which
    blocks until a sender opens the write end. Senders use O_NONBLOCK so
    they never block waiting for the daemon — they fail fast (ENXIO) if
    the daemon isn't ready yet and retry up to 20×100ms before giving up.

  Output capture baseline:
    _send_impl() snaps buf.log's byte offset to the last newline BEFORE
    writing to the FIFO. After the command completes, only bytes after that
    offset are read back — this prevents pre-command output from polluting
    the captured result, even if the board was still printing when the
    command was sent.

  State machine priority:
    _update_state() checks in this order: PANIC > UBOOT > LOGIN >
    PASSWORD > SHELL > BOOTING > DEAD > RUNNING. Earlier states are
    authoritative — a kernel panic in the last 500 chars always wins,
    even if there's also a shell prompt on another line.

  wait-state inotifywait path:
    If inotifywait is installed, _wait_state() watches events.log for
    new writes rather than polling on a timer. This gives sub-millisecond
    wakeup latency when a state transition happens, vs the 50-200ms
    polling interval. The daemon check (_daemon_running) runs once per
    inotify cycle (≤10s wake interval) to detect daemon death early.

  EXIT CODES used by CLI commands:
    0  — success (state reached, command completed, board alive)
    1  — failure (timeout, daemon died, board unreachable, command failed)
    2  — usage error (bad arguments, missing device)
"""

import argparse, errno, json, os, re, select, signal, socket, sys, termios, time
from datetime import datetime
from pathlib import Path
from threading import Thread, Event, Lock

# ── Storage ────────────────────────────────────────────────────────────────────
_SCRIPT_DIR = Path(__file__).resolve().parent
_REAL_BASE = Path.home() / 'var' / 'serial-agent'
_TMP_LINK  = Path('/tmp/serial-agent')
# SERIAL_AGENT_DIR overrides the state directory (used by 'serial-agent test'
# to redirect state to a temp dir so tests don't pollute ~/var/serial-agent).
AGENT_BASE = Path(os.environ.get('SERIAL_AGENT_DIR',
                  os.environ.get('SERIAL_AGENT_BASE', str(_REAL_BASE))))

def _resolve_board_cfg() -> Path:
    """Return the writable label config. Matches serial-common.sh two-layer model:
    Global install (script in /usr/... or /opt/...): XDG user conf ~/.config/serial-connect/boards.conf
    Local install (script in ~/...): script-dir/serial-boards.conf"""
    if env := os.environ.get('BOARD_CFG'):
        return Path(env)
    is_global = str(_SCRIPT_DIR).startswith(('/usr/', '/opt/'))
    if is_global:
        xdg = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config'))
        return xdg / 'serial-connect' / 'boards.conf'
    return _SCRIPT_DIR / 'serial-boards.conf'


# ── Tunables ───────────────────────────────────────────────────────────────────
DEFAULT_LINES = 500      # buf.log ring buffer depth (lines)
MAX_EVENTS    = 200      # events.log rotation threshold
DEAD_AFTER    = 30.0     # seconds of silence before state → DEAD
RUNNING_AFTER = 3.0      # seconds of output without a prompt → state = RUNNING
EXITCODE_TAG  = 'SERIAL_EXITCODE'  # sentinel prefix injected by --exit-code

# ── Patterns ───────────────────────────────────────────────────────────────────
RE_SHELL    = re.compile(r'[\$#>]\s*$')
RE_SHELL2   = re.compile(r'\w[\w.\-]*@[\w.\-]+[:#~/][^\n]*[\$#>]\s*$')
RE_LOGIN    = re.compile(r'(login|Username)\s*:\s*$', re.I)
RE_PASSWORD = re.compile(r'(Password|passwd)\s*:\s*$', re.I)
RE_BOOT     = re.compile(r'\[\s*\d+\.\d{3,6}\]')
RE_UBOOT    = re.compile(r'^(=>|u-boot[#>])\s*$', re.I)   # U-Boot prompt
RE_PANIC    = re.compile(r'Kernel panic|BUG:|OOPS:|Unable to handle kernel')
RE_ANSI     = re.compile(r'\x1b(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])')
RE_TIMESTAMP= re.compile(r'^\[\d{2}:\d{2}:\d{2}\.\d+\] ')
RE_EXITCODE = re.compile(rf'^{EXITCODE_TAG}:(\d+)\s*$')


def _strip_ansi(text: str) -> str:
    return RE_ANSI.sub('', text)

def _strip_timestamps(lines: list) -> list:
    return [RE_TIMESTAMP.sub('', l) for l in lines]

def _clean_output(raw_lines: list, sent_cmd: str = '') -> tuple:
    """Strip noise from captured board output and extract the exit code.

    Processing steps (in order):
      1. Strip [HH:MM:SS.mmm] timestamp prefix from each line.
      2. Strip ANSI escape codes (colour, cursor movement, etc.).
      3. Strip bare CR characters (terminal line wrapping artefacts).
      4. Remove command echo. Two forms handled:
           Form 1 — board echoes 'prompt + command' on one line:
             e.g. 'root@board:~# uname -r' → first line removed.
           Form 2 — board echoes the bare command, possibly wrapped:
             e.g. 'uname', '-r' across two lines → those lines consumed.
      5. Strip lines matching SERIAL_EXITCODE:<N> and record the value.
      6. Remove trailing shell prompt line(s).
      7. Remove trailing blank lines.

    Args:
        raw_lines:  Lines from buf.log (with timestamps), as a list.
        sent_cmd:   The exact command that was sent (used for echo removal).
                    Pass '' to skip echo removal.

    Returns:
        (clean_text: str, exit_code: int | None)
        clean_text is newline-joined; exit_code is None if not found.
    """
    lines = _strip_timestamps(raw_lines)
    lines = [_strip_ansi(l) for l in lines]
    lines = [l.replace('\r', '') for l in lines]   # remove all CRs (mid-line wrapping)

    # Remove command echo. Three forms handled:
    #   1a. "prompt + command" on one line (board echoes with prompt, short cmd)
    #   1b. Wrapped: "prompt + start_of_cmd" then bare continuation lines
    #       (board's terminal is narrow, so long cmds wrap at terminal width)
    #   2.  Bare command lines only (no prompt — some board configs)
    # Note: --no-wrap sets COLUMNS=32767 env var for the executed command's
    # output, but the terminal echo of typed characters still wraps at the
    # board's tty cols setting.  Form 1b handles that wrapping.
    cmd_stripped = sent_cmd.strip()
    if cmd_stripped and lines:
        first = lines[0].strip()
        if first.endswith(cmd_stripped) and len(first) > len(cmd_stripped):
            # Form 1a: entire command fits on one line after the prompt
            lines = lines[1:]
        else:
            # Form 1b: check if first line starts with "prompt + beginning of cmd"
            # by finding the longest suffix of first that is a prefix of cmd_stripped
            skip = 0
            matched = False
            for cut in range(len(first) + 1):
                tail = first[cut:]
                if tail and cmd_stripped.startswith(tail):
                    # first[cut:] is the start of the command echo
                    consumed = tail
                    skip = 1
                    if consumed == cmd_stripped:
                        matched = True
                        break
                    # Consume continuation lines until command is fully assembled
                    for line in lines[1:]:
                        chunk = line.strip()
                        if not chunk:
                            break
                        test = consumed + chunk
                        if test == cmd_stripped:
                            skip += 1; consumed = test; matched = True; break
                        elif cmd_stripped.startswith(test):
                            skip += 1; consumed = test
                        else:
                            break
                    break
            if not matched:
                # Form 2: bare command, possibly wrapped, no prompt prefix
                consumed = ''
                skip = 0
                for line in lines:
                    chunk = line.strip()
                    if not chunk:
                        break
                    test = consumed + chunk
                    if cmd_stripped.startswith(test):
                        consumed = test
                        skip += 1
                        if consumed == cmd_stripped:
                            break
                    else:
                        break
            lines = lines[skip:]

    # Extract exit code if present
    exit_code = None
    cleaned = []
    for l in lines:
        m = RE_EXITCODE.match(l.strip())
        if m:
            exit_code = int(m.group(1))
        else:
            cleaned.append(l)

    # Remove trailing prompt line(s)
    while cleaned and (RE_SHELL.search(cleaned[-1]) or RE_SHELL2.search(cleaned[-1])):
        cleaned.pop()

    # Remove trailing blank lines
    while cleaned and not cleaned[-1].strip():
        cleaned.pop()

    return '\n'.join(cleaned), exit_code


# ── Helpers ────────────────────────────────────────────────────────────────────
def devname(device: str) -> str:
    return Path(device).name

def devdir(device: str) -> Path:
    d = AGENT_BASE / devname(device)
    d.mkdir(parents=True, exist_ok=True)
    return d

def ensure_symlink():
    """Keep /tmp/serial-agent pointing to the current user's storage.
    If it points elsewhere (another user created it first), update it."""
    try:
        _REAL_BASE.mkdir(parents=True, exist_ok=True)
        if _TMP_LINK.is_symlink():
            if _TMP_LINK.resolve() != _REAL_BASE.resolve():
                _TMP_LINK.unlink()
                _TMP_LINK.symlink_to(_REAL_BASE)
        elif _TMP_LINK.is_dir():
            try:
                _TMP_LINK.rmdir()          # only removes if empty
                _TMP_LINK.symlink_to(_REAL_BASE)
            except OSError:
                pass                       # non-empty or permission denied; leave it
        elif not _TMP_LINK.exists():
            _TMP_LINK.symlink_to(_REAL_BASE)
    except OSError:
        pass

def now() -> float:
    return time.monotonic()

def ts() -> str:
    return datetime.now().strftime('%H:%M:%S.%f')[:-3]


# ══════════════════════════════════════════════════════════════════════════════
# Daemon
# ══════════════════════════════════════════════════════════════════════════════
class Daemon:
    """Serial console daemon.

    Runs as a double-forked background process (see cmd_start). Maintains a
    persistent connection to a serial device (or ser2net TCP relay), writes
    timestamped output to buf.log, tracks the board state machine, and
    accepts commands via a named FIFO (input.fifo).

    Consumers interact through the filesystem:
      - Read status.json for current state and timestamps.
      - Read buf.log for recent board output.
      - Write to input.fifo (via CLI 'send') to send commands to the board.
      - Watch events.log for state transitions (via CLI 'wait-state').
    """

    def __init__(self, device, tcp, baud, lines, idle_timeout=0):
        self.device       = device
        self.tcp          = None   # relay address; set by _start_relay_if_direct
        self.baud         = baud
        self.maxlines     = lines
        self.idle_timeout = idle_timeout   # auto-stop when no relay clients for this many seconds (0=never)
        self.ddir     = devdir(device)
        self.buf_file    = self.ddir / 'buf.log'
        self.status_file = self.ddir / 'status.json'
        self.fifo_file   = self.ddir / 'input.fifo'
        self.pid_file    = self.ddir / 'daemon.pid'
        self.events_file = self.ddir / 'events.log'

        self.buf_lines: list = []
        self._partial    = ''   # incomplete line between reads
        self.state        = 'UNKNOWN'
        self._prev_state  = 'UNKNOWN'
        self.t_output     = 0.0
        self.t_prompt     = 0.0
        self.prompt_text  = ''
        self._stop        = Event()
        self._sock        = None
        self._fd          = None
        self._given_tcp      = tcp
        self._relay_clients: list = []
        self._relay_lock     = Lock()
        self._t_last_client  = 0.0   # monotonic time of last relay client connect/disconnect

    def _connect(self):
        """Open the serial device or TCP connection and configure terminal settings.

        Direct serial path:
          - O_RDWR|O_NOCTTY|O_NONBLOCK: open without blocking on DCD, without
            becoming the controlling terminal.
          - Raw mode (no ICANON, no ECHO): bytes pass through unprocessed.
          - ICRNL disabled: CR is not translated to NL, preserving raw framing.
          - VMIN=0, VTIME=1: non-blocking read with 100ms kernel timeout.
          - TIOCSWINSZ cols=220: tells the board's terminal driver the window is
            wide so commands and output don't wrap mid-line in the buffer.
          - ~HUPCL: prevents DTR from dropping when the fd is closed, which
            would reset the board.

        Returns the file descriptor (int) of the opened connection.
        Raises OSError on failure (caught by run()'s reconnect loop).
        """
        if self._given_tcp:
            host, port = self._given_tcp
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.connect((host, port))
            self._sock = s
            return s.fileno()
        else:
            fd = os.open(self.device, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
            bconst = {
                9600: termios.B9600,   19200: termios.B19200,  38400: termios.B38400,
                57600: termios.B57600, 115200: termios.B115200, 230400: termios.B230400,
                460800: termios.B460800, 921600: termios.B921600,
                1000000: getattr(termios, 'B1000000', termios.B115200),
                1500000: getattr(termios, 'B1500000', termios.B115200),
            }.get(self.baud, termios.B115200)
            saved = termios.tcgetattr(fd)
            attrs = list(saved)
            # Full raw-mode setup (cfmakeraw equivalent + daemon-specific flags).
            # The previous approach only cleared a subset of flags, leaving IXON/IXOFF
            # (XON/XOFF flow control), OPOST (output processing), ISIG, and IEXTEN
            # active — any 0x11/0x13 byte from the board would pause/resume output.
            _IXOFF   = getattr(termios, 'IXOFF',   0)
            _IXANY   = getattr(termios, 'IXANY',   0)
            _ECHOK   = getattr(termios, 'ECHOK',   0)
            _ECHONL  = getattr(termios, 'ECHONL',  0)
            _CRTSCTS = getattr(termios, 'CRTSCTS', 0)
            # c_iflag: disable all input translations and flow control
            attrs[0] &= ~(termios.IGNBRK | termios.BRKINT | termios.PARMRK |
                          termios.ISTRIP | termios.INLCR  | termios.IGNCR  |
                          termios.ICRNL  | termios.IXON   | _IXOFF         | _IXANY)
            # c_oflag: disable output processing (NL→CRNL etc.)
            attrs[1] &= ~termios.OPOST
            # c_cflag: 8n1, no hardware flow control, ignore modem lines, no DTR drop
            attrs[2] &= ~(termios.CSIZE | termios.PARENB | _CRTSCTS | termios.HUPCL)
            attrs[2] |=  termios.CS8 | termios.CLOCAL | termios.CREAD
            # c_lflag: raw input — no echo, no canonical, no signals, no extensions
            attrs[3] &= ~(termios.ECHO | _ECHOK | _ECHONL | termios.ECHOE |
                          termios.ICANON | termios.ISIG | termios.IEXTEN)
            # Baud rate
            attrs[4] = bconst; attrs[5] = bconst
            # VMIN=0 VTIME=1: select() drives the wait; os.read() returns immediately
            # or after a 100ms kernel timeout if a spurious wakeup delivered no data.
            vchars = [(b[0] if isinstance(b, bytes) else b) for b in attrs[6]]
            vchars[termios.VMIN] = 0; vchars[termios.VTIME] = 1
            attrs[6] = vchars   # list, NOT bytes — tcsetattr requires list
            termios.tcsetattr(fd, termios.TCSAFLUSH, attrs)
            # Set a wide terminal window so the board doesn't wrap output mid-line
            import struct, fcntl
            try:
                winsize = struct.pack('HHHH', 50, 220, 0, 0)  # rows=50, cols=220
                fcntl.ioctl(fd, termios.TIOCSWINSZ, winsize)
            except Exception:
                pass
            self._fd = fd
            return fd

    def _send_raw(self, data: bytes):
        if self._sock:
            self._sock.sendall(data)
        elif self._fd is not None:
            os.write(self._fd, data)

    def _update_state(self, text: str):
        """Update the board state machine from a chunk of received text.

        Checks are ordered by priority — earlier matches win:
          PANIC > UBOOT > LOGIN > PASSWORD > SHELL > BOOTING > DEAD > RUNNING

        PANIC always wins because a kernel oops in a flood of output should
        not be obscured by a shell prompt on another line.

        BOOTING is checked on the tail of the text (last 300 chars) to handle
        boards that print a shell prompt at the login screen while the kernel
        log is still flowing — LOGIN and SHELL checks see the last line, while
        BOOTING looks at the recent tail.

        State changes are written to events.log and status.json. Events are
        read by _wait_state() via inotifywait.
        """
        t = now()
        # Strip ANSI codes before pattern matching (handles colored prompts)
        clean = _strip_ansi(text)
        lines = [l for l in clean.replace('\r', '').split('\n') if l.strip()]
        last = lines[-1] if lines else ''

        prev = self.state
        if RE_PANIC.search(clean[-500:]):
            self.state = 'PANIC'             # kernel panic / oops — board needs reboot
        elif RE_UBOOT.search(last):
            self.state = 'UBOOT'             # U-Boot interactive prompt
            self.t_prompt = t
            self.prompt_text = last.strip()
        elif RE_LOGIN.search(last):
            self.state = 'LOGIN'
        elif RE_PASSWORD.search(last):
            self.state = 'PASSWORD'
        elif RE_SHELL2.search(last) or (RE_SHELL.search(last) and len(last) >= 2):
            self.state = 'SHELL'
            self.t_prompt = t
            self.prompt_text = last.strip()
        elif RE_BOOT.search(clean[-300:]):
            self.state = 'BOOTING'
        # (DEAD is detected only via the idle-timeout in run(), not here, since
        # _update_state is only called when data arrives — t_output was just set.)
        elif (self.t_output > self.t_prompt
              and t - self.t_output > 0.2
              and t - self.t_prompt > RUNNING_AFTER):
            self.state = 'RUNNING'

        if self.state != self._prev_state:
            detail = f'  {self.prompt_text}' if self.state == 'SHELL' else ''
            entry = f'[{ts()}] {self._prev_state} → {self.state}{detail}'
            # Rotated append: keep last MAX_EVENTS lines
            try:
                existing = (self.events_file.read_text().splitlines()
                            if self.events_file.exists() else [])
                existing.append(entry)
                if len(existing) > MAX_EVENTS:
                    existing = existing[-MAX_EVENTS:]
                _etmp = self.events_file.with_suffix('.tmp')
                _etmp.write_text('\n'.join(existing) + '\n')
                _etmp.rename(self.events_file)
            except OSError:
                pass
            self._prev_state = self.state

    def _append(self, data: bytes):
        """Process a raw bytes chunk from the serial device.

        Decodes UTF-8 (replacing bad bytes), updates t_output and state,
        then assembles complete lines. Partial lines are held in self._partial
        and prepended to the next read — this prevents os.read() boundary
        splits (e.g. "6.18.13" + "-dirty\\n") from creating two log entries.

        Lines are timestamped and appended to buf_lines (ring buffer capped at
        self.maxlines). The full ring is rewritten to buf.log on every call so
        readers always see a consistent snapshot.
        """
        if self._relay_clients:
            with self._relay_lock:
                dead = []
                for c in list(self._relay_clients):
                    try:
                        c.sendall(data)
                    except OSError:
                        dead.append(c)
                for c in dead:
                    try:
                        self._relay_clients.remove(c)
                    except ValueError:
                        pass
        text = data.decode('utf-8', errors='replace')
        self.t_output = now()
        self._update_state(text)
        # Prepend any partial line buffered from the previous read to avoid
        # splitting lines across os.read() boundaries (e.g. "6.18.13" + "-dirty\n")
        full = self._partial + text
        parts = re.split(r'\r?\n', full)
        # If text didn't end with \n, the last element is an incomplete line
        if full and not full.endswith('\n'):
            self._partial = parts[-1]
            parts = parts[:-1]
        else:
            self._partial = ''
        for raw in parts:
            line = raw.strip('\r')
            if line:
                self.buf_lines.append(f'[{ts()}] {line}')
        if len(self.buf_lines) > self.maxlines:
            self.buf_lines = self.buf_lines[-self.maxlines:]
        try:
            _btmp = self.buf_file.with_suffix('.tmp')
            _btmp.write_text('\n'.join(self.buf_lines) + '\n')
            _btmp.rename(self.buf_file)
        except OSError:
            pass
        self._write_status()

    def _write_status(self):
        t = now()
        s = {
            'state':           self.state,
            'last_output_ago': round(t - self.t_output, 1) if self.t_output else None,
            'last_prompt_ago': round(t - self.t_prompt, 1) if self.t_prompt else None,
            'prompt_text':     self.prompt_text,
            'pid':             os.getpid(),
            'device':          self.device,
            'baud':            self.baud,
            'via':             (f'tcp:{self._given_tcp[0]}:{self._given_tcp[1]}'
                               if self._given_tcp else 'direct'),
            'relay':           (f'{self.tcp[0]}:{self.tcp[1]}' if self.tcp else None),
            'buf_file':        str(self.buf_file),
            'buf_lines':       len(self.buf_lines),
        }
        try:
            self.status_file.write_text(json.dumps(s, indent=2))
        except OSError:
            pass

    def _writer(self):
        """Daemon thread: relay commands from input.fifo to the serial device.

        Opens the FIFO for reading in blocking mode — this blocks until a
        sender opens the write end (i.e. until 'serial-agent send' runs).
        Once open, reads 256-byte chunks and writes them to the serial device.
        When the writer closes its end, f.read() returns b'' (EOF) and the
        loop restarts, blocking again for the next sender.

        Senders use O_WRONLY|O_NONBLOCK so they never block — they only
        succeed if this thread already has the FIFO open for reading.

        This is a daemon thread (daemon=True) so it is automatically killed
        when the main process exits — no explicit shutdown coordination needed.
        """
        while not self._stop.is_set():
            try:
                with open(self.fifo_file, 'rb') as f:
                    while not self._stop.is_set():
                        data = f.read(256)
                        if not data:
                            break
                        self._send_raw(data)
            except OSError:
                time.sleep(0.1)

    def _start_relay_if_direct(self):
        """Bind a loopback TCP relay so tio/socat can share the port.

        Always started, even when ser2net is the backend (_given_tcp set).
        The relay is the client-facing endpoint: serial-connect/socat always
        connect here.  This prevents socat from connecting directly to the
        ser2net port, which would trigger ser2net kickolduser and kick the
        daemon's own connection off.
        """
        srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        base = _relay_base_port()
        if base:
            for _p in range(base, base + 256):
                try: srv.bind(('127.0.0.1', _p)); break
                except OSError: continue
            else:
                srv.bind(('127.0.0.1', 0))   # fallback to ephemeral
        else:
            srv.bind(('127.0.0.1', 0))
        port = srv.getsockname()[1]
        # Only start idle timer at relay creation for on-demand mode (direct device).
        # For ser2net always-on mode (_given_tcp set), leave _t_last_client at 0.0
        # so the always-on idle check never fires until an actual relay client has
        # connected and disconnected — preventing the daemon from auto-stopping when
        # nobody has ever used the relay.
        if not self._given_tcp:
            self._t_last_client = now()
        srv.listen(8)
        self.tcp = ('127.0.0.1', port)
        self._write_status()
        Thread(target=self._relay_accept_loop, args=(srv,), daemon=True).start()

    def _relay_accept_loop(self, srv):
        srv.settimeout(1.0)
        while not self._stop.is_set():
            try:
                conn, _ = srv.accept()
            except socket.timeout:
                continue
            except OSError:
                break
            with self._relay_lock:
                self._relay_clients.append(conn)
                self._t_last_client = now()
            Thread(target=self._relay_client_reader, args=(conn,), daemon=True).start()
        srv.close()

    def _relay_client_reader(self, conn):
        try:
            while not self._stop.is_set():
                data = conn.recv(4096)
                if not data:
                    break
                self._send_raw(data)
        except OSError:
            pass
        finally:
            with self._relay_lock:
                try:
                    self._relay_clients.remove(conn)
                except ValueError:
                    pass
                self._t_last_client = now()   # restart idle timer when client disconnects
            try:
                conn.close()
            except OSError:
                pass

    def run(self):
        """Main daemon loop. Runs after double-fork in cmd_start.

        Lifecycle:
          1. Write PID file and initial status.json (UNKNOWN state).
          2. Create input.fifo (if missing).
          3. Install SIGTERM/SIGINT handlers that set self._stop.
          4. Start _writer thread (daemon=True).
          5. Outer loop: call _connect(), run inner select loop, reconnect on error.

        Reconnect backoff starts at 1s, doubles on each failure up to 30s.
        Backoff resets to 1s on each successful connection.

        Startup probe: if the board sends nothing within 0.5s of connect,
        the daemon sends a bare CR (\r). This wakes an idle board at a shell
        prompt so the state transitions from UNKNOWN to SHELL immediately,
        without requiring the user to send a command first. The probe is
        skipped if the board is already talking (t_output is set) to avoid
        interrupting U-Boot autoboot.

        EAGAIN handling: os.read() on an O_NONBLOCK fd can raise EAGAIN even
        after select() reports the fd readable (spurious wakeup from a modem
        control line change). This is caught and treated as 'no data yet' —
        the select loop continues rather than treating it as a disconnect.
        """
        self.pid_file.write_text(str(os.getpid()))
        self._write_status()

        # Always-on (idle_timeout=0) vs on-demand (idle_timeout>0) modes.
        # Always-on: hold physical fd + lock file continuously.  Port always shows
        # OPEN in serial-discover; startup probe fires at t=0.5s; _send_raw works
        # immediately because _fd is never None.  serial-connect uses this mode.
        # On-demand: release fd when no relay client is connected.  _send_raw is a
        # silent no-op while parked (_fd=None), which causes send() callers to
        # time out with no error.  Only useful for short-lived automation sessions
        # where holding the port would block other tools; set --idle-timeout N.
        on_demand = self.idle_timeout > 0 and not self._given_tcp
        _lf_path = Path('/tmp/serial-connect-locks') / Path(self.device).name
        if not on_demand:
            try:
                _lf_path.parent.mkdir(mode=0o1777, exist_ok=True)
                os.chmod(_lf_path.parent, 0o1777)
                _lf_path.write_text(f'{os.getpid()}\n{os.environ.get("USER", "")}\n')
                self._lock_file = _lf_path
            except OSError:
                self._lock_file = None
        else:
            self._lock_file = None   # acquired/released dynamically with fd

        if not self.fifo_file.exists():
            os.mkfifo(self.fifo_file)
        signal.signal(signal.SIGTERM, lambda *_: self._stop.set())
        signal.signal(signal.SIGINT,  lambda *_: self._stop.set())
        Thread(target=self._writer, daemon=True).start()
        self._start_relay_if_direct()

        backoff = 1.0
        while not self._stop.is_set():
            # On-demand: park until a relay client connects.
            if on_demand and not self._relay_clients:
                if (self._t_last_client > 0
                        and now() - self._t_last_client > self.idle_timeout
                        and not _human_session_active(self.device)):
                    print(f'[serial-agent] idle {self.idle_timeout}s — auto-stopping', flush=True)
                    self._stop.set()
                    break
                time.sleep(0.1)
                continue

            # On-demand: acquire lock file now that we're about to hold the fd.
            if on_demand and self._lock_file is None:
                try:
                    _lf_path.parent.mkdir(mode=0o1777, exist_ok=True)
                    os.chmod(_lf_path.parent, 0o1777)
                    _lf_path.write_text(f'{os.getpid()}\n{os.environ.get("USER", "")}\n')
                    self._lock_file = _lf_path
                except OSError:
                    pass

            _clients_gone = False
            try:
                rfd = self._connect()
                backoff = 1.0
                t_connected = now()
                _probe_sent = False
                print(f'[serial-agent] {self.device} connected '
                      f'via {"ser2net" if self._given_tcp else "direct"}', flush=True)
                while not self._stop.is_set():
                    # On-demand: release device when all relay clients have left.
                    if on_demand and not self._relay_clients:
                        _clients_gone = True
                        break
                    r, _, _ = select.select([rfd], [], [], 0.5)
                    if r:
                        try:
                            data = os.read(rfd, 4096)
                        except OSError as _e:
                            if _e.errno == errno.EAGAIN:
                                continue   # spurious wakeup — no data yet
                            raise
                        if not data:
                            # EOF — device or TCP peer closed the connection.
                            # Without a sleep here the outer loop spins at full speed
                            # re-connecting and immediately getting EOF again.
                            if not _clients_gone and not self._stop.is_set():
                                print(f'[serial-agent] {self.device} disconnected (EOF) '
                                      f'— retry in {backoff}s', flush=True)
                                if self.state != 'DEAD':
                                    _prev = self._prev_state
                                    self.state = 'DEAD'
                                    self._prev_state = 'DEAD'
                                    self._write_status()
                                    _entry = f'[{ts()}] {_prev} → DEAD  (eof)'
                                    try:
                                        _ex = (self.events_file.read_text().splitlines()
                                               if self.events_file.exists() else [])
                                        _ex.append(_entry)
                                        if len(_ex) > MAX_EVENTS:
                                            _ex = _ex[-MAX_EVENTS:]
                                        _etmp = self.events_file.with_suffix('.tmp')
                                        _etmp.write_text('\n'.join(_ex) + '\n')
                                        _etmp.rename(self.events_file)
                                    except OSError:
                                        pass
                                time.sleep(backoff)
                                backoff = min(backoff * 2, 30)
                            break
                        self._append(data)
                    else:
                        # Startup probe: one bare CR sent 0.5 s after connect if the
                        # board has been silent.  Wakes an idle board at a shell prompt
                        # so state transitions UNKNOWN → SHELL without user input.
                        # The probe is intentionally NOT suppressed by an active human
                        # session — a single CR is harmless and necessary for state
                        # bootstrap.  serial-connect starts the daemon BEFORE writing
                        # human_session (via _lock_acquire), so the probe fires first.
                        if (not _probe_sent and self.state == 'UNKNOWN'
                                and not self.t_output
                                and now() - t_connected > 0.5):
                            self._send_raw(b'\r')
                            _probe_sent = True
                        if self.t_output and now() - self.t_output > DEAD_AFTER:
                            if self.state != 'DEAD':
                                _prev = self._prev_state
                                self.state = 'DEAD'
                                self._prev_state = 'DEAD'
                                self._write_status()
                                # Write to events.log so _wait_state can detect DEAD
                                # via inotifywait — without this, DEAD is only in
                                # status.json and _wait_state's loop never sees it.
                                _entry = f'[{ts()}] {_prev} → DEAD'
                                try:
                                    _existing = (self.events_file.read_text().splitlines()
                                                 if self.events_file.exists() else [])
                                    _existing.append(_entry)
                                    if len(_existing) > MAX_EVENTS:
                                        _existing = _existing[-MAX_EVENTS:]
                                    _etmp = self.events_file.with_suffix('.tmp')
                                    _etmp.write_text('\n'.join(_existing) + '\n')
                                    _etmp.rename(self.events_file)
                                except OSError:
                                    pass
                        # Always-on idle-stop (on-demand uses the outer-loop check).
                        if (not on_demand and self.idle_timeout > 0
                                and not self._relay_clients
                                and self._t_last_client > 0
                                and now() - self._t_last_client > self.idle_timeout
                                and not _human_session_active(self.device)):
                            print(f'[serial-agent] idle {self.idle_timeout}s — auto-stopping', flush=True)
                            self._stop.set()
            except (ConnectionRefusedError, OSError) as e:
                if not _clients_gone:
                    print(f'[serial-agent] connect error: {e} — retry in {backoff}s', flush=True)
                    _prev = self._prev_state
                    self.state = 'DEAD'
                    self._prev_state = 'DEAD'
                    self._write_status()
                    _entry = f'[{ts()}] {_prev} → DEAD  (connect error)'
                    try:
                        _ex = (self.events_file.read_text().splitlines()
                               if self.events_file.exists() else [])
                        _ex.append(_entry)
                        if len(_ex) > MAX_EVENTS: _ex = _ex[-MAX_EVENTS:]
                        _etmp = self.events_file.with_suffix('.tmp')
                        _etmp.write_text('\n'.join(_ex) + '\n')
                        _etmp.rename(self.events_file)
                    except OSError:
                        pass
                    time.sleep(backoff)
                    backoff = min(backoff * 2, 30)
            finally:
                if self._sock:
                    try: self._sock.close()
                    except: pass
                    self._sock = None
                if self._fd is not None:
                    try: os.close(self._fd)
                    except: pass
                    self._fd = None
                if on_demand:
                    # Release lock file — port is no longer held by this daemon.
                    if self._lock_file is not None:
                        try: self._lock_file.unlink(missing_ok=True)
                        except OSError: pass
                        self._lock_file = None
                    if _clients_gone:
                        self.state = 'UNKNOWN'
                        self._write_status()

        self.pid_file.unlink(missing_ok=True)
        if getattr(self, '_lock_file', None):
            try: self._lock_file.unlink(missing_ok=True)
            except OSError: pass
        print('[serial-agent] stopped', flush=True)


# ══════════════════════════════════════════════════════════════════════════════
# Utilities
# ══════════════════════════════════════════════════════════════════════════════
def _relay_base_port() -> int:
    """Return RELAY_BASE_PORT from serial-boards.conf, or 0 (ephemeral) if unset."""
    try:
        for line in _boards_conf().read_text().splitlines():
            line = line.split('#')[0].strip()
            if line.upper().startswith('RELAY_BASE_PORT'):
                _, _, val = line.partition('=')
                port = int(val.strip())
                if 1024 <= port <= 64999:
                    return port
    except Exception:
        pass
    return 0


def find_ser2net_port(device: str):
    for cfg in ('/etc/ser2net.yaml', '/etc/ser2net.conf'):
        try:
            text = Path(cfg).read_text()
        except OSError:
            continue
        lines = text.split('\n')
        for i, line in enumerate(lines):
            if device in line and 'serialdev' in line:
                block = '\n'.join(lines[max(0, i-8):i+8])
                m = re.search(r'accepter\s*:\s*(?:telnet,)?tcp[^,\n]*,\s*(\d+)', block, re.I)
                if m:
                    return f'localhost:{m.group(1)}'
    return None


def _wait_pattern(device, pattern, timeout, show=False, baseline_offset=None):
    """Poll buf.log until `pattern` appears or timeout expires.

    Args:
        device:          /dev/ttyUSBx path.
        pattern:         Regex string. Matched against ANSI-stripped new content.
        timeout:         Seconds to wait before returning False.
        show:            If True, print new lines to stdout as they arrive
                         (used by 'send' without --json/--capture).
        baseline_offset: Byte offset in buf.log to start reading from. Set
                         this to the file size snapped BEFORE the command was
                         written to the FIFO so pre-command output is excluded.
                         None = snap to current end at call time.

    Returns True if pattern matched, False on timeout or daemon death.

    Adaptive polling: 50ms for the first second (fast response for quick
    commands), then 200ms (reduces CPU for long-running commands).

    Daemon liveness is checked at the top of each iteration. If the daemon
    dies mid-wait, returns False immediately rather than burning the timeout.
    """
    bf = devdir(device) / 'buf.log'
    sf = devdir(device) / 'status.json'
    pat = re.compile(pattern)
    deadline = time.time() + timeout
    t_start = time.time()
    baseline = baseline_offset if baseline_offset is not None else (
        bf.stat().st_size if bf.exists() else 0)

    while time.time() < deadline:
        if not _daemon_running(device):
            return False

        interval = 0.05 if (time.time() - t_start) < 1.0 else 0.2
        time.sleep(interval)

        # ── Fast path: check status.json for a fresh SHELL state ───────────
        # Shell prompts don't end with \n so _append holds them in _partial
        # (never written to buf.log).  _update_state() still detects SHELL
        # via the raw text and updates status.json, so we check here too.
        # Guard: last_prompt_ago must be < elapsed so we match the prompt
        # from THIS command, not a pre-existing SHELL from before the send.
        if pat.pattern == r'[\$#>]\s*$' or 'SHELL' in pattern.upper():
            try:
                s = json.loads(sf.read_text())
                if s.get('state') == 'SHELL':
                    lpa = s.get('last_prompt_ago')
                    elapsed = time.time() - t_start
                    if lpa is not None and lpa < elapsed:
                        return True
            except (OSError, ValueError, KeyError):
                pass

        if not bf.exists():
            continue
        sz = bf.stat().st_size
        if sz <= baseline:
            continue

        try:
            with open(bf, 'rb') as f:
                f.seek(baseline)
                new = f.read().decode('utf-8', errors='replace')
        except OSError:
            continue
        baseline = sz

        if new and show:
            for line in new.splitlines():
                print(RE_TIMESTAMP.sub('', line))
            sys.stdout.flush()

        if pat.search(_strip_ansi(new)):
            return True

    return False


def _human_session_active(device: str) -> bool:
    """Return True if a human serial-connect/tio session is active for this device.

    Reads ~/var/serial-agent/<devname>/human_session (written by serial-connect
    _lock_acquire). Format: line 1 = PID, line 2 = Unix epoch float.
    Returns False and removes the file if PID is dead or epoch is >300s old.
    """
    hf = devdir(device) / 'human_session'
    if not hf.exists():
        return False
    try:
        lines = hf.read_text().strip().splitlines()
        if len(lines) < 2:
            hf.unlink(missing_ok=True)
            return False
        pid   = int(lines[0])
        epoch = float(lines[1])
        try:
            os.kill(pid, 0)
        except OSError:
            hf.unlink(missing_ok=True)
            return False
        if time.time() - epoch > 300:
            hf.unlink(missing_ok=True)
            return False
        return True
    except (ValueError, OSError):
        hf.unlink(missing_ok=True)
        return False


def _log_op(device: str, op: str, **kwargs):
    """Append one JSON entry to ops.log (ring-capped at 500 lines)."""
    log_file = devdir(device) / 'ops.log'
    entry = json.dumps({'ts': ts(), 'op': op, 'pid': os.getpid(), **kwargs})
    try:
        existing = log_file.read_text().splitlines() if log_file.exists() else []
        existing.append(entry)
        if len(existing) > 500:
            existing = existing[-500:]
        _tmp = log_file.with_suffix('.tmp')
        _tmp.write_text('\n'.join(existing) + '\n')
        _tmp.rename(log_file)
    except OSError:
        pass


def _daemon_running(device: str) -> bool:
    """Return True if a daemon process for this device is alive.

    Reads daemon.pid and sends kill(pid, 0) — a zero-signal that checks
    process existence without delivering anything. Returns False if the
    PID file is missing, unreadable, or the process no longer exists.

    Called frequently (per poll iteration in wait loops) so must be fast.
    The kill(0) syscall is O(1) and does not block.
    """
    pf = devdir(device) / 'daemon.pid'
    if not pf.exists():
        return False
    try:
        os.kill(int(pf.read_text().strip()), 0)
        return True
    except (OSError, ValueError):
        return False


# ══════════════════════════════════════════════════════════════════════════════
# CLI commands
# ══════════════════════════════════════════════════════════════════════════════
def cmd_start(args):
    """Start a daemon for a serial device.

    Double-forks to detach from the terminal (setsid + second fork). The
    parent waits 0.6s then prints the PID and buf.log path from status.json.
    On start, ALL previous state files for this device are removed so stale
    data from a prior session cannot corrupt the new one.

    Exits silently if status.json does not appear within 0.6s (daemon failed
    to start — check daemon.log for the reason).
    """
    tcp = None
    if args.tcp:
        host, port = args.tcp.rsplit(':', 1)
        tcp = (host, int(port))

    ensure_symlink()
    AGENT_BASE.mkdir(parents=True, exist_ok=True)

    ddir = devdir(args.device)
    # Guard: if a daemon is already running, report its status and return.
    # Without this, 'start' would delete the running daemon's pid file, making
    # it unmanageable — it holds the device open but can never be stopped.
    if _daemon_running(args.device):
        sf = ddir / 'status.json'
        if sf.exists():
            s = json.loads(sf.read_text())
            print(f"ALREADY  daemon PID {s['pid']}  {args.device}  via {s['via']}")
        else:
            print(f"ALREADY  daemon running for {args.device}")
        return
    # Remove ALL transient files so old daemon can't steal commands or data
    for stale in ('buf.log', 'status.json', 'daemon.pid', 'input.fifo', 'events.log'):
        (ddir / stale).unlink(missing_ok=True)

    pid = os.fork()
    if pid:
        time.sleep(0.6)
        sf = ddir / 'status.json'
        if sf.exists():
            s = json.loads(sf.read_text())
            print(f"daemon PID {s['pid']}  {args.device}  via {s['via']}")
            print(f"  buf:  {s['buf_file']}")
            print(f"  tail: tail -f {s['buf_file']}")
        else:
            print(f"daemon failed to start — check {ddir}/daemon.log", file=sys.stderr)
            sys.exit(1)
        return

    os.setsid()
    if os.fork():
        os._exit(0)

    # Redirect fds 0/1/2 so any inherited pipe write-ends (e.g. from
    # subprocess.run(capture_output=True)) are released.  Without this,
    # subprocess.run blocks waiting for EOF on stdout even after the
    # parent has exited, because the grandchild still holds fd=1 open
    # via sys.__stdout__ (Python keeps the original TextIOWrapper alive).
    null_fd = os.open('/dev/null', os.O_RDONLY)
    os.dup2(null_fd, 0); os.close(null_fd)
    log_fd = os.open(str(ddir / 'daemon.log'), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    os.dup2(log_fd, 1); os.dup2(log_fd, 2); os.close(log_fd)
    # Reassign Python file objects to match the new fds.
    sys.stdin  = open('/dev/null', 'r')
    sys.stdout = open(ddir / 'daemon.log', 'a', buffering=1)
    sys.stderr = sys.stdout
    Daemon(args.device, tcp, args.baud, args.lines, args.idle_timeout).run()


def cmd_stop(args):
    """Send SIGTERM to the daemon and wait up to 3s for it to exit.

    Waits for the process to actually exit before returning so that an
    immediate 'serial-agent start' after 'stop' does not race against the
    dying daemon on the serial device. The daemon's run() loop removes
    daemon.pid on clean exit; cmd_stop also removes it as a fallback for
    crash/SIGKILL cases.

    Also SIGTERMs any other processes still holding the device (stale
    restarts or orphaned sessions caught by fuser).

    Refuses to stop if a human tio session is active unless --force is given.
    serial-connect removes the human_session file before calling stop on exit,
    so normal cleanup always proceeds; only external/accidental stops are blocked.
    """
    if _human_session_active(args.device) and not getattr(args, 'force', False):
        print(f'human session active for {args.device} — refusing stop '
              f'(use --force to override or wait for tio to exit)',
              file=sys.stderr)
        sys.exit(1)
    pf = devdir(args.device) / 'daemon.pid'
    killed = []
    if pf.exists():
        try:
            pid = int(pf.read_text().strip())
            os.kill(pid, signal.SIGTERM)
            killed.append(pid)
            for _ in range(30):   # wait up to 3s for clean exit
                try: os.kill(pid, 0); time.sleep(0.1)
                except OSError: break
        except (OSError, ValueError):
            pass
        pf.unlink(missing_ok=True)
    # Also kill any other processes still holding the device (stale restarts,
    # ser2net, orphaned tio sessions). SIGTERM first, SIGKILL if they don't exit.
    import subprocess
    fuser_pids = []
    try:
        r = subprocess.run(['fuser', args.device], capture_output=True, text=True)
        for p in r.stdout.split():
            try:
                pid2 = int(p)
                if pid2 not in killed:
                    os.kill(pid2, signal.SIGTERM)
                    killed.append(pid2)
                    fuser_pids.append(pid2)
            except (OSError, ValueError):
                pass
    except FileNotFoundError:
        pass
    if fuser_pids:
        for _ in range(15):   # wait up to 1.5s for graceful exit
            fuser_pids = [p for p in fuser_pids if os.path.exists(f'/proc/{p}')]
            if not fuser_pids:
                break
            time.sleep(0.1)
        for p in fuser_pids:  # SIGKILL anything that didn't respond
            try: os.kill(p, signal.SIGKILL)
            except OSError: pass
    if killed:
        print(f'SIGTERM → PIDs {killed}')
    else:
        print(f'no daemon running for {args.device}')


def cmd_status(args):
    sf = devdir(args.device) / 'status.json'
    if not sf.exists():
        print(json.dumps({'state': 'NO_DAEMON', 'device': args.device}))
        sys.exit(1)
    print(sf.read_text())


def cmd_alive(args):
    """Check whether the board is alive. Exits 0 if alive, 1 if not.

    Fast paths (no serial traffic):
      SHELL + recent prompt   → ALIVE immediately
      RUNNING + recent output → ALIVE (board is busy, don't interrupt)
      Any state + output <2s  → ALIVE (something is printing)
      UBOOT                   → ALIVE

    Slow path (only if fast paths all miss):
      Sends a bare CR to the FIFO with O_NONBLOCK. If the board responds
      (buf.log grows and state becomes SHELL/RUNNING/LOGIN/PASSWORD), reports
      ALIVE. Probe timeout is controlled by --timeout (default 5s).

    The slow-path FIFO write uses O_NONBLOCK so it never hangs if the daemon
    just died. A _daemon_running() guard prevents probing a dead daemon.
    """
    sf = devdir(args.device) / 'status.json'
    if not sf.exists():
        print('NO_DAEMON'); sys.exit(1)
    s = json.loads(sf.read_text())
    state = s.get('state', 'UNKNOWN')

    if state == 'SHELL':
        ago = s.get('last_prompt_ago')
        if ago is not None and ago < args.timeout:
            _log_op(args.device, 'alive', result='ALIVE', state='SHELL')
            print(f'ALIVE  state=SHELL  prompt {ago:.0f}s ago'); sys.exit(0)

    # RUNNING = board is alive, just busy — don't probe (would interrupt command!)
    if state == 'RUNNING':
        ago = s.get('last_output_ago')
        if ago is not None and ago < args.timeout:
            _log_op(args.device, 'alive', result='ALIVE', state='RUNNING')
            print(f'ALIVE  state=RUNNING  output {ago:.1f}s ago'); sys.exit(0)

    # Any recent output = alive (covers BOOTING, LOGIN, etc.)
    ago = s.get('last_output_ago')
    if ago is not None and ago < 2.0:
        _log_op(args.device, 'alive', result='ALIVE', state=state)
        print(f'ALIVE  state={state}  output {ago:.1f}s ago'); sys.exit(0)

    # UBOOT = board is alive at U-Boot prompt
    if state == 'UBOOT':
        _log_op(args.device, 'alive', result='ALIVE', state='UBOOT')
        print(f'ALIVE  state=UBOOT'); sys.exit(0)

    # Slow path: probe with CR — skip if a human tio session is active
    bf = devdir(args.device) / 'buf.log'
    if _daemon_running(args.device):
        fifo = devdir(args.device) / 'input.fifo'
        try:
            fd = os.open(str(fifo), os.O_WRONLY | os.O_NONBLOCK)
            try: os.write(fd, b'\r')
            finally: os.close(fd)
        except OSError:
            pass
        deadline = time.time() + args.timeout
        prev = bf.stat().st_size if bf.exists() else 0
        while time.time() < deadline:
            if not _daemon_running(args.device):
                break
            time.sleep(0.15)
            if bf.exists() and bf.stat().st_size > prev:
                s2 = json.loads(sf.read_text())
                st2 = s2.get('state', '')
                if st2 in ('SHELL', 'RUNNING', 'LOGIN', 'PASSWORD'):
                    _log_op(args.device, 'alive', result='ALIVE', state=st2)
                    print(f'ALIVE  state={st2}  (probe response)'); sys.exit(0)
                prev = bf.stat().st_size

    _log_op(args.device, 'alive', result='DEAD_OR_UNKNOWN', state=state)
    print(f'DEAD_OR_UNKNOWN  state={state}'); sys.exit(1)


def cmd_read(args):
    bf = devdir(args.device) / 'buf.log'
    if not bf.exists():
        sys.exit(0)
    lines = bf.read_text().splitlines()
    tail = lines[-args.lines:]
    if args.no_timestamps:
        tail = _strip_timestamps(tail)
    print('\n'.join(tail))


def cmd_send(args):
    """Send a command to the board and optionally capture structured output.

    Typical usage:
      --json     Structured output: {output, state, elapsed_ms, exit_code,
                 timed_out}. Zero-parsing for agents — just read the JSON.
      --capture  Clean stdout only (no timestamps, prompt, or echo).
                 Exit code = command exit code if --exit-code was also used.
      --exit-code Appends '; echo SERIAL_EXITCODE:$?' to the command and
                  parses the exit code. NOTE: avoid 'exit' in commands with
                  this flag — the shell exits before the echo can run; use
                  'run' instead for multi-step scripts.
      --no-wait  Fire and forget — write to FIFO and return immediately.
      --no-wrap  Prepend COLUMNS=32767 to prevent board terminal from
                 wrapping long output lines (important for grep, find, etc.).
      --all      Fan-out: send to every device with a running daemon in
                 parallel; results keyed by device path in the JSON output.

    Exit code: 0 = completed (pattern matched), 1 = timed out or failed.
    """
    # ── Fan-out: send to ALL running daemons ──────────────────────────────────
    if args.all:
        targets = []
        if AGENT_BASE.exists():
            for ddir_p in AGENT_BASE.iterdir():
                if not ddir_p.is_dir(): continue
                dev = f'/dev/{ddir_p.name}'
                if _daemon_running(dev):
                    targets.append(dev)
        if not targets:
            print('No running daemons found.', file=sys.stderr); sys.exit(1)

        import threading
        results = {}
        def _send_one(dev):
            ns = argparse.Namespace(**vars(args))
            ns.device = dev; ns.all = False
            results[dev] = _send_impl(ns)

        threads = [threading.Thread(target=_send_one, args=(d,)) for d in targets]
        for t in threads: t.start()
        for t in threads: t.join()

        if args.json:
            print(json.dumps(results, indent=2))
        else:
            for dev, r in results.items():
                print(f'\n── {dev} ──')
                if isinstance(r, dict):
                    print(r.get('output', ''))
        sys.exit(0 if all(not r.get('timed_out') for r in results.values() if isinstance(r, dict)) else 1)

    result = _send_impl(args)
    if result is None:
        return  # --no-wait

    if args.json:
        print(json.dumps(result, indent=2))
        sys.exit(0 if not result.get('timed_out') else 1)
    elif args.capture:
        print(result.get('output', ''))
        ec = result.get('exit_code')
        if ec is not None and ec != 0:
            sys.exit(ec)
        sys.exit(0 if not result.get('timed_out') else 1)
    else:
        sys.exit(0 if not result.get('timed_out') else 1)


def _send_impl(args):
    """Core send implementation. Shared by cmd_send, _do_send, and cmd_connect.

    Flow:
      1. Verify daemon is running (exits with error if not).
      2. Snap buf.log byte offset (baseline) to the last complete newline so
         post-command output capture starts cleanly.
      3. Wrap the command with COLUMNS= prefix (--no-wrap) or EXITCODE echo
         (--exit-code) if requested.
      4. Write command+newline to input.fifo using O_NONBLOCK. Retries up to
         up to 20 attempts x 100ms, checking daemon liveness on each. Fails fast
         with 'no daemon' if daemon dies during retry.
      5. If --no-wait: return None immediately (fire and forget).
      6. Otherwise: call _wait_pattern() to block until the shell prompt
         (or custom --wait pattern) appears in buf.log after the baseline.
      7. Read buf.log from baseline, call _clean_output() to strip timestamps,
         ANSI codes, command echo, trailing prompt, and extract EXITCODE.

    Returns:
        dict  with keys: output, state, elapsed_ms, exit_code, timed_out
              (when --json, --capture, or --exit-code is set)
        dict  with key: timed_out only (when none of the above)
        None  when --no-wait
    Calls sys.exit(1) on daemon errors (does not return).
    """
    fifo = devdir(args.device) / 'input.fifo'
    if not _daemon_running(args.device):
        print(f'no daemon for {args.device}', file=sys.stderr); sys.exit(1)

    bf = devdir(args.device) / 'buf.log'
    t0 = time.time()
    # Snap to last newline so we never read a partial timestamped line
    if bf.exists():
        with open(bf, 'rb') as _f:
            _raw = _f.read()
        _nl = _raw.rfind(b'\n')
        baseline_offset = _nl + 1 if _nl >= 0 else len(_raw)
    else:
        baseline_offset = 0

    cmd = args.command.rstrip('\n')
    if getattr(args, 'no_wrap', False):
        # Prevent board terminal from wrapping long output lines
        cmd = f'COLUMNS=32767 LINES=200 {cmd}'
    if args.exit_code:
        cmd = f'{cmd}; echo "{EXITCODE_TAG}:$?"'
    cmd_bytes = (cmd + '\n').encode()

    # Use O_NONBLOCK so we never block waiting for the daemon's reader.
    # Retry briefly if the daemon's _writer thread isn't ready yet.
    sent = False
    for attempt in range(20):   # up to 2s (20 × 0.1s)
        if not _daemon_running(args.device):
            print(f'no daemon for {args.device}', file=sys.stderr); sys.exit(1)
        try:
            fd = os.open(str(fifo), os.O_WRONLY | os.O_NONBLOCK)
            try:
                os.write(fd, cmd_bytes)
            finally:
                os.close(fd)
            sent = True
            break
        except OSError:
            time.sleep(0.1)
    if not sent:
        print(f'daemon not accepting input for {args.device}', file=sys.stderr)
        sys.exit(1)

    # --no-wait: fire and forget
    if args.wait is None and not (args.json or args.capture or args.exit_code):
        return None

    wait_pat = args.wait if args.wait is not None else r'[\$#>]\s*$'
    show = not (args.json or args.capture)
    ok = _wait_pattern(args.device, wait_pat, args.timeout,
                       show=show, baseline_offset=baseline_offset)
    elapsed_ms = int((time.time() - t0) * 1000)

    if args.json or args.capture or args.exit_code:
        new_lines = []
        if bf.exists():
            with open(bf, 'rb') as f:
                f.seek(baseline_offset)
                raw = f.read().decode('utf-8', errors='replace')
            new_lines = raw.splitlines()
        output, exit_code = _clean_output(new_lines, cmd.strip())  # use actual sent cmd for echo detection
        sf = devdir(args.device) / 'status.json'
        state = json.loads(sf.read_text()).get('state', '?') if sf.exists() else '?'
        result = {
            'output':     output,
            'state':      state,
            'elapsed_ms': elapsed_ms,
            'exit_code':  exit_code,
            'timed_out':  not ok,
        }
        _log_op(args.device, 'send', cmd=cmd.strip(), timeout=args.timeout,
                elapsed_ms=elapsed_ms, state=state,
                exit_code=exit_code, timed_out=not ok)
        return result
    _log_op(args.device, 'send', cmd=cmd.strip(), timeout=args.timeout,
            elapsed_ms=elapsed_ms, timed_out=not ok)
    return {'timed_out': not ok}


def cmd_expect(args):
    """Wait for first of multiple patterns. Returns JSON with matched key and output."""
    bf = devdir(args.device) / 'buf.log'
    if bf.exists():
        with open(bf, 'rb') as _f:
            _raw = _f.read()
        _nl = _raw.rfind(b'\n')
        baseline_offset = _nl + 1 if _nl >= 0 else len(_raw)
    else:
        baseline_offset = 0
    deadline = time.time() + args.timeout
    t0 = time.time()

    patterns = {}
    for p in args.on:
        if '=' not in p:
            print(f'Bad --on format (use KEY=REGEX): {p}', file=sys.stderr); sys.exit(1)
        key, regex = p.split('=', 1)
        patterns[key] = re.compile(regex)

    import shutil
    use_inotify = bool(shutil.which('inotifywait')) and bf.parent.exists()
    baseline = baseline_offset

    while time.time() < deadline:
        if not _daemon_running(args.device):
            break

        if use_inotify:
            remaining = max(0.1, deadline - time.time())
            try:
                import subprocess
                subprocess.run(
                    ['inotifywait', '-q', '-e', 'modify,create',
                     '--timeout', str(min(remaining, 5)), str(bf.parent)],
                    capture_output=True, timeout=remaining + 1)
            except Exception:
                use_inotify = False
        else:
            interval = 0.05 if (time.time() - t0) < 1.0 else 0.2
            time.sleep(interval)

        if not bf.exists(): continue
        sz = bf.stat().st_size
        if sz <= baseline: continue

        try:
            with open(bf, 'rb') as f:
                f.seek(baseline_offset); all_new = f.read().decode('utf-8', errors='replace')
            with open(bf, 'rb') as f:
                f.seek(baseline); inc = f.read().decode('utf-8', errors='replace')
        except OSError:
            continue
        baseline = sz

        clean_inc = _strip_ansi(inc)
        for key, pat in patterns.items():
            if pat.search(clean_inc):
                lines, _ = _clean_output(all_new.splitlines())
                print(json.dumps({
                    'matched':    key,
                    'output':     lines,
                    'elapsed_ms': int((time.time() - t0) * 1000),
                }))
                sys.exit(0)

    # Timed out
    lines = ''
    if bf.exists():
        with open(bf, 'rb') as f:
            f.seek(baseline_offset)
            raw, _ = _clean_output(f.read().decode('utf-8', errors='replace').splitlines())
        lines = raw
    print(json.dumps({
        'matched':    None,
        'output':     lines,
        'elapsed_ms': int((time.time() - t0) * 1000),
        'timed_out':  True,
    }))
    sys.exit(1)


def cmd_wait(args):
    """Block until a regex pattern appears in the board's output buffer.

    Unlike wait-state (which watches the state machine), wait watches the
    raw buf.log content. Useful for waiting on a specific log message,
    error string, or application output that doesn't map to a board state.

    Exit 0 on match, 1 on timeout or daemon death.
    """
    sys.exit(0 if _wait_pattern(args.device, args.pattern, args.timeout) else 1)


def _wait_state(device, state_csv, timeout, print_output=True):
    """Block until the board reaches one of the target states.

    Args:
        device:       /dev/ttyUSBx path.
        state_csv:    Comma-separated target states, e.g. 'SHELL,LOGIN'.
        timeout:      Seconds before giving up.
        print_output: If True, print ALREADY/REACHED/TIMEOUT/DAEMON_DIED
                      to stdout for the user to see.

    Returns True if a target state was reached, False on failure.
    Does NOT call sys.exit — callers decide what to do on False.

    Fast path: if the current state in status.json is already in targets,
    returns True immediately (prints ALREADY).

    Event-driven path (inotifywait available): watches events.log for new
    writes, wakes instantly on state change, checks daemon liveness once per
    inotify cycle (up to 10s). Much lower CPU than polling.

    Polling fallback: 50ms for first 2s, then 200ms. Used when inotifywait
    is not installed.

    On daemon death: prints DAEMON_DIED and returns False immediately,
    regardless of remaining timeout.

    On timeout: prints TIMEOUT with the last known state and returns False.
    """
    import shutil
    ef = devdir(device) / 'events.log'
    sf = devdir(device) / 'status.json'
    targets = {s.strip().upper() for s in state_csv.split(',')}

    if sf.exists():
        s = json.loads(sf.read_text())
        if s.get('state', '') in targets:
            if print_output: print(f'ALREADY  state={s["state"]}')
            return True

    deadline = time.time() + timeout
    t_start = time.time()
    baseline = ef.stat().st_size if ef.exists() else 0
    use_inotify = bool(shutil.which('inotifywait'))

    while time.time() < deadline:
        if not _daemon_running(device):
            if print_output: print(f'DAEMON_DIED  state=DEAD')
            return False

        if use_inotify:
            remaining = max(0.1, deadline - time.time())
            try:
                import subprocess as _sp
                _sp.run(
                    ['inotifywait', '-q', '-e', 'modify,create',
                     '--timeout', str(min(remaining, 10)), str(ef.parent)],
                    capture_output=True, timeout=remaining + 2)
            except Exception:
                use_inotify = False
        else:
            interval = 0.05 if (time.time() - t_start) < 2.0 else 0.2
            time.sleep(interval)

        # Always check status.json on each wakeup — catches states set directly
        # in run() (e.g. DEAD from silence timeout) that don't produce an
        # events.log line before Fix 1 was applied, and as a safety net after.
        if sf.exists():
            cur = json.loads(sf.read_text()).get('state', '')
            if cur in targets:
                if print_output: print(f'REACHED  state={cur}  (via status.json)')
                return True

        if not ef.exists(): continue
        sz = ef.stat().st_size
        if sz > baseline:
            with open(ef) as f:
                f.seek(baseline); new_lines = f.read()
            baseline = sz
            for line in new_lines.splitlines():
                m = re.search(r'→\s+(\w+)', line)
                if m and m.group(1) in targets:
                    if print_output: print(f'REACHED  {line.strip()}')
                    return True

    state = json.loads(sf.read_text()).get('state', '?') if sf.exists() else '?'
    if print_output: print(f'TIMEOUT  state={state}  waited={timeout}s  target={state_csv}')
    return False


def cmd_wait_state(args):
    """Block until the board reaches one of the target states, then exit 0.

    Uses inotifywait (if installed) for event-driven wakeup with sub-ms
    latency, falling back to 50-200ms polling. Prints one of:
      ALREADY  state=X    — already in target state when called
      REACHED  [timestamp] PREV → NEW  prompt   — transition observed
      TIMEOUT  state=X  waited=N  target=Y       — timed out
      DAEMON_DIED  state=DEAD                    — daemon process died

    Exit 0 = target reached. Exit 1 = timeout or daemon death.

    See also: wait-alive (shorthand for SHELL,LOGIN,PASSWORD).
    """
    ok = _wait_state(args.device, args.state, args.timeout)
    sys.exit(0 if ok else 1)


def cmd_events(args):
    ef = devdir(args.device) / 'events.log'
    if not ef.exists():
        print('No events yet.'); return
    lines = ef.read_text().splitlines()
    print('\n'.join(lines[-args.lines:]))


def cmd_tail(args):
    bf = devdir(args.device) / 'buf.log'
    if not bf.exists():
        print('no buffer (daemon not started?)', file=sys.stderr); sys.exit(1)
    lines = bf.read_text().splitlines()
    for l in lines[-20:]:
        print(RE_TIMESTAMP.sub('', l) if args.no_timestamps else l)
    offset = bf.stat().st_size
    deadline = time.time() + args.timeout if args.timeout > 0 else None
    try:
        while True:
            if deadline and time.time() >= deadline:
                break
            if not _daemon_running(args.device):
                break
            time.sleep(0.1)
            sz = bf.stat().st_size if bf.exists() else 0
            if sz > offset:
                with open(bf, 'rb') as f:
                    f.seek(offset); new = f.read().decode('utf-8', errors='replace')
                for l in new.splitlines():
                    print(RE_TIMESTAMP.sub('', l) if args.no_timestamps else l)
                sys.stdout.flush()
                offset = sz
    except KeyboardInterrupt:
        pass


def cmd_connect(args):
    """One-shot: discover board, start daemon if needed, optionally wait for shell."""
    import subprocess, shutil
    sd = shutil.which('serial-discover')
    if not sd:
        print('serial-discover not found', file=sys.stderr); sys.exit(1)

    try:
        raw = subprocess.check_output([sd, '--json'], stderr=subprocess.DEVNULL, timeout=15)
        devices = json.loads(raw)
    except Exception as e:
        print(f'serial-discover failed: {e}', file=sys.stderr); sys.exit(1)

    if args.board:
        pat = re.compile(args.board, re.I)
        devices = [d for d in devices
                   if pat.search(d.get('label', '')) or pat.search(d.get('hostname', ''))
                   or pat.search(d.get('devname', ''))]
    if args.serial:
        devices = [d for d in devices if args.serial in d.get('serial', '')]
    if not args.board and not args.serial:
        # default: only LIVE or OPEN boards
        devices = [d for d in devices if d.get('state') in ('LIVE', 'OPEN')]

    if not devices:
        what = f"board '{args.board}'" if args.board else 'any live board'
        print(f'No match for {what}. Run serial-agent auto-label and serial-discover first.',
              file=sys.stderr); sys.exit(1)

    # Prefer a LIVE or OPEN port (console port) over dead ports
    live = [d for d in devices if d.get('state') in ('LIVE', 'OPEN')]
    d = live[0] if live else devices[0]
    device = d['device']
    ensure_symlink()

    # Start daemon in always-on mode (--idle-timeout 0).  On-demand mode would
    # leave the daemon parked with _fd=None, making _send_raw a silent no-op —
    # any subsequent 'send' call would time out with no error message.
    if not _daemon_running(device):
        tcp = find_ser2net_port(device)
        cmd = [sys.argv[0], 'start', device, '--baud', str(d['baud']),
               '--idle-timeout', '0']
        if tcp: cmd += ['--tcp', tcp]
        try:
            subprocess.run(cmd, check=True)
        except subprocess.CalledProcessError:
            print(f'Failed to start daemon for {device}', file=sys.stderr); sys.exit(1)
        for _ in range(20):   # poll up to 2s instead of fixed sleep
            if _daemon_running(device):
                break
            time.sleep(0.1)
    else:
        # Daemon already running — probe if board is idle/DEAD (no output for 30s).
        # Directly write CR to fifo so wait_state below sees the prompt transition.
        sf2 = devdir(device) / 'status.json'
        cur2 = json.loads(sf2.read_text()).get('state', '') if sf2.exists() else ''
        if cur2 in ('DEAD', 'UNKNOWN'):
            fifo2 = devdir(device) / 'input.fifo'
            if fifo2.exists():
                try:
                    fd2 = os.open(str(fifo2), os.O_WRONLY | os.O_NONBLOCK)
                    try: os.write(fd2, b'\r')
                    finally: os.close(fd2)
                except OSError:
                    pass

    if args.wait_shell:
        if not _wait_state(device, 'SHELL,LOGIN,PASSWORD', args.timeout,
                           print_output=not args.json):
            sys.exit(1)  # _wait_state already printed DAEMON_DIED or TIMEOUT
        sf = devdir(device) / 'status.json'
        cur = json.loads(sf.read_text()).get('state', '') if sf.exists() else ''
        # Auto-login if board landed at LOGIN (consistent with reboot behaviour)
        if cur == 'LOGIN':
            _do_send(device, getattr(args, 'user', 'root'), wait=r'Password|[\$#>]\s*$', timeout=10)
            cur = json.loads(sf.read_text()).get('state', '') if sf.exists() else ''
            if cur == 'PASSWORD':
                _do_send(device, getattr(args, 'password', None) or '', wait=r'[\$#>]\s*$', timeout=10)
            cur = json.loads(sf.read_text()).get('state', '') if sf.exists() else ''
        if args.setup_terminal and cur == 'SHELL':
            _send_impl(argparse.Namespace(
                device=device, command='stty cols 220 rows 50',
                wait=r'[\$#>]\s*$', timeout=5,
                json=True, capture=False, exit_code=False, all=False, no_wrap=False))

    _sf_log = devdir(device) / 'status.json'
    _st_log = json.loads(_sf_log.read_text()).get('state', '?') if _sf_log.exists() else '?'
    _log_op(device, 'connect', board=d.get('label') or d.get('hostname', ''),
            state=_st_log)
    if args.json:
        sf = devdir(device) / 'status.json'
        info = {'device': device, 'label': d['label'], 'hostname': d['hostname'],
                'baud': d['baud'], 'state': None}
        if sf.exists():
            info['state'] = json.loads(sf.read_text()).get('state')
        print(json.dumps(info))
    else:
        label = d['label'] or d['hostname'] or d['devname']
        print(f'Connected: {device} ({label})')
        sf = devdir(device) / 'status.json'
        if sf.exists():
            state = json.loads(sf.read_text()).get('state', '?')
            print(f'  state: {state}')


def cmd_path(args):
    print(devdir(args.device))


def cmd_auto_label(args):
    """Generate unique labels for unlabeled boards and update serial-boards.conf.
    Format: hostname-last6serial — unique even for two identical board types."""
    import subprocess, shutil
    sd = shutil.which('serial-discover')
    if not sd:
        print('serial-discover not found', file=sys.stderr); sys.exit(1)

    try:
        raw = subprocess.check_output([sd, '--json'], stderr=subprocess.DEVNULL, timeout=15)
        devices = json.loads(raw)
    except Exception as e:
        print(f'serial-discover failed: {e}', file=sys.stderr); sys.exit(1)

    cfg = _resolve_board_cfg()
    existing_text = cfg.read_text() if cfg.exists() else ''

    seen, to_label = set(), {}
    for d in devices:
        ser = d['serial']
        if not ser or ser in seen: continue
        seen.add(ser)
        if d.get('label') or ser in existing_text: continue
        hostname = d.get('hostname', '')
        if d['state'] in ('LIVE', 'OPEN') or hostname:
            to_label[ser] = {'hostname': hostname or d['chip'].lower(),
                             'chip': d['chip'], 'devname': d['devname'],
                             'state': d['state'], 'baud': d['baud']}

    if not to_label:
        print('Nothing to label — all boards already have entries.'); return

    entries = []
    for ser, info in to_label.items():
        suffix = ser[-6:] if len(ser) >= 6 else ser
        label = f"{info['hostname']}-{suffix}"
        entries.append((ser, label, info))

    print(f'Proposed additions to {cfg}:\n')
    for ser, label, info in entries:
        baud_str = f" baud={info['baud']}" if info['baud'] != 115200 else ''
        print(f'  {ser} = {label}  ({info["chip"]} / {info["devname"]} / {info["state"]}{baud_str})')

    print()
    if args.dry_run:
        print('(dry-run — nothing written)'); return
    if not args.yes:
        confirm = input('Write to serial-boards.conf? [y/N]: ').strip().lower()
        if confirm != 'y':
            print('Aborted.'); return

    with open(cfg, 'a') as f:
        f.write('\n# Auto-labeled by serial-agent auto-label\n')
        for ser, label, info in entries:
            baud_suffix = f':{info["baud"]}' if info['baud'] != 115200 else ''
            f.write(f'{ser}={label}{baud_suffix}\n')
    print(f'Added {len(entries)} label(s). Edit {cfg} to rename.')
    print('Labels track USB serial# — stable across sessions and replug.')


def cmd_discover(args):
    """Discover ports, augment with ser2net + daemon info. No hardcoding needed."""
    import subprocess, shutil
    sd = shutil.which('serial-discover')
    if not sd:
        print('serial-discover not found', file=sys.stderr); sys.exit(1)
    try:
        raw = subprocess.check_output([sd, '--json'], stderr=subprocess.DEVNULL, timeout=15)
        devices = json.loads(raw)
    except Exception as e:
        print(f'serial-discover failed: {e}', file=sys.stderr); sys.exit(1)

    if args.board:
        pat = re.compile(args.board, re.I)
        devices = [d for d in devices
                   if pat.search(d.get('label', '')) or pat.search(d.get('hostname', ''))
                   or pat.search(d.get('devname', ''))]
    if args.serial:
        devices = [d for d in devices if args.serial in d.get('serial', '')]
    if args.live:
        devices = [d for d in devices if d.get('state') in ('LIVE', 'OPEN')]

    for d in devices:
        dev = d['device']
        tcp = find_ser2net_port(dev)
        d['ser2net_tcp'] = tcp
        d['daemon_running'] = False
        d['daemon_state']   = None
        sf = AGENT_BASE / d['devname'] / 'status.json'
        pf = AGENT_BASE / d['devname'] / 'daemon.pid'
        if sf.exists() and pf.exists():
            try:
                os.kill(int(pf.read_text().strip()), 0)
                d['daemon_running'] = True
                d['daemon_state'] = json.loads(sf.read_text()).get('state')
            except (OSError, ValueError, json.JSONDecodeError):
                pass
        cmd = ['serial-agent', 'start', dev, '--baud', str(d['baud'])]
        if tcp: cmd += ['--tcp', tcp]
        d['start_cmd'] = ' '.join(cmd)

    print(json.dumps(devices, indent=2))


def _do_send(device, command, wait=r'[\$#>]\s*$', timeout=10, no_wrap=False):
    """Internal helper: send a command and return the result dict (always JSON mode).

    Calls sys.exit(1) if the daemon is not running — callers that need to
    handle daemon death gracefully should check _daemon_running() first.
    Returns None only if the daemon check passes but the send is no-wait
    (which never happens here since wait is always set).
    """
    return _send_impl(argparse.Namespace(
        device=device, command=command, wait=wait, timeout=timeout,
        json=True, capture=False, exit_code=False, all=False, no_wrap=no_wrap))


def cmd_reboot(args):
    """Reboot the board and wait for it to come back up.

    Sends 'reboot' (or a custom --cmd), watches for DEAD, then waits for
    SHELL/LOGIN/UBOOT. Optionally auto-logs in and sets up the terminal.

    Typical MPU workflow:
      serial-agent reboot DEVICE --login --setup-terminal --timeout 120
    """
    device = args.device

    _log_op(device, 'reboot', cmd=args.cmd)

    # Record wall time before sending reboot.  After the board comes back we
    # verify the shell prompt timestamp is NEWER than this — if it's older the
    # board never actually rebooted (command was ignored or came back instantly
    # and hit the _wait_state fast path with the pre-reboot SHELL state).
    t_reboot_sent = time.time()
    sf = devdir(device) / 'status.json'

    # Send the reboot command — don't wait for prompt (shell dies immediately)
    if _daemon_running(device):
        fifo = devdir(device) / 'input.fifo'
        cmd_bytes = (args.cmd + '\n').encode()
        for _ in range(20):
            try:
                fd = os.open(str(fifo), os.O_WRONLY | os.O_NONBLOCK)
                try: os.write(fd, cmd_bytes)
                finally: os.close(fd)
                break
            except OSError:
                time.sleep(0.1)

    if not args.quiet:
        print(f'Rebooting {device}...')

    # Wait for board to go down (DEAD or BOOTING).
    # DEAD is now written to events.log so _wait_state can detect it via inotify.
    went_down = _wait_state(device, 'DEAD,BOOTING', 30)
    if not went_down:
        # Board did not go down within 30s.  Check if it's still at SHELL —
        # the reboot command may have been ignored.
        cur = json.loads(sf.read_text()).get('state', '') if sf.exists() else ''
        if cur in ('SHELL', 'RUNNING'):
            print(f'WARNING: board still at {cur} after 30s — reboot may not have executed',
                  file=sys.stderr)

    # Wait for board to come back
    target = 'SHELL,LOGIN,UBOOT' if not args.no_login else 'SHELL,UBOOT'
    if not _wait_state(device, target, args.timeout):
        sys.exit(1)  # _wait_state already printed DAEMON_DIED or TIMEOUT

    # Verify this is a NEW shell, not the pre-reboot one.
    # last_prompt_ago = seconds since last prompt; approx_prompt_wall = when it happened.
    # If that wall time is before t_reboot_sent, this is the old pre-reboot shell.
    if sf.exists() and not args.quiet:
        prompt_ago = json.loads(sf.read_text()).get('last_prompt_ago')
        if prompt_ago is not None:
            approx_prompt_wall = time.time() - prompt_ago
            if approx_prompt_wall < t_reboot_sent - 1.0:
                print('WARNING: shell prompt predates reboot command — '
                      'board may not have rebooted', file=sys.stderr)

    # Auto-login if board is at LOGIN prompt
    sf = devdir(device) / 'status.json'
    state = json.loads(sf.read_text()).get('state', '') if sf.exists() else ''
    if state == 'LOGIN' and not args.no_login:
        _do_send(device, args.user, wait=r'Password|[\$#>]\s*$', timeout=10)
        state = json.loads(sf.read_text()).get('state', '') if sf.exists() else ''
        if state == 'PASSWORD' and args.password is not None:
            _do_send(device, args.password or '', wait=r'[\$#>]\s*$', timeout=10)

    # Re-read state — login sequence may have changed it
    state = json.loads(sf.read_text()).get('state', '') if sf.exists() else ''
    if args.setup_terminal and state == 'SHELL':
        _do_send(device, 'stty cols 220 rows 50', timeout=5)

    state = json.loads(sf.read_text()).get('state', '?') if sf.exists() else '?'
    if args.json:
        print(json.dumps({'state': state, 'device': device}))
    elif not args.quiet:
        print(f'Board back: state={state}')
    sys.exit(0 if state in ('SHELL', 'UBOOT') else 1)


def cmd_login(args):
    """Handle the board login sequence (username + optional password).

    Detects current state and sends credentials accordingly.
    TI boards: root with no password (default).

    Can be called after reboot or whenever the board is at a login prompt.
    """
    device = args.device
    sf = devdir(device) / 'status.json'
    if not sf.exists():
        print(f'No daemon for {device}', file=sys.stderr); sys.exit(1)

    state = json.loads(sf.read_text()).get('state', 'UNKNOWN')
    if state == 'SHELL':
        print('Already at shell'); return
    if state == 'BOOTING':
        _wait_state(device, 'LOGIN', 90)
        state = json.loads(sf.read_text()).get('state', 'UNKNOWN')
    if state not in ('LOGIN', 'PASSWORD', 'UNKNOWN'):
        print(f'Unexpected state: {state} (need LOGIN or PASSWORD)', file=sys.stderr); sys.exit(1)

    # Skip username if already at PASSWORD prompt
    if state != 'PASSWORD':
        _do_send(device, args.user, wait=r'Password|[\$#>]\s*$', timeout=10)

    # Check if password was requested
    state = json.loads(sf.read_text()).get('state', '') if sf.exists() else ''
    if state == 'PASSWORD':
        _do_send(device, args.password or '', wait=r'[\$#>]\s*$', timeout=10)

    # Verify shell
    _wait_state(device, 'SHELL', 15)
    state = json.loads(sf.read_text()).get('state', '?') if sf.exists() else '?'
    print(f'Logged in: state={state}')
    sys.exit(0 if state == 'SHELL' else 1)


def _get_host_ip_for(board_ip):
    """Find the host IP on the same subnet as the board."""
    import socket
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect((board_ip, 80))
        return s.getsockname()[0]
    except Exception:
        return None
    finally:
        s.close()


def _upload_via_network(args):
    """Upload via temporary HTTP server — ~1MB/s vs ~1KB/s for serial base64.
    Board needs network access and wget. Inspired by Hermes deploy_serial.py pattern."""
    import http.server, threading, socket
    host_path = Path(args.hostfile)
    if not host_path.exists():
        print(f'Not found: {host_path}', file=sys.stderr); sys.exit(1)

    board_path = args.boardpath
    if board_path.endswith('/'):
        board_path += host_path.name

    # Detect board IP from args or from the board itself
    board_ip = args.board_ip
    if not board_ip:
        # Ask the board for its IP
        result = _do_send(args.device,
            "ip route get 1.1.1.1 2>/dev/null | awk '{print $7;exit}' || hostname -I | awk '{print $1}'",
            timeout=5, no_wrap=True)
        board_ip = (result.get('output', '') if result else '').strip().split()[0] if result else ''
        if not board_ip:
            print('Cannot detect board IP. Specify --board-ip.', file=sys.stderr); sys.exit(1)

    host_ip = _get_host_ip_for(board_ip)
    if not host_ip:
        print(f'Cannot find host IP on same subnet as {board_ip}', file=sys.stderr); sys.exit(1)

    # Start temporary HTTP server serving just this file's directory
    serve_dir = str(host_path.parent)
    port = args.http_port

    class SilentHandler(http.server.SimpleHTTPRequestHandler):
        def __init__(self, *a, **kw):
            super().__init__(*a, directory=serve_dir, **kw)
        def log_message(self, *_): pass  # suppress logs

    httpd = http.server.HTTPServer(('0.0.0.0', port), SilentHandler)
    thread = threading.Thread(target=httpd.serve_forever, daemon=True)
    thread.start()

    url = f'http://{host_ip}:{port}/{host_path.name}'
    size = host_path.stat().st_size
    if not args.quiet:
        print(f'HTTP server: {url}  ({size} bytes)')

    try:
        # Ensure destination directory exists
        _do_send(args.device, f'mkdir -p "$(dirname \'{board_path}\')"', timeout=5)

        # Download on the board
        result = _do_send(args.device,
            f'wget -q -O "{board_path}" "{url}" && wc -c < "{board_path}"',
            timeout=60, no_wrap=True)

        if result and not result.get('timed_out'):
            actual = result.get('output', '').strip()
            if actual.isdigit() and int(actual) == size:
                print(f'✓ {board_path} ({size} bytes) via HTTP')
                return
            else:
                print(f'Size mismatch: expected {size}, got {actual!r}', file=sys.stderr)
        else:
            print('Upload timed out or failed', file=sys.stderr)
        sys.exit(1)
    finally:
        httpd.shutdown()


def cmd_upload(args):
    """Upload a file to the board.

    Two modes:
      Serial (default): base64 encoding over serial. No network needed.
        Speed: ~1 KB/s. Good for small files (modules, DTBs, scripts).
      Network (--via-network): starts HTTP server on host, board uses wget.
        Speed: ~1 MB/s. Requires board to have network access and wget.
        Automatically detects host IP on the board's subnet.

    Examples:
      serial-agent upload DEVICE ./my.ko /lib/modules/6.x/extra/
      serial-agent upload DEVICE ./large.bin /tmp/ --via-network
      serial-agent upload DEVICE ./large.bin /tmp/ --via-network --board-ip 192.168.1.100
    """
    if args.via_network:
        _upload_via_network(args)
        return
    import base64
    device = args.device
    host_path = Path(args.hostfile)
    if not host_path.exists():
        print(f'Not found: {host_path}', file=sys.stderr); sys.exit(1)

    board_path = args.boardpath
    if board_path.endswith('/'):
        board_path += host_path.name

    data = host_path.read_bytes()
    b64  = base64.b64encode(data).decode('ascii')
    size = len(data)

    if not args.quiet:
        print(f'Uploading {host_path.name} ({size} bytes) → {board_path}')

    if _human_session_active(device) and not args.quiet:
        print(f'NOTE: human tio session active — upload bytes will appear in the terminal',
              file=sys.stderr)

    # Ensure destination directory exists
    _do_send(device, f'mkdir -p "$(dirname \'{board_path}\')"', timeout=5)

    # Write base64 in chunks via printf (avoids shell expansion issues)
    tmp = '/tmp/_sa_upload.b64'
    _do_send(device, f'printf "" > {tmp}', timeout=5)  # create/truncate

    CHUNK = 72   # base64 chars per chunk (54 raw bytes); stays well within command limits
    chunks = [b64[i:i+CHUNK] for i in range(0, len(b64), CHUNK)]
    total  = len(chunks)

    for i, chunk in enumerate(chunks, 1):
        if not args.quiet and (i % 50 == 0 or i == total):
            print(f'  {i}/{total} chunks ({i*100//total}%)', flush=True)
        r = _do_send(device, f'printf "%s" "{chunk}" >> {tmp}', timeout=5)
        if r and r.get('timed_out'):
            print(f'Upload timed out at chunk {i}/{total}', file=sys.stderr)
            _do_send(device, f'rm -f {tmp}', timeout=5)
            sys.exit(1)

    # Decode and verify
    result = _do_send(device,
        f'base64 -d {tmp} > "{board_path}" && rm {tmp} '
        f'&& wc -c < "{board_path}"',
        timeout=30, no_wrap=True)

    if result and not result.get('timed_out'):
        actual = result.get('output', '').strip()
        if actual.isdigit() and int(actual) == size:
            print(f'✓ {board_path} ({size} bytes)')
            sys.exit(0)
        else:
            print(f'Size mismatch: expected {size}, got {actual}', file=sys.stderr)
    sys.exit(1)


def cmd_run(args):
    """Execute a multi-line shell script on the board via base64 transfer.

    Writes the script to /tmp, executes it, captures output, cleans up.
    Useful for complex test sequences, board configuration, or any multi-step
    operation that would be tedious to send line by line.

    Example:
      serial-agent run DEVICE test_audio.sh --json --timeout 60
      echo 'aplay -l; arecord -l' | serial-agent run DEVICE - --capture
    """
    import base64
    device = args.device

    # Read script
    script_src = args.script
    if script_src == '-':
        script = sys.stdin.read()
    elif Path(script_src).exists():
        script = Path(script_src).read_text()
    else:
        script = script_src  # treat as inline script text

    if not script.strip():
        print('Empty script', file=sys.stderr); sys.exit(1)

    # Verify board is ready before uploading script
    sf = devdir(device) / 'status.json'
    s = json.loads(sf.read_text()) if sf.exists() else {}
    state = s.get('state', 'UNKNOWN')
    if state in ('LOGIN', 'PASSWORD', 'BOOTING', 'PANIC'):
        print(f'Board not at shell (state={state}). Run: serial-agent login {device}',
              file=sys.stderr); sys.exit(1)
    if state == 'RUNNING':
        if not _wait_state(device, 'SHELL', 30, print_output=False):
            print(f'Board stuck in RUNNING state on {device}', file=sys.stderr); sys.exit(1)
    # DEAD is ok if board had a shell prompt before (just quiet) — let the timeout decide

    if _human_session_active(device):
        print(f'NOTE: human tio session active — script bytes will appear in the terminal',
              file=sys.stderr)

    # Encode and transfer script in 72-char chunks (same approach as cmd_upload).
    # A single printf of the full base64 risks exceeding serial input buffer limits
    # for larger scripts. Chunked transfer is reliable at any script size.
    b64 = base64.b64encode(script.encode()).decode('ascii')
    tmp = f'/tmp/_sa_run_{os.getpid()}.sh'   # PID-scoped to avoid parallel collisions
    b64tmp = f'/tmp/_sa_run_{os.getpid()}.b64'
    _do_send(device, f'printf "" > {b64tmp}', timeout=5)
    CHUNK = 72
    chunks = [b64[i:i+CHUNK] for i in range(0, len(b64), CHUNK)]
    for chunk in chunks:
        r = _do_send(device, f'printf "%s" "{chunk}" >> {b64tmp}', timeout=5)
        if r and r.get('timed_out'):
            print(f'Script upload timed out during transfer', file=sys.stderr)
            _do_send(device, f'rm -f {b64tmp}', timeout=5)
            sys.exit(1)
    r = _do_send(device, f'base64 -d {b64tmp} > {tmp} && chmod +x {tmp} && rm {b64tmp}',
                 timeout=10)
    if not r or r.get('timed_out'):
        print(f'Script decode failed on board', file=sys.stderr); sys.exit(1)

    # Execute and capture (set wide terminal so script output doesn't wrap)
    result = _do_send(device,
        f'stty cols 220 rows 50 2>/dev/null; {tmp}; _rc=$?; rm -f {tmp}; echo "{EXITCODE_TAG}:$_rc"',
        wait=rf'{EXITCODE_TAG}:\d+|[\$#>]\s*$',
        timeout=args.timeout, no_wrap=getattr(args, 'no_wrap', False))

    if result:
        # Parse exit code from output
        output = result.get('output', '')
        exit_code = None
        lines = output.splitlines()
        clean = []
        for l in lines:
            m = RE_EXITCODE.match(l.strip())
            if m:
                exit_code = int(m.group(1))
            else:
                clean.append(l)
        result['output'] = '\n'.join(clean).strip()
        result['exit_code'] = exit_code

        if args.json:
            print(json.dumps(result, indent=2))
        elif args.capture:
            print(result['output'])
        else:
            print(result['output'])
        sys.exit(exit_code if exit_code is not None else (0 if not result.get('timed_out') else 1))
    sys.exit(1)


def cmd_health(args):
    """Quick board health snapshot: state, memory, load, kernel, uptime.

    Returns JSON with board vitals. Useful as a pre-flight check before
    running tests, or for monitoring board health between test runs.
    """
    device = args.device
    sf = devdir(device) / 'status.json'
    if not sf.exists():
        print(json.dumps({'state': 'NO_DAEMON'})); sys.exit(1)

    s = json.loads(sf.read_text())
    state = s.get('state', 'UNKNOWN')
    health = {'state': state, 'device': device,
              'last_output_ago': s.get('last_output_ago'),
              'prompt': s.get('prompt_text')}

    if state == 'RUNNING':
        _wait_state(device, 'SHELL', 10, print_output=False)
        s = json.loads(sf.read_text())
        state = s.get('state', 'UNKNOWN')
        health['state'] = state

    if state == 'SHELL':
        # Gather vitals with a single compound command
        vitals_cmd = (
            'printf "UNAME:%s\\n" "$(uname -r)"; '
            'printf "UPTIME:%s\\n" "$(cut -d. -f1 /proc/uptime)"; '
            'printf "MEM_FREE:%s\\n" "$(grep MemAvailable /proc/meminfo | awk \'{print $2}\')"; '
            'printf "MEM_TOTAL:%s\\n" "$(grep MemTotal /proc/meminfo | awk \'{print $2}\')"; '
            'printf "LOAD:%s\\n" "$(cut -d\' \' -f1 /proc/loadavg)"'
        )
        result = _do_send(device, vitals_cmd, timeout=10, no_wrap=True)
        if result and not result.get('timed_out'):
            for line in result.get('output', '').splitlines():
                if ':' in line:
                    k, v = line.split(':', 1)
                    k = k.strip().lower()
                    v = v.strip()
                    if k == 'mem_free':
                        health['mem_free_kb'] = int(v) if v.isdigit() else v
                    elif k == 'mem_total':
                        health['mem_total_kb'] = int(v) if v.isdigit() else v
                    elif k == 'uptime':
                        health['uptime_sec'] = int(v) if v.isdigit() else v
                    elif k in ('uname', 'load'):
                        health[k] = v
            if 'mem_free_kb' in health and 'mem_total_kb' in health:
                health['mem_pct_used'] = round(
                    100 * (health['mem_total_kb'] - health['mem_free_kb'])
                    / health['mem_total_kb'], 1)

    print(json.dumps(health, indent=2))


def cmd_ser2net_gen(args):
    """Generate /etc/ser2net.yaml from serial-boards.conf + current device state.
    Assigns TCP ports starting from --start-port. Run after plugging boards in."""
    import subprocess, shutil
    sd = shutil.which('serial-discover')
    if not sd:
        print('serial-discover not found', file=sys.stderr); sys.exit(1)

    try:
        raw = subprocess.check_output([sd, '--json'], stderr=subprocess.DEVNULL, timeout=15)
        devices = json.loads(raw)
    except Exception as e:
        print(f'serial-discover failed: {e}', file=sys.stderr); sys.exit(1)

    # Deduplicate by serial. For each serial, prefer LIVE/OPEN port (the console port)
    # over dead ports — ser2net needs a valid device path for the right interface.
    seen = {}
    for d in devices:
        ser = d['serial']
        if not ser or not d.get('label'):
            continue
        if ser not in seen:
            seen[ser] = d
        elif d['state'] in ('LIVE', 'OPEN') and seen[ser]['state'] not in ('LIVE', 'OPEN'):
            seen[ser] = d   # upgrade to live port

    if not seen:
        print('No labeled boards found. Run serial-agent auto-label first.',
              file=sys.stderr); sys.exit(1)

    port = args.start_port
    blocks = []
    mapping = []
    for ser, d in seen.items():
        label = d['label']
        safe  = re.sub(r'[^A-Za-z0-9_-]', '_', label)
        baud  = d['baud']
        dev   = d['device']
        blocks.append(
            f'connection: &{safe}\n'
            f'  accepter: tcp,{port}\n'
            f'  connector: serialdev,{dev},{baud}n81,local\n'
            f'  options:\n'
            f'    banner: "\\r\\n{label} ({ser}) @ {baud}\\r\\n"\n'
        )
        mapping.append((label, dev, port, baud))
        port += 1

    from datetime import date
    yaml_out = (
        f'# Generated by serial-agent ser2net-gen  {date.today()}\n'
        f'# sudo cp {args.output} /etc/ser2net.yaml && sudo systemctl restart ser2net\n'
        f'%YAML 1.1\n---\n\n'
        + '\n'.join(blocks)
    )

    if args.output == '-':
        print(yaml_out)
    else:
        Path(args.output).write_text(yaml_out)
        print(f'Written to {args.output}')

    print('\nBoard → TCP port:')
    for label, dev, tcp_port, baud in mapping:
        print(f'  {label:25} {dev}  →  tcp:{tcp_port}  ({baud} baud)')
    print(f'\nInstall:')
    print(f'  sudo cp {args.output} /etc/ser2net.yaml')
    print(f'  sudo systemctl restart ser2net')
    print(f'\nThen:')
    print(f'  serial-agent discover   # ser2net_tcp field will be populated')
    print(f'  tio.sh 1                # auto-connects via TCP if daemon is running')


def cmd_list(args):
    """List all devices with running serial-agent daemons.
    Quick overview — use 'status DEVICE' for full detail on one device."""
    if not AGENT_BASE.exists():
        print('No daemons running'); return
    rows = []
    for ddir in sorted(AGENT_BASE.iterdir()):
        if not ddir.is_dir(): continue
        pf = ddir / 'daemon.pid'; sf = ddir / 'status.json'
        if not pf.exists(): continue
        try:
            os.kill(int(pf.read_text().strip()), 0)
        except (OSError, ValueError):
            continue
        state = via = '?'; buf_lines = 0; prompt = ''
        if sf.exists():
            try:
                s = json.loads(sf.read_text())
                state = s.get('state','?'); via = s.get('via','?')
                buf_lines = s.get('buf_lines', 0); prompt = s.get('prompt_text','')
            except Exception: pass
        rows.append((ddir.name, state, via, buf_lines, prompt))
    if not rows:
        print('No daemons running'); return
    if args.json:
        print(json.dumps([{'device': f'/dev/{r[0]}', 'state': r[1], 'via': r[2],
                           'buf_lines': r[3], 'prompt': r[4]} for r in rows], indent=2))
        return
    G='\033[32m'; C='\033[36m'; Y='\033[33m'; D='\033[2m'; R='\033[31m'; B='\033[1m'; N='\033[0m'
    def _state_fmt(s):
        if s in ('SHELL', 'RUNNING'):   return f'{G}{s:<9}{N}'
        if s in ('UBOOT', 'BOOTING'):   return f'{Y}{s:<9}{N}'
        if s in ('LOGIN', 'PASSWORD'):  return f'{C}{s:<9}{N}'
        if s == 'DEAD':                 return f'{R}{s:<9}{N}'
        return f'{D}{s:<9}{N}'
    print(f'{B}{"Device":<14} {"State":<9} {"Via":<28} {"Buf":>5}  Prompt{N}')
    print('─' * 74)
    for name, state, via, buf_lines, prompt in rows:
        print(f'{name:<14} {_state_fmt(state)} {via:<28} {buf_lines:>5}  {D}{prompt}{N}')


def cmd_ops(args):
    """Print recent operations from ops.log for a device.

    Each line is a JSON record: {ts, op, pid, ...command-specific fields}.
    Human-readable by default; --json prints raw JSON lines.
    """
    log_file = devdir(args.device) / 'ops.log'
    if not log_file.exists():
        print('No operations logged yet.')
        return
    lines = log_file.read_text().splitlines()
    tail = lines[-args.lines:]
    if args.json:
        print('\n'.join(tail))
        return
    for raw in tail:
        try:
            e = json.loads(raw)
            fields = ' '.join(f'{k}={v}' for k, v in e.items()
                              if k not in ('ts', 'op', 'pid'))
            print(f'[{e.get("ts","")}] {e.get("op","?"):12s}  {fields}')
        except (json.JSONDecodeError, KeyError):
            print(raw)


def cmd_attach(args):
    """Launch the configured terminal directly on a daemon's device.
    Shorthand for: serial-connect /dev/DEVICE  (bypasses the menu)"""
    import shutil
    sc = shutil.which('serial-connect')
    if not sc:
        print('serial-connect not found in PATH', file=sys.stderr); sys.exit(1)
    os.execv(sc, [sc, args.device])


def cmd_test(args):
    """Self-test using a virtual pty pair (no real hardware needed).

    Creates a socat loopback (two connected PTYs), runs a daemon on one end,
    injects board output into the other end, and validates:
      1. daemon starts and holds the port
      2. startup probe fires (CR sent to board within 2s)
      3. injected shell prompt → state SHELL
      4. send() delivers command and captures output
      5. relay TCP client connects and receives data
      6. human_session stops cmd_stop; --force overrides it
      7. daemon exits cleanly (pid file removed)

    Requires: socat
    """
    import shutil, socket, subprocess, tempfile, threading

    verbose = args.verbose
    passed = 0
    failed = 0

    def ok(msg):
        nonlocal passed; passed += 1
        print(f'  \033[32m✓\033[0m  {msg}')

    def fail(msg, detail=''):
        nonlocal failed; failed += 1
        s = f'  \033[31m✗\033[0m  {msg}'
        if detail: s += f'\n     {detail}'
        print(s)

    def check(cond, msg, detail=''):
        if cond: ok(msg)
        else:    fail(msg, detail)

    if not shutil.which('socat'):
        print('serial-agent test requires socat (sudo apt install socat)', file=sys.stderr)
        sys.exit(1)

    print(f'\nserial-agent self-test\n{"─"*40}')

    # Create a temp dir for the virtual device + daemon state
    with tempfile.TemporaryDirectory(prefix='sa-test-') as td:
        td = Path(td)
        pty_a = td / 'pty-a'   # daemon connects here
        pty_b = td / 'pty-b'   # test harness writes here (simulates board)

        # socat loopback: two connected PTYs
        socat_proc = subprocess.Popen(
            ['socat',
             f'pty,raw,echo=0,link={pty_a}',
             f'pty,raw,echo=0,link={pty_b}'],
            stderr=subprocess.DEVNULL)
        # wait for both PTYs to appear
        deadline = time.time() + 3
        while time.time() < deadline:
            if pty_a.exists() and pty_b.exists():
                break
            time.sleep(0.05)
        check(pty_a.exists() and pty_b.exists(),
              'socat virtual pty pair created')
        if not pty_a.exists():
            socat_proc.terminate(); return

        vdev = str(pty_a)
        env = os.environ.copy()
        env['SERIAL_AGENT_BASE'] = str(td / 'state')

        # ── Test 1: daemon starts ─────────────────────────────────────────
        # Use DEVNULL (not PIPE/capture_output) so subprocess.run returns
        # promptly.  The daemon double-forks and detaches, but inherited pipe
        # write-ends can cause subprocess.run to block waiting for EOF.
        r = subprocess.run(
            [sys.argv[0], 'start', vdev, '--baud', '115200', '--idle-timeout', '0'],
            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True, env=env)
        if verbose and r.stderr: print(f'     start stderr: {r.stderr.strip()}')
        pid_file = Path(env['SERIAL_AGENT_BASE']) / Path(vdev).name / 'daemon.pid'
        # Give daemon up to 2s to write pid file
        deadline = time.time() + 2
        while time.time() < deadline and not pid_file.exists():
            time.sleep(0.05)
        daemon_pid = None
        try:
            daemon_pid = int(pid_file.read_text().strip())
            os.kill(daemon_pid, 0)
            ok(f'daemon started (PID {daemon_pid})')
        except Exception as e:
            fail('daemon did not start', str(e))
            socat_proc.terminate(); return

        # ── Test 2: startup probe (CR sent to board within 2s) ────────────
        # Open pty_b in non-blocking mode, wait for the CR byte
        fd_b = os.open(str(pty_b), os.O_RDWR | os.O_NONBLOCK)
        probe_received = False
        deadline = time.time() + 2
        while time.time() < deadline:
            try:
                data = os.read(fd_b, 64)
                if b'\r' in data:
                    probe_received = True
                    break
            except OSError:
                time.sleep(0.05)
        check(probe_received, 'startup probe CR received at board within 2s')

        # ── Test 3: shell prompt → state SHELL ───────────────────────────
        # Inject a shell prompt into pty_b so daemon sees it
        os.write(fd_b, b'\r\nroot@testboard:~# ')
        deadline = time.time() + 2
        sf = Path(env['SERIAL_AGENT_BASE']) / Path(vdev).name / 'status.json'
        shell_state = False
        while time.time() < deadline:
            try:
                s = json.loads(sf.read_text())
                if s.get('state') == 'SHELL':
                    shell_state = True; break
            except Exception:
                pass
            time.sleep(0.05)
        check(shell_state, 'injected prompt → state SHELL',
              'check daemon log for details' if not shell_state else '')

        # ── Test 4: send() delivers command, output captured ──────────────
        # We can't do a full round-trip without an interactive shell, but we
        # can verify the command bytes reach the board side.
        recv_buf = []
        def _read_board():
            while True:
                try:
                    d = os.read(fd_b, 256)
                    recv_buf.append(d)
                except OSError:
                    time.sleep(0.02)
        t = threading.Thread(target=_read_board, daemon=True); t.start()

        # Write a command to the FIFO directly
        fifo = Path(env['SERIAL_AGENT_BASE']) / Path(vdev).name / 'input.fifo'
        cmd_bytes = b'echo hello\n'
        sent = False
        for _ in range(20):
            try:
                ffd = os.open(str(fifo), os.O_WRONLY | os.O_NONBLOCK)
                os.write(ffd, cmd_bytes); os.close(ffd)
                sent = True; break
            except OSError:
                time.sleep(0.05)
        # Give the thread time to receive it
        time.sleep(0.3)
        board_saw_cmd = any(b'echo hello' in b for b in recv_buf)
        check(sent and board_saw_cmd,
              'FIFO send reaches board side',
              f'sent={sent} board_saw={board_saw_cmd}')

        # ── Test 5: relay TCP client receives data ─────────────────────────
        relay_ok = False
        try:
            s2 = json.loads(sf.read_text())
            relay_addr = s2.get('relay', '')
            if relay_addr:
                host, port = relay_addr.split(':')
                sock = socket.socket()
                sock.settimeout(2)
                sock.connect((host, int(port)))
                # Inject data at board side; client should receive it
                os.write(fd_b, b'relay-test-data\r\n')
                time.sleep(0.2)
                sock.settimeout(0.5)
                try:
                    chunk = sock.recv(256)
                    relay_ok = b'relay-test-data' in chunk
                except socket.timeout:
                    pass
                sock.close()
        except Exception as e:
            if verbose: print(f'     relay error: {e}')
        check(relay_ok, 'relay TCP client receives board data')

        # ── Test 6: human_session blocks cmd_stop; --force overrides ──────
        hs = Path(env['SERIAL_AGENT_BASE']) / Path(vdev).name / 'human_session'
        hs.write_text(f'{os.getpid()}\n{time.time()}\n')

        # stop without --force should refuse
        r = subprocess.run(
            [sys.argv[0], 'stop', vdev],
            capture_output=True, text=True, env=env)
        stop_refused = r.returncode != 0 and 'human session' in r.stderr
        check(stop_refused, 'cmd_stop refused while human_session active',
              r.stderr.strip() if not stop_refused else '')

        # stop --force should succeed
        r = subprocess.run(
            [sys.argv[0], 'stop', '--force', vdev],
            capture_output=True, text=True, env=env)
        check(r.returncode == 0, 'cmd_stop --force succeeds',
              r.stderr.strip() if r.returncode != 0 else '')

        # ── Test 7: daemon exits cleanly (pid file removed) ───────────────
        time.sleep(0.5)
        pid_gone = not pid_file.exists() or not os.path.exists(f'/proc/{daemon_pid}')
        check(pid_gone, 'daemon exited cleanly (pid file removed)')

        os.close(fd_b)
        socat_proc.terminate()
        socat_proc.wait()

    total = passed + failed
    print(f'\n{"─"*40}')
    if failed == 0:
        print(f'\033[32mAll {total} tests passed.\033[0m\n')
    else:
        print(f'\033[31m{failed}/{total} tests FAILED.\033[0m\n')
        sys.exit(1)


def cmd_clean(args):
    import shutil
    if args.device:
        device = args.device
        if re.match(r'^\d+$', device): device = f'/dev/ttyUSB{device}'
        ddir = AGENT_BASE / devname(device)
        if ddir.exists():
            pf = ddir / 'daemon.pid'
            if pf.exists():
                try:
                    os.kill(int(pf.read_text().strip()), 0)
                    print(f'Daemon is running for {device} — stop it first (serial-agent stop {device})',
                          file=sys.stderr); sys.exit(1)
                except (OSError, ValueError):
                    pass
            shutil.rmtree(ddir); print(f'Cleaned {ddir}')
        else:
            print(f'Nothing to clean for {device}')
    else:
        if not AGENT_BASE.exists(): print('Nothing to clean'); return
        cleaned = 0
        for d in AGENT_BASE.iterdir():
            if not d.is_dir(): continue
            pf = d / 'daemon.pid'
            if pf.exists():
                try:
                    os.kill(int(pf.read_text().strip()), 0)
                    print(f'  Skipping {d.name} (daemon running)'); continue
                except (OSError, ValueError): pass
            shutil.rmtree(d); print(f'  Cleaned {d.name}'); cleaned += 1
        print(f'Cleaned {cleaned} dir(s)')


# ══════════════════════════════════════════════════════════════════════════════
# Argument parsing
# ══════════════════════════════════════════════════════════════════════════════
def main():
    p = argparse.ArgumentParser(
        prog='serial-agent',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description='Serial console daemon and CLI for automation agents\n'
                    'Run with any subcommand -h for details.')
    sub = p.add_subparsers(dest='cmd', required=True)

    def dev(sp, required=True):
        sp.add_argument('device', **(dict() if required else dict(nargs='?', default=None)),
                        help='/dev/ttyUSBx or just the number e.g. 1')

    # ── Daemon lifecycle ───────────────────────────────────────────────────────
    sp = sub.add_parser('start'); dev(sp); sp.set_defaults(func=cmd_start)
    sp.add_argument('--tcp',  metavar='HOST:PORT')
    sp.add_argument('--baud', type=int, default=115200)
    sp.add_argument('--lines',type=int, default=DEFAULT_LINES)
    sp.add_argument('--idle-timeout', type=int, default=60, dest='idle_timeout',
                    metavar='SECS',
                    help='Auto-stop after SECS idle seconds with no relay clients (0=never, default=60). '
                         'serial-connect and connect pass 0 for persistent monitoring.')

    sp = sub.add_parser('stop');   dev(sp); sp.set_defaults(func=cmd_stop)
    sp.add_argument('--force', action='store_true',
                    help='Stop even if a human tio session is active')
    sp = sub.add_parser('status'); dev(sp); sp.set_defaults(func=cmd_status)
    sp = sub.add_parser('path');   dev(sp); sp.set_defaults(func=cmd_path)

    # ── Liveness ───────────────────────────────────────────────────────────────
    sp = sub.add_parser('alive'); dev(sp); sp.set_defaults(func=cmd_alive)
    sp.add_argument('--timeout', type=float, default=5.0)

    sp = sub.add_parser('wait-alive'); dev(sp)
    sp.add_argument('--timeout', type=float, default=120.0)
    def _wait_alive(a): a.state = 'SHELL,LOGIN,PASSWORD'; cmd_wait_state(a)
    sp.set_defaults(func=_wait_alive)

    sp = sub.add_parser('wait-state',
        help='Block until state reached (inotifywait if available, else 50ms poll)')
    dev(sp); sp.set_defaults(func=cmd_wait_state)
    sp.add_argument('state', help='e.g. SHELL  or  SHELL,LOGIN')
    sp.add_argument('--timeout', type=float, default=120.0)

    # ── Observation ────────────────────────────────────────────────────────────
    sp = sub.add_parser('read'); dev(sp); sp.set_defaults(func=cmd_read)
    sp.add_argument('--lines', type=int, default=50)
    sp.add_argument('--no-timestamps', action='store_true',
                    help='Strip [HH:MM:SS.mmm] prefix — clean output for text processing')

    sp = sub.add_parser('events'); dev(sp); sp.set_defaults(func=cmd_events)
    sp.add_argument('--lines', type=int, default=20)

    sp = sub.add_parser('tail'); dev(sp); sp.set_defaults(func=cmd_tail)
    sp.add_argument('--no-timestamps', action='store_true')
    sp.add_argument('--timeout', type=float, default=0,
                    metavar='SECS', help='Exit after SECS seconds (0=no limit)')

    # ── Sending ────────────────────────────────────────────────────────────────
    sp = sub.add_parser('send',
        help='Send command; --json for structured output, --capture for clean stdout')
    dev(sp); sp.set_defaults(func=cmd_send)
    sp.add_argument('command')
    sp.add_argument('--wait', metavar='PATTERN', default=r'[\$#>]\s*$',
                    help='Wait for regex after sending (default: shell prompt)')
    sp.add_argument('--no-wait', dest='wait', action='store_const', const=None,
                    help='Fire and forget — do not wait for response')
    sp.add_argument('--timeout', type=float, default=30.0)
    sp.add_argument('--no-wrap', action='store_true',
                    help='Prepend COLUMNS=32767 to prevent board terminal from wrapping output')
    sp.add_argument('--json', action='store_true',
                    help='Return {"output","state","elapsed_ms","exit_code","timed_out"}')
    sp.add_argument('--capture', action='store_true',
                    help='Print only clean stdout (no timestamps, no prompt, no echo)')
    sp.add_argument('--exit-code', action='store_true',
                    help='Append ; echo EXITCODE:$? and parse exit code into result')
    sp.add_argument('--all', action='store_true',
                    help='Send to ALL boards with running daemons (ignores DEVICE)')

    sp = sub.add_parser('expect',
        help='Wait for first of multiple patterns; returns JSON {"matched","output","elapsed_ms"}')
    dev(sp); sp.set_defaults(func=cmd_expect)
    sp.add_argument('--on', action='append', metavar='KEY=REGEX', required=True,
                    help='Pattern to watch for, e.g. --on READY="~#" --on PANIC="Kernel panic"')
    sp.add_argument('--timeout', type=float, default=60.0)

    sp = sub.add_parser('wait'); dev(sp); sp.set_defaults(func=cmd_wait)
    sp.add_argument('pattern')
    sp.add_argument('--timeout', type=float, default=30.0)

    # ── Discovery & setup ──────────────────────────────────────────────────────
    sp = sub.add_parser('discover',
        help='JSON list of all ports with ser2net/daemon info; no hardcoding needed')
    sp.set_defaults(func=cmd_discover)
    sp.add_argument('--board',  metavar='PATTERN', help='Filter by label/hostname (regex)')
    sp.add_argument('--serial', metavar='PARTIAL', help='Filter by USB serial (partial match)')
    sp.add_argument('--live',   action='store_true', help='Only LIVE or OPEN ports')

    sp = sub.add_parser('connect',
        help='Discover + start daemon + optionally wait — one call replaces the chain')
    sp.set_defaults(func=cmd_connect)
    sp.add_argument('--board',      metavar='PATTERN')
    sp.add_argument('--serial',     metavar='PARTIAL')
    sp.add_argument('--wait-shell', action='store_true',
                    help='Block until SHELL/LOGIN/PASSWORD reached')
    sp.add_argument('--setup-terminal', action='store_true',
                    help='After --wait-shell, run stty cols 220 rows 50 to prevent wrapping')
    sp.add_argument('--timeout',    type=float, default=90.0)
    sp.add_argument('--user',       default='root', help='Login username (default: root)')
    sp.add_argument('--password',   default=None,   help='Login password (None=skip if not prompted)')
    sp.add_argument('--json',       action='store_true')

    sp = sub.add_parser('auto-label',
        help='Generate unique labels (hostname-serial6) for unlabeled LIVE boards')
    sp.set_defaults(func=cmd_auto_label)
    sp.add_argument('--dry-run', action='store_true')
    sp.add_argument('--yes', '-y', action='store_true')

    # ── Embedded dev operations ────────────────────────────────────────────────
    sp = sub.add_parser('reboot',
        help='Reboot board, wait for it to return, optionally auto-login')
    dev(sp); sp.set_defaults(func=cmd_reboot)
    sp.add_argument('--cmd',            default='reboot', help='Reboot command (default: reboot)')
    sp.add_argument('--timeout',        type=float, default=120.0)
    sp.add_argument('--no-login',       action='store_true', help='Do not auto-login after reboot')
    sp.add_argument('--login',          action='store_true', help='(no-op, auto-login is default)')
    sp.add_argument('--user',           default='root')
    sp.add_argument('--password',       default=None, help='Login password (None=skip if not prompted)')
    sp.add_argument('--setup-terminal', action='store_true', help='Run stty cols 220 after shell')
    sp.add_argument('--quiet',          action='store_true')
    sp.add_argument('--json',           action='store_true')

    sp = sub.add_parser('login',
        help='Send username/password and wait for shell prompt')
    dev(sp); sp.set_defaults(func=cmd_login)
    sp.add_argument('--user',     default='root')
    sp.add_argument('--password', default=None)

    sp = sub.add_parser('upload',
        help='Upload file: base64 serial (default, no network) or --via-network (wget, ~1MB/s)')
    dev(sp); sp.set_defaults(func=cmd_upload)
    sp.add_argument('hostfile',        help='Local file to upload')
    sp.add_argument('boardpath',       help='Destination path on board (dir/ appends filename)')
    sp.add_argument('--via-network',   action='store_true',
                    help='Use HTTP server + wget (~1MB/s vs ~1KB/s serial); board needs network+wget')
    sp.add_argument('--board-ip',      metavar='IP',
                    help='Board IP (auto-detected if omitted; only for --via-network)')
    sp.add_argument('--http-port',     type=int, default=8877,
                    help='Temporary HTTP server port (default 8877)')
    sp.add_argument('--quiet',         action='store_true')

    sp = sub.add_parser('run',
        help='Execute a shell script on the board (file, - for stdin, or inline text)')
    dev(sp); sp.set_defaults(func=cmd_run)
    sp.add_argument('script',     help='Script file, - for stdin, or inline shell text')
    sp.add_argument('--timeout',  type=float, default=60.0)
    sp.add_argument('--json',     action='store_true')
    sp.add_argument('--capture',  action='store_true')
    sp.add_argument('--no-wrap',  action='store_true')

    sp = sub.add_parser('health',
        help='Board health snapshot: state, memory, load, kernel version')
    dev(sp); sp.set_defaults(func=cmd_health)

    sp = sub.add_parser('ser2net-gen',
        help='Generate /etc/ser2net.yaml from serial-boards.conf')
    sp.set_defaults(func=cmd_ser2net_gen)
    sp.add_argument('--start-port', type=int, default=3001)
    sp.add_argument('--output', default='/tmp/ser2net.yaml',
                    help='Output path, or - for stdout')

    sp = sub.add_parser('list', help='List all devices with running daemons')
    sp.set_defaults(func=cmd_list)
    sp.add_argument('--json', action='store_true')

    sp = sub.add_parser('attach', help='Launch terminal directly on daemon device (bypasses menu)')
    dev(sp); sp.set_defaults(func=cmd_attach)

    sp = sub.add_parser('test',
        help='Self-test using a virtual pty pair (no real hardware needed)')
    sp.set_defaults(func=cmd_test)
    sp.add_argument('--verbose', '-v', action='store_true',
                    help='Show extra output (daemon stdout, relay details)')

    sp = sub.add_parser('clean'); sp.set_defaults(func=cmd_clean)
    sp.add_argument('device', nargs='?', default=None)

    sp = sub.add_parser('ops', help='Print recent operations from ops.log')
    dev(sp); sp.set_defaults(func=cmd_ops)
    sp.add_argument('--lines', type=int, default=20, help='Number of entries (default 20)')
    sp.add_argument('--json', action='store_true', help='Raw JSON output')

    args = p.parse_args()
    if hasattr(args, 'device') and args.device:
        if re.match(r'^\d+$', args.device):
            args.device = f'/dev/ttyUSB{args.device}'
        elif re.match(r'^tty\w+$', args.device):
            args.device = f'/dev/{args.device}'
    _max_t = int(os.environ.get('SERIAL_AGENT_MAX_TIMEOUT', '0') or '0')
    if _max_t > 0 and hasattr(args, 'timeout'):
        args.timeout = min(args.timeout, float(_max_t))
    args.func(args)


if __name__ == '__main__':
    main()
