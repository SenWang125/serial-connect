#!/bin/bash
# serial-connect — Interactive serial terminal with live TTY probing and cache.
# Usage: serial-connect [/dev/ttyXXX]
#        serial-connect --label
#
# Probe results are cached per device topology. Re-probes only when the device
# set changes or new unrecognized boards appear.

source "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/serial-common.sh"

case "${1:-}" in
    -h|--help)
        cat <<EOF
Usage: serial-connect [OPTION | /dev/ttyXXX]

  (no args)        interactive port picker with live probe
  /dev/ttyXXX      connect directly to a specific port
  --label          interactively assign labels to connected boards
  --doctor         show installation health: paths, config, daemons, conflicts
  -h, --help       show this help

Environment:
  BOARD_CFG        path to serial-boards.conf (override auto-detection)

System config:  ${_SYSTEM_CFG}
Label config:   ${_LABEL_CFG}
EOF
        exit 0 ;;

    --doctor)
        echo ""
        printf "${BOLD}serial-connect doctor${NC}\n"
        echo "─────────────────────"
        echo ""
        # Installations in PATH
        printf "${BOLD}Installations found in PATH:${NC}\n"
        _this="$(readlink -f "${BASH_SOURCE[0]}")"
        declare -A _seen_bins=()
        while IFS= read -r _bin; do
            [[ -z "$_bin" ]] && continue
            [[ -n "${_seen_bins[$_bin]+x}" ]] && continue
            _seen_bins[$_bin]=1
            _real="$(readlink -f "$_bin" 2>/dev/null || echo "$_bin")"
            if [[ "$_real" == "$_this" ]]; then
                printf "  ${GREEN}★${NC} %s  ${DIM}(this)${NC}\n" "$_bin"
            else
                printf "  ${YELLOW}⚠${NC} %s  ${DIM}→ %s (shadowing or conflict)${NC}\n" "$_bin" "$_real"
            fi
        done < <(IFS=':'; for d in $PATH; do [[ -x "$d/serial-connect" ]] && echo "$d/serial-connect"; done 2>/dev/null | sort -u)
        echo ""
        # Config
        printf "${BOLD}Config:${NC}\n"
        printf "  System conf:  %s" "$_SYSTEM_CFG"
        [[ -f "$_SYSTEM_CFG" ]] && printf "  ${GREEN}✓${NC}\n" || printf "  ${RED}✗ not found${NC}\n"
        printf "  Label conf:   %s" "$_LABEL_CFG"
        [[ -f "$_LABEL_CFG" ]] && printf "  ${GREEN}✓${NC}\n" || printf "  ${DIM}(not created yet)${NC}\n"
        echo ""
        # Running daemons
        printf "${BOLD}Running serial-agent daemons:${NC}\n"
        _base="${HOME}/var/serial-agent"
        _found_daemon=0
        if [[ -d "$_base" ]]; then
            for _ddir in "$_base"/*/; do
                _dn="$(basename "$_ddir")"
                _pf="$_ddir/daemon.pid"
                [[ -f "$_pf" ]] || continue
                _pid=$(cat "$_pf" 2>/dev/null)
                if [[ -d "/proc/$_pid" ]]; then
                    _state=$(awk -F'"' '/"state"/{print $4;exit}' "$_ddir/status.json" 2>/dev/null || echo "?")
                    _lock=""
                    [[ -f "/tmp/serial-connect-locks/$_dn" ]] && _lock="  ${DIM}[lock ✓]${NC}"
                    printf "  ${GREEN}●${NC} /dev/%-14s  PID %-8s  %s%b\n" "$_dn" "$_pid" "$_state" "$_lock"
                    _found_daemon=1
                fi
            done
        fi
        (( _found_daemon )) || printf "  ${DIM}none${NC}\n"
        echo ""
        # Lock files
        printf "${BOLD}Active port locks (/tmp/serial-connect-locks/):${NC}\n"
        _found_lock=0
        if [[ -d "/tmp/serial-connect-locks" ]]; then
            for _lf in /tmp/serial-connect-locks/*; do
                [[ -f "$_lf" ]] || continue
                _lpid=$(awk 'NR==1' "$_lf" 2>/dev/null)
                _luser=$(awk 'NR==2' "$_lf" 2>/dev/null)
                if [[ -d "/proc/$_lpid" ]]; then
                    printf "  ${CYAN}⊙${NC} /dev/%-14s  PID %-8s  user: %s\n" "$(basename "$_lf")" "$_lpid" "$_luser"
                    _found_lock=1
                fi
            done
        fi
        (( _found_lock )) || printf "  ${DIM}none${NC}\n"
        echo ""
        exit 0 ;;
esac

SERIAL_TERM="${SERIAL_TERM:-tio}"

# ── baud_valid / baud_prompt ───────────────────────────────────────────────────
baud_valid() {
    [[ -z "$1" ]] && return 0
    local s="${1^^}"; s="${s//[[:space:]]/}"
    [[ "$s" =~ ^[0-9]+(\.[0-9]+)?[MK]$ || "$s" =~ ^[0-9]+$ ]]
}
baud_prompt() {
    local b="$1" d; d=$(baud_display "$b")
    [[ "$d" != "$b" ]] && echo "Baud [$b or $d]" || echo "Baud [$b]"
}

# ── lock helpers ──────────────────────────────────────────────────────────────
LOCK_DIR="/tmp/serial-connect-locks"

_lock_acquire() {
    local dev="$1"
    mkdir -p "$LOCK_DIR" && chmod 1777 "$LOCK_DIR" 2>/dev/null || true
    printf '%s\n%s\n' "$$" "$USER" > "$LOCK_DIR/$(basename "$dev")" 2>/dev/null || true
    local _sa_dir="$HOME/var/serial-agent/$(basename "$dev")"
    if [[ -d "$_sa_dir" ]]; then
        printf '%s\n%s\n' "$$" "$(date +%s)" > "$_sa_dir/human_session" 2>/dev/null || true
    fi
}

_lock_release() {
    local dev="$1"
    local lockfile="$LOCK_DIR/$(basename "$dev")"
    local lock_pid; lock_pid=$(awk 'NR==1' "$lockfile" 2>/dev/null) || true
    [[ "$lock_pid" == "$$" ]] && rm -f "$lockfile" || true
    local _sa_dir="$HOME/var/serial-agent/$(basename "$dev")"
    local _hs="$_sa_dir/human_session"
    if [[ -f "$_hs" ]]; then
        local _mp; _mp=$(awk 'NR==1' "$_hs" 2>/dev/null)
        [[ "$_mp" == "$$" ]] && rm -f "$_hs" || true
    fi
}

# ── launch ─────────────────────────────────────────────────────────────────────
launch() {
    local dev="$1" baud="$2"
    local agent_tcp=""
    local _devname; _devname=$(basename "$dev")
    local agent_status="${HOME}/var/serial-agent/$_devname/status.json"
    [[ ! -f "$agent_status" ]] && agent_status="/tmp/serial-agent/$_devname/status.json"
    local _agent_live
    _agent_is_alive "$_devname" _agent_live
    (( _agent_live )) && _read_agent_tcp_via "$agent_status" agent_tcp
    # If serial-agent is available but not running, auto-start it as a persistent
    # always-on daemon (--idle-timeout 0).  The daemon keeps running after
    # serial-connect exits so agents can monitor the board between sessions.
    if (( !_agent_live )) && command -v serial-agent &>/dev/null; then  # tio only: relies on socat PTY bridge
        echo -e "  ${DIM}auto-starting serial-agent for $(basename "$dev") ...${NC}"
        serial-agent start "$dev" --baud "$baud" --idle-timeout 0 > /dev/null 2>&1 || true
        _read_agent_tcp_via "$agent_status" agent_tcp
    fi

    command -v tio &>/dev/null || { echo "tio not found: sudo apt install tio" >&2; exit 1; }
    # Socket path is PID-unique so a second serial-connect session cannot
    # clobber this session's tio sharing socket.  tio creates the socket on
    # startup and removes it on clean exit; stale sockets are visible in the
    # "Share: socat - UNIX-CONNECT:..." hint line.
    local sock="/tmp/$(basename "$dev")-${USER}-$$-serial.sock"
    local tio_target="$dev"
    local _socat_pid="" _pty_link=""

    if [[ -n "$agent_tcp" ]]; then
        # tio v2.7 does not support tcp:host:port as a device target.
        # Bridge via socat: serial-agent holds the physical port through its TCP relay;
        # socat allocates a PTY and forwards it to the relay so tio can open a real device.
        if ! command -v socat &>/dev/null; then
            # Daemon owns the device — tio cannot open it directly without byte-splitting.
            echo -e "  ${RED}✗${NC}  socat is required when serial-agent is running.  sudo apt install socat" >&2
            return 1
        fi
        local _relay_label="ser2net"
        [[ "$agent_tcp" == 127.0.0.1:* ]] && _relay_label="built-in relay"
        # Include the bash PID ($$) to make the path unique per session.
        # Without this, a second serial-connect session would rm -f the first
        # session's PTY symlink, disconnecting the running tio instance.
        _pty_link="/tmp/${_devname}-${USER}-$$-pty"
        rm -f "$_pty_link"
        socat pty,raw,echo=0,link="$_pty_link",wait-slave "tcp:$agent_tcp" 2>/dev/null &
        _socat_pid=$!
        local _i; for (( _i=0; _i<40; _i++ )); do
            [[ -e "$_pty_link" ]] && break; sleep 0.05
        done
        if [[ -e "$_pty_link" ]]; then
            echo -e "  ${DIM}serial-agent via ${_relay_label} → socat PTY — full stream to both${NC}"
            tio_target="$_pty_link"
        else
            kill "$_socat_pid" 2>/dev/null; _socat_pid=""; _pty_link=""
            # Daemon owns the device — connecting tio directly would split bytes with
            # the daemon.  Refuse rather than silently corrupt the session.
            echo -e "  ${RED}✗${NC}  socat PTY bridge failed — cannot connect tio directly (serial-agent owns the port)." >&2
            echo -e "  Check relay is reachable: nc -z ${agent_tcp//:/ }" >&2
            return 1
        fi
    fi

    # Only reset TTY state when tio owns the physical device directly.
    # When serial-agent holds the port (relay active), it manages TTY settings.
    [[ "$tio_target" == "$dev" ]] && \
        stty -F "$dev" "$baud" cs8 -parenb -cstopb -crtscts clocal -hupcl 2>/dev/null

    echo -e "\n${GREEN}→${NC} tio $tio_target @ $(baud_display "$baud")  ${DIM}(Ctrl-T Q to quit)${NC}"
    echo -e "  ${DIM}Share: socat - UNIX-CONNECT:$sock${NC}\n"
    _lock_acquire "$dev"
    # Heartbeat: refresh human_session every 60s — it expires at 300s, after which
    # the daemon stops suppressing automation probes and may auto-stop mid-session.
    local _heartbeat_pid=""
    local _sa_hb_dir="$HOME/var/serial-agent/$(basename "$dev")"
    ( while kill -0 $$ 2>/dev/null; do
          sleep 60
          [[ -d "$_sa_hb_dir" ]] && printf '%s\n%s\n' "$$" "$(date +%s)" \
              > "$_sa_hb_dir/human_session" 2>/dev/null || true
      done ) &
    _heartbeat_pid=$!
    # Signal trap for Ctrl-C / SIGTERM / SIGHUP — runs with locals still in scope.
    # Cleanup order: heartbeat first (stops human_session refresh), then socat
    # (disconnects relay client), then socket, then lock.  The daemon is NOT stopped —
    # it is a persistent observer and must survive session boundaries.
    trap '[[ -n "$_heartbeat_pid" ]] && kill "$_heartbeat_pid" 2>/dev/null
          [[ -n "$_socat_pid" ]] && { kill "$_socat_pid" 2>/dev/null; wait "$_socat_pid" 2>/dev/null; rm -f "$_pty_link"; }
          rm -f "$sock" 2>/dev/null || true
          _lock_release "$dev"' \
        INT TERM HUP
    tio -b "$baud" -S "unix:$sock" "$tio_target"
    local _tio_exit=$?
    # Inline cleanup — normal tio exit path.  Clear all three signals (INT TERM HUP)
    # so a late signal can't double-fire the cleanup after we've already run it.
    trap - INT TERM HUP
    stty sane 2>/dev/null || true
    printf '\033[0m\033[?7h' 2>/dev/null || true
    [[ -n "$_heartbeat_pid" ]] && kill "$_heartbeat_pid" 2>/dev/null
    [[ -n "$_socat_pid" ]] && { kill "$_socat_pid" 2>/dev/null; wait "$_socat_pid" 2>/dev/null; rm -f "$_pty_link"; }
    rm -f "$sock" 2>/dev/null || true
    _lock_release "$dev"
    if (( _tio_exit != 0 )) && [[ "$tio_target" == "$dev" ]]; then
        echo -e "\n${YELLOW}⚠${NC}  $dev is in use by another process."
    fi
}


# ── Init ───────────────────────────────────────────────────────────────────────
load_config
enumerate_devices
port_indices
cleanup_stale_daemon_dirs

# ── Direct-device mode ────────────────────────────────────────────────────────
if [[ -n "${1:-}" && "${1:-}" != "--label" ]]; then
    dev="$1"; [[ ! -c "$dev" ]] && { echo "Not a device: $dev" >&2; exit 1; }
    baud="${PROBE_BAUDS[0]}"
    for i in "${!DEVS[@]}"; do [[ "${DEVS[$i]}" == "$dev" ]] && baud="${BAUDS[$i]}" && break; done
    trap 'printf "\n"; exit 0' INT
    _prompt_baud baud
    launch "$dev" "$baud"
fi

# ── Signature check and selective probing ─────────────────────────────────────
cur_sig=$(for i in "${!DEVS[@]}"; do echo "${VIDS[$i]}:${PIDS[$i]}:${SERS[$i]}"; done | sort -u)
prev_sig=""; [[ -f "$SIG_FILE" ]] && prev_sig=$(< "$SIG_FILE")

PROBE_DIR=$(mktemp -d /tmp/serial-probe.XXXXXX)
trap 'rm -rf "$PROBE_DIR"' EXIT

if [[ "$cur_sig" != "$prev_sig" ]]; then
    echo "$cur_sig" > "$SIG_FILE"
    if [[ -n "$prev_sig" && -f "$CACHE_FILE" ]]; then
        # Opt 2 — incremental: load cache for existing serials, probe only new arrivals.
        # Removed serials simply aren't in DEVS so their cache entries are never read.
        echo -e "\n${YELLOW}⚠  Device configuration changed — probing new devices${NC}\n"
        load_cache "$PROBE_DIR"
        declare -a _new_idxs=()
        for i in "${!DEVS[@]}"; do
            [[ "$prev_sig" == *"${VIDS[$i]}:${PIDS[$i]}:${SERS[$i]}"* ]] || _new_idxs+=("$i")
        done
        (( ${#_new_idxs[@]} > 0 )) && run_probes "${_new_idxs[@]}"
    else
        run_probes "${!DEVS[@]}"
    fi
    save_cache "$PROBE_DIR"
elif [[ -f "$CACHE_FILE" ]]; then
    load_cache "$PROBE_DIR"

    # Opt 1 — batch fuser: one call for all devices instead of N per-port calls.
    # Builds _fuser_held[/dev/ttyXXX]=1 for every device currently held.
    # fuser outputs device names to stderr and PIDs to stdout; 2>&1 merges them
    # onto one line per device so the regex can match both in one read.
    declare -A _fuser_held=()
    while IFS= read -r _fl; do
        if [[ "$_fl" =~ ^(/dev/tty[^:]+):[[:space:]]*(.*) ]]; then
            [[ -n "${BASH_REMATCH[2]//[[:space:]]/}" ]] && _fuser_held[${BASH_REMATCH[1]}]=1
        fi
    done < <(fuser /dev/ttyUSB* /dev/ttyACM* 2>&1 2>/dev/null)

    # Reconcile cached state with current fuser/lock status for all ports.
    # Any state + fuser held  → OPEN (catches stale DEAD/FAIL/LIVE entries).
    # Cached OPEN + not held  → mark DEAD here; re-probed in the single pass below.
    declare -a _stale_open_idxs=()
    declare -A _stale_open_set=()
    for i in "${!DEVS[@]}"; do
        _dn="${DEVS[$i]##*/}"          # basename — zero forks
        _pf="$PROBE_DIR/$_dn"
        IFS='|' read -r _r _baud _bid _ < "$_pf" 2>/dev/null || { _r=''; _baud=''; _bid=''; }
        _lf="$LOCK_DIR/$_dn"
        _lock_live=0
        if [[ -f "$_lf" ]]; then
            { read -r _lpid; } < "$_lf" 2>/dev/null
            [[ -n "$_lpid" && -d "/proc/$_lpid" ]] && _lock_live=1 || rm -f "$_lf" 2>/dev/null || true
        fi
        if [[ -n "${_fuser_held[${DEVS[$i]}]+x}" ]] || (( _lock_live )); then
            # Check if the only holder is the persistent-observer daemon (no human session).
            # An always-on daemon always holds the fd, so fuser always finds it — but that
            # must NOT make the port appear OPEN when no human is using it.
            _da=0; _agent_is_alive "$_dn" _da
            if (( _da && !_lock_live )); then
                # Daemon holds device as observer, no human session: report board state.
                _agent_hostname "$_dn" _bid
                local _ds; _daemon_board_state "$_dn" _ds
                printf '%s|%s|%s\n' "$_ds" "${_baud:-${BAUDS[$i]}}" "${_bid:-}" > "$_pf"
            else
                [[ -z "$_bid" ]] && _agent_hostname "$_dn" _bid
                printf 'OPEN|%s|%s\n' "${_baud:-${BAUDS[$i]}}" "$_bid" > "$_pf"
            fi
        elif [[ "$_r" == "OPEN" ]]; then
            _stale_open_idxs+=("$i")
            _stale_open_set[$i]=1
        fi
    done

    # Opt 3 — merge reprobe passes: stale-OPEN entries are rewritten as DEAD so
    # _recog won't count them, then they fall into the single combined reprobe below.
    # Hostname is preserved so the scale-factor logic applies correctly.
    for i in "${_stale_open_idxs[@]}"; do
        _pf="$PROBE_DIR/${DEVS[$i]##*/}"
        IFS='|' read -r _ _ _cached_hn _ < "$_pf" 2>/dev/null || _cached_hn=""
        printf 'DEAD|%s|%s\n' "${BAUDS[$i]}" "$_cached_hn" > "$_pf"
        _PROBE_TIMEOUTS[${DEVS[$i]##*/}]=$(( PROBE_READ_MS * PROBE_READ_SCALE ))
    done

    declare -A _recog
    for i in "${!DEVS[@]}"; do
        ser="${SERS[$i]}"
        read -r result < "$PROBE_DIR/${DEVS[$i]##*/}" 2>/dev/null || result=""
        [[ "$result" =~ ^(LIVE|OPEN|FROZEN|PANIC)\| ]] && _recog[$ser]=1
        # REPROBE_DEAD=0: skip re-probing dead serials, but never skip stale-OPEN
        # ports — they must be re-probed regardless of their serial's other states.
        if (( !REPROBE_DEAD )) && [[ "$result" =~ ^(DEAD|FAIL)\| ]] \
                && [[ -z "${_stale_open_set[$i]+x}" ]]; then
            _recog[$ser]=1
        fi
    done
    declare -a _reprobe_idxs=()
    for i in "${!DEVS[@]}"; do
        [[ -n "${_recog[${SERS[$i]}]+x}" ]] && continue
        _reprobe_idxs+=("$i")
    done
    # Also re-probe LIVE cached ports whose detected baud doesn't match the
    # configured baud — guards against false-positive baud detections.
    for i in "${!DEVS[@]}"; do
        [[ -n "${_recog[${SERS[$i]}]+x}" ]] || continue
        _pf="$PROBE_DIR/${DEVS[$i]##*/}"
        IFS='|' read -r _cr_r _cr_b _ _ < "$_pf" 2>/dev/null || { _cr_r=''; _cr_b=''; }
        if [[ "$_cr_r" == "LIVE" && -n "$_cr_b" && "$_cr_b" != "${BAUDS[$i]}" ]]; then
            _reprobe_idxs+=("$i")
        fi
    done
    # Single combined reprobe pass (stale-OPEN + unrecognized + baud-mismatch).
    # Scale timeout for ports with a cached hostname — they were alive before.
    if (( ${#_reprobe_idxs[@]} > 0 )); then
        for i in "${_reprobe_idxs[@]}"; do
            _dn="${DEVS[$i]##*/}"
            [[ -n "${_PROBE_TIMEOUTS[$_dn]+x}" ]] && continue
            IFS='|' read -r _ _ _hn _ < "$PROBE_DIR/$_dn" 2>/dev/null || _hn=""
            [[ -n "$_hn" ]] && _PROBE_TIMEOUTS[$_dn]=$(( PROBE_READ_MS * PROBE_READ_SCALE ))
        done
        run_probes "${_reprobe_idxs[@]}"
        _PROBE_TIMEOUTS=()
        save_cache "$PROBE_DIR"
    fi
    unset _recog _fuser_held _stale_open_set
else
    run_probes "${!DEVS[@]}"; save_cache "$PROBE_DIR"
fi

(( ${#DEVS[@]} == 0 )) && { echo -e "${RED}No serial ports found.${NC}" >&2; exit 1; }

build_board_ids
build_active_ser

# ── Label mode ────────────────────────────────────────────────────────────────
if [[ "${1:-}" == "--label" ]]; then
    display_order
    echo ""
    echo -e "${BOLD}Label editor${NC}  —  Enter to keep, type a new name to change, ${DIM}-${NC} to remove"
    echo ""
    declare -A _lbl_updates _lbl_seen _lbl_ports
    for j in "${_disp_order[@]}"; do
        _lbl_ports[${SERS[$j]}]+="${_lbl_ports[${SERS[$j]}]:+ }$(basename "${DEVS[$j]}")"
    done
    for i in "${_disp_order[@]}"; do
        ser="${SERS[$i]}"
        [[ -n "${_lbl_seen[$ser]+x}" ]] && continue
        _lbl_seen[$ser]=1
        _cur="${CFG_LABEL[$ser]:-}"
        _probed="" _r="dead"
        # Check all ports of this device — use first LIVE/OPEN one for probed label
        for j in "${_disp_order[@]}"; do
            [[ "${SERS[$j]}" != "$ser" ]] && continue
            IFS='|' read -r _rj _bj _idj _ < "$PROBE_DIR/${DEVS[$j]##*/}" 2>/dev/null \
                || { _rj='FAIL'; _bj=''; _idj=''; }
            [[ -z "$_rj" || "$_rj" == "DEAD" ]] && _rj="dead"
            if [[ "$_rj" == "LIVE" || "$_rj" == "OPEN" ]]; then
                _r="$_rj"
                [[ -n "$_idj" ]] && _probed="$_idj"
                break
            fi
        done
        case "$_r" in
            LIVE)  _sym="${GREEN}★${NC}" ;;
            OPEN)  _sym="${CYAN}⊙${NC}"  ;;
            dead)  _sym=" "              ;;
            *)     _sym="${RED}✗${NC}"   ;;
        esac
        _suggested="${_cur:-${_probed}}"
        printf "  %b  %s - %s\n" "$_sym" "${CHIPS[$i]}" "${_lbl_ports[$ser]}"
        printf "     Serial Number:  %s\n" "$ser"
        [[ -n "$_cur"    ]] && printf "     Current Label:  ${GREEN}%s${NC}\n" "$_cur"
        [[ -n "$_probed" ]] && printf "     Probed Label:   ${DIM}%s${NC}\n"   "$_probed"
        _prompt="     New Label"
        [[ -n "$_suggested" ]] && _prompt+=" [${_suggested}]"
        read -rp "${_prompt}: " _newlabel || { printf "\n"; exit 0; }
        if [[ "$_newlabel" =~ ^-[[:space:]]*$ ]]; then
            [[ -n "$_cur" ]] && _lbl_updates[$ser]=""
        elif [[ -z "$_newlabel" && -n "$_suggested" && "$_suggested" != "$_cur" ]]; then
            _lbl_updates[$ser]="$_suggested"
        elif [[ -n "$_newlabel" && "$_newlabel" != "$_cur" ]]; then
            _lbl_updates[$ser]="$_newlabel"
        fi
        echo ""
    done
    if [[ ${#_lbl_updates[@]} -gt 0 ]]; then
        if rewrite_labels _lbl_updates; then
            echo -e "  ${GREEN}✓${NC} Saved ${#_lbl_updates[@]} change(s)"
            echo -e "  Exported to config: ${BOARD_CFG}"
        else
            echo -e "  ${RED}✗${NC} Failed to write config: ${BOARD_CFG}" >&2
        fi
    else
        echo -e "  ${DIM}No changes.${NC}"
        echo -e "  Config: ${BOARD_CFG}"
    fi
    exit 0
fi

# ── Dynamic column widths (single pass) ───────────────────────────────────────
dev_w=6; chip_w=6; board_w=6
for i in "${!DEVS[@]}"; do
    dn=$(basename "${DEVS[$i]}")
    (( ${#dn}        > dev_w  )) && dev_w=${#dn}
    (( ${#CHIPS[$i]} > chip_w )) && chip_w=${#CHIPS[$i]}
    ser="${SERS[$i]}"
    if [[ -n "${BOARD_ID[$ser]+x}" ]]; then
        (( ${#BOARD_ID[$ser]} > board_w )) && board_w=${#BOARD_ID[$ser]}
    else
        ser_disp="${ser}"; (( ${#ser} > 12 )) && ser_disp="${ser:0:10}"
        fb=$(( ${#CHIPS[$i]} + 1 + ${#ser_disp} ))
        (( fb > board_w )) && board_w=$fb
    fi
done
(( dev_w++ )); (( chip_w++ )); (( board_w++ ))
rule_w=$(( 2 + 1 + 5 + dev_w + 2 + 6 + 4 + board_w + 2 + chip_w + 2 + 5 + 13 ))

# ── Menu ───────────────────────────────────────────────────────────────────────
echo -e "${BOLD}Select serial port:${NC}\n"
printf "  ${BOLD}%-1s  %-4s  %-${dev_w}s  %-6s    %-${board_w}s  %-${chip_w}s  %-5s  %s${NC}\n" \
    "·" "  #" "Port" "Status" "Board" "Chip" "P#" "Baud"
printf '─%.0s' $(seq 1 "$rule_w"); echo

display_order
row=1; prev_ser="__unset__"
declare -a ROW_DEV ROW_BAUD ROW_STATE
declare -A ROW_BY_CHIPPORT   # "N-pM" → row number

for i in "${_disp_order[@]}"; do
    dev="${DEVS[$i]}"; devname="${dev##*/}"
    ser="${SERS[$i]}"; chip="${CHIPS[$i]}"; baud="${BAUDS[$i]}"
    [[ "$ser" != "$prev_ser" && "$prev_ser" != "__unset__" ]] && echo ""
    prev_ser="$ser"
    IFS='|' read -r raw probe_baud _ < "$PROBE_DIR/$devname" 2>/dev/null || { raw='FAIL'; probe_baud=''; }
    [[ -z "$raw" || "$raw" == "DEAD" ]] && state="dead" || state="$raw"
    # hung or panicked = not usable; fold into dead, not a separate status
    [[ "$state" == "FROZEN" || "$state" == "PANIC" ]] && state="dead"
    if [[ "$state" == "LIVE" && "$probe_baud" =~ ^[0-9]+$ ]]; then
        baud="$probe_baud"
    fi
    ROW_DEV[$row]="$dev"; ROW_BAUD[$row]="$baud"; ROW_STATE[$row]="$state"
    ROW_BY_CHIPPORT["${DEVICE_IDX[$ser]:-0}-p${PORT_IDX[$dev]:-0}"]=$row
    case "$state" in
        LIVE)   sym="${GREEN}★${NC}";  dc="$NC";     sc="${GREEN}";  pc="$NC"  ;;
        OPEN)   sym="${CYAN}⊙${NC}";   dc="$NC";     sc="${CYAN}";   pc="$NC"  ;;
        dead)   sym=" ";              dc="$DIM";    sc="$DIM";      pc="$DIM" ;;
        FAIL)   sym="${RED}✗${NC}";   dc="$DIM";    sc="${RED}";    pc="$DIM" ;;
    esac
    board_name="${BOARD_ID[$ser]:-}"
    [[ -z "$board_name" ]] && { ser_disp="${ser}"; (( ${#ser} > 12 )) && ser_disp="${ser:0:10}"; board_name="${chip}-${ser_disp}"; }
    if [[ -n "${_active_ser[$ser]+x}" ]]; then
        board_col=$(printf "%-${board_w}s" "$board_name")
        chip_col=$(printf "%-${chip_w}s" "$chip")
    else
        board_col="${DIM}$(printf "%-${board_w}s" "$board_name")${NC}"
        chip_col="${DIM}$(printf "%-${chip_w}s" "$chip")${NC}"
    fi
    baud_col=""; [[ "$state" == "LIVE" || "$state" == "OPEN" ]] && baud_col=$(baud_display "$baud")
    printf "  %b  %b%3d)${NC}  %b%-${dev_w}s${NC}  %b%-6s${NC}    %s  %s  %b%-5s${NC}  %s\n" \
        "$sym" "$BOLD" "$row" "$dc" "$devname" "$sc" "$state" \
        "$board_col" "$chip_col" "$pc" "${DEVICE_IDX[$ser]:-0}-p${PORT_IDX[$dev]:-0}" "$baud_col"
    (( row++ ))
done

total=$(( row - 1 ))
echo ""
printf "  ${GREEN}★ LIVE${NC}    ${CYAN}⊙ OPEN${NC}    ${RED}✗ FAIL${NC}    ${DIM}  dead${NC}\n"
echo -e "  use ${DIM}serial-discover${NC}             to force a fresh probe"
echo -e "  use ${DIM}serial-discover --gen-udev${NC}  for stable port names across reboots"
echo -e "  use ${DIM}serial-discover --tmp-udev${NC}  for stable port names current session"
echo -e "  use ${DIM}serial-connect --label${NC}      to rename boards"
echo ""

trap 'printf "\n"; exit 0' INT

while true; do
    read -rp "Port [1-${total} or P#]: " choice || { printf "\n"; exit 0; }
    # Accept N-pM (e.g. 2-p1) as shorthand for the Chip-P column value
    if [[ "$choice" =~ ^[0-9]+-p[0-9]+$ ]]; then
        choice="${ROW_BY_CHIPPORT[$choice]:-}"
        [[ -z "$choice" ]] && { echo "  No match for that P#." >&2; continue; }
    fi
    [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= total )) || {
        echo "  Enter a number 1-${total} or a P# (e.g. 2-p1)." >&2; continue
    }
    if [[ "${ROW_STATE[$choice]}" == "OPEN" ]]; then
        echo ""
        # Use lock file as source of truth (cross-user safe)
        _lf="/tmp/serial-connect-locks/$(basename "${ROW_DEV[$choice]}")"
        _lock_user=""; _lock_pid=""
        if [[ -f "$_lf" ]]; then
            { read -r _lock_pid; read -r _lock_user; } < "$_lf" 2>/dev/null
        fi
        echo -e "  ${CYAN}⊙${NC} ${ROW_DEV[$choice]} is currently held by:"
        if [[ -n "$_lock_user" ]]; then
            echo -e "    user: ${_lock_user}  PID: ${_lock_pid}"
        else
            fuser -v "${ROW_DEV[$choice]}" 2>&1 | grep -v '^\s*$' | sed 's/^/    /'
        fi
        echo ""
        # Determine if we can force-close
        _can_kill=0
        if [[ -z "$_lock_user" || "$_lock_user" == "$USER" ]]; then
            _can_kill=1
        elif sudo -n true 2>/dev/null; then
            _can_kill=1
        fi
        if (( !_can_kill )); then
            echo -e "  ${YELLOW}⚠${NC}  Held by user '${_lock_user}'"
            # Socket paths are PID-unique; glob for any live socket owned by the holder.
            for _share_sock in /tmp/"$(basename "${ROW_DEV[$choice]}")-${_lock_user}"-*-serial.sock; do
                [[ -S "$_share_sock" ]] && \
                    echo -e "  Observe (read-only):  ${DIM}socat - UNIX-CONNECT:${_share_sock}${NC}"
            done
            echo -e "  Take over (admin):    ${DIM}sudo fuser -k ${ROW_DEV[$choice]}${NC}\n"
            continue
        fi
        read -rp "  Force close and connect? [y/N]: " confirm || { printf "\n"; exit 0; }
        if [[ "${confirm,,}" != "y" ]]; then
            echo -e "  ${DIM}↩ back to port selection${NC}\n"
            continue
        fi
        _fuser_pfx="fuser"
        [[ -n "$_lock_user" && "$_lock_user" != "$USER" ]] && _fuser_pfx="sudo fuser"

        # Step 1a: kill the old session's process group (bash + tio + socat).
        # The lock file holds the PID of the serial-connect bash that owns the session.
        # tio v2.7 enters reconnect mode after its PTY disappears — it stays alive
        # watching for the PTY path to reappear and grabs it when a new socat creates
        # it, locking out the incoming session.  Killing the process group eliminates
        # the whole session (bash, tio, socat) in one shot before new socat is created.
        if [[ -n "$_lock_pid" && -d "/proc/$_lock_pid" ]]; then
            read -ra _pstat < "/proc/$_lock_pid/stat" 2>/dev/null; _pgid="${_pstat[4]:-}"
            if [[ -n "$_pgid" && "$_pgid" != "1" ]]; then
                kill -TERM -- "-$_pgid" 2>/dev/null || true
            fi
            kill -TERM "$_lock_pid" 2>/dev/null || true
            sleep 0.3
        fi

        # Daemon is a persistent observer — do NOT stop it.  Just clean up
        # the stale lock and human_session so the daemon is no longer blocked.
        rm -f "$LOCK_DIR/$(basename "${ROW_DEV[$choice]}")" 2>/dev/null || true
        rm -f "$HOME/var/serial-agent/$(basename "${ROW_DEV[$choice]}")/human_session" 2>/dev/null || true

        # Kill non-daemon processes holding the device (fallback: direct-tio
        # path when socat is unavailable).  Skip if daemon owns the port.
        _sa_pf="${HOME}/var/serial-agent/$(basename "${ROW_DEV[$choice]}")/daemon.pid"
        [[ ! -f "$_sa_pf" ]] && _sa_pf="/tmp/serial-agent/$(basename "${ROW_DEV[$choice]}")/daemon.pid"
        _daemon_alive=0
        [[ -f "$_sa_pf" ]] && kill -0 "$(cat "$_sa_pf" 2>/dev/null)" 2>/dev/null && _daemon_alive=1
        if (( !_daemon_alive )); then
            $_fuser_pfx -TERM "${ROW_DEV[$choice]}" 2>/dev/null || true
            for _gi in 1 2 3 4 5; do
                $_fuser_pfx "${ROW_DEV[$choice]}" &>/dev/null 2>&1 || break
                sleep 0.1
            done
            $_fuser_pfx -k "${ROW_DEV[$choice]}" 2>/dev/null || true
            sleep 0.1
        fi
        stty sane 2>/dev/null || true
        printf '\033[0m\033[?7h' 2>/dev/null || true  # reset terminal attributes + re-enable line wrap
        echo -e "  ${GREEN}Session closed.${NC}\n"
    fi
    break
done

sel_dev="${ROW_DEV[$choice]}"; sel_baud="${ROW_BAUD[$choice]}"

# Real-time lock check — cache may be stale if another user connected since last probe
_lf="/tmp/serial-connect-locks/${sel_dev##*/}"
if [[ -f "$_lf" ]]; then
    { read -r _lpid; read -r _luser; } < "$_lf" 2>/dev/null
    if [[ -d "/proc/$_lpid" ]]; then
        if [[ "$_luser" == "$USER" ]]; then
            # Same user already has a session.  Socket paths are PID-unique
            # (/tmp/DEVNAME-USER-PID-serial.sock) so we glob for any live socket.
            echo -e "\n  ${YELLOW}⚠${NC}  You already have an active session on ${sel_dev} (PID ${_lpid})"
            for _share_sock in /tmp/"$(basename "$sel_dev")"-"${USER}"-*-serial.sock; do
                [[ -S "$_share_sock" ]] && \
                    echo -e "  Observe (read-only):  ${DIM}socat - UNIX-CONNECT:${_share_sock}${NC}"
            done
            read -rp "  Open a second session anyway? [y/N]: " _sc_confirm || { printf "\n"; exit 0; }
            [[ "${_sc_confirm,,}" == "y" ]] || { echo "Aborted."; exit 0; }
        elif ! sudo -n true 2>/dev/null; then
            echo -e "\n  ${YELLOW}⚠${NC}  ${sel_dev} is now held by user '${_luser}'"
            for _share_sock in /tmp/"$(basename "$sel_dev")"-"${_luser}"-*-serial.sock; do
                [[ -S "$_share_sock" ]] && \
                    echo -e "  Observe (read-only):  ${DIM}socat - UNIX-CONNECT:${_share_sock}${NC}"
            done
            echo -e "  Take over (admin):    ${DIM}sudo fuser -k $sel_dev${NC}\n"
            exit 1
        fi
    fi
fi

_prompt_baud sel_baud

launch "$sel_dev" "$sel_baud"
