#!/bin/bash
# serial-connect — Interactive serial terminal with live TTY probing and cache.
# Usage: serial-connect [/dev/ttyXXX]
#        serial-connect --label
#
# Probe results are cached per device topology. Re-probes only when the device
# set changes or new unrecognized boards appear.
# Override terminal: SERIAL_TERM=screen serial-connect

source "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/serial-common.sh"

case "${1:-}" in
    -h|--help)
        cat <<EOF
Usage: serial-connect [OPTION | /dev/ttyXXX]

  (no args)        interactive port picker with live probe
  /dev/ttyXXX      connect directly to a specific port
  --label          interactively assign labels to connected boards
  -h, --help       show this help

Environment:
  SERIAL_TERM      terminal to use: tio (default), screen, picocom, minicom
  BOARD_CFG        path to serial-boards.conf (default: same dir as this script)

Config: ${BOARD_CFG}
EOF
        exit 0 ;;
esac

SERIAL_TERM="${SERIAL_TERM:-tio}"

# ── baud_valid / baud_prompt ───────────────────────────────────────────────────
baud_valid() {
    [[ -z "$1" ]] && return 0
    local s="${1^^}"; s="${s//[[:space:]]/}"
    [[ "$s" =~ ^[0-9]+(\.[0-9]+)?[MK]$ || "$s" =~ ^[0-9]+$ ]]
}
baud_prompt() {
    local b="$1" d; d=$(baud_display "$b")
    [[ "$d" != "$b" ]] && echo "Baud [$b or $d]" || echo "Baud [$b]"
}

# ── lock helpers ──────────────────────────────────────────────────────────────
LOCK_DIR="/tmp/serial-connect-locks"

_lock_acquire() {
    local dev="$1"
    mkdir -p "$LOCK_DIR" && chmod 1777 "$LOCK_DIR" 2>/dev/null || true
    printf '%s\n%s\n' "$$" "$USER" > "$LOCK_DIR/$(basename "$dev")"
}

_lock_release() {
    local dev="$1"
    local lockfile="$LOCK_DIR/$(basename "$dev")"
    local lock_pid; lock_pid=$(awk 'NR==1' "$lockfile" 2>/dev/null)
    [[ "$lock_pid" == "$$" ]] && rm -f "$lockfile"
}

# ── launch ─────────────────────────────────────────────────────────────────────
launch() {
    local dev="$1" baud="$2"
    local agent_tcp=""
    local agent_status="${HOME}/var/serial-agent/$(basename "$dev")/status.json"
    [[ ! -f "$agent_status" ]] && agent_status="/tmp/serial-agent/$(basename "$dev")/status.json"
    if [[ -f "$agent_status" ]]; then
        local via; via=$(python3 -c "import json,sys; print(json.load(open('$agent_status')).get('via',''))" 2>/dev/null)
        [[ "$via" == tcp:* ]] && agent_tcp="${via#tcp:}"
    fi
    if [[ -n "$agent_tcp" ]]; then
        echo -e "  ${DIM}serial-agent via ser2net tcp:${agent_tcp} — connecting tio there${NC}"
        echo -e "  ${DIM}Both tio and agent receive the full stream independently.${NC}"
    else
        stty -F "$dev" -hupcl 2>/dev/null
    fi
    case "${SERIAL_TERM}" in
        tio)
            command -v tio &>/dev/null || { echo "tio not found: sudo apt install tio" >&2; exit 1; }
            local sock="/tmp/$(basename "$dev")-${USER}.sock"
            local tio_target="${agent_tcp:+tcp:$agent_tcp}"; tio_target="${tio_target:-$dev}"
            echo -e "\n${GREEN}→${NC} tio $tio_target @ $(baud_display "$baud")  ${DIM}(Ctrl-T Q to quit)${NC}"
            echo -e "  ${DIM}Share: socat - UNIX-CONNECT:$sock${NC}\n"
            _lock_acquire "$dev"
            trap '_lock_release "$dev"' EXIT INT TERM
            tio -b "$baud" -S "unix:$sock" "$tio_target" || {
                echo -e "\n${YELLOW}⚠${NC}  Port is in use by another user."
                echo -e "  ${DIM}To force-close: sudo fuser -k $dev${NC}"
                exit 1
            }
            exit 0
            ;;
        screen)
            command -v screen &>/dev/null || { echo "screen not found: sudo apt install screen" >&2; exit 1; }
            local sname; sname="$(basename "$dev")"
            echo -e "\n${GREEN}→${NC} screen $dev @ $(baud_display "$baud")  ${DIM}(Ctrl-A K to kill)${NC}"
            echo -e "  ${DIM}Share: screen -x $sname${NC}\n"
            _lock_acquire "$dev"
            trap '_lock_release "$dev"' EXIT INT TERM
            screen -S "$sname" "$dev" "$baud"
            ;;
        picocom)
            command -v picocom &>/dev/null || { echo "picocom not found" >&2; exit 1; }
            echo -e "\n${GREEN}→${NC} picocom $dev @ $(baud_display "$baud")  ${DIM}(Ctrl-A Ctrl-X to exit)${NC}\n"
            _lock_acquire "$dev"
            trap '_lock_release "$dev"' EXIT INT TERM
            picocom -b "$baud" --imap lfcrnl "$dev"
            ;;
        minicom|*)
            echo -e "\n${GREEN}→${NC} minicom $dev @ $(baud_display "$baud")  ${DIM}(Ctrl-A X to exit)${NC}\n"
            _lock_acquire "$dev"
            trap '_lock_release "$dev"' EXIT INT TERM
            minicom -D "$dev" -b "$baud" -w -c on
            ;;
    esac
}


# ── Init ───────────────────────────────────────────────────────────────────────
load_config
enumerate_devices
port_indices

# ── Direct-device mode ────────────────────────────────────────────────────────
if [[ -n "${1:-}" && "${1:-}" != "--label" ]]; then
    dev="$1"; [[ ! -c "$dev" ]] && { echo "Not a device: $dev" >&2; exit 1; }
    baud="${PROBE_BAUDS[0]}"
    for i in "${!DEVS[@]}"; do [[ "${DEVS[$i]}" == "$dev" ]] && baud="${BAUDS[$i]}" && break; done
    trap 'printf "\n"; exit 0' INT
    while true; do
        read -rp "$(baud_prompt "$baud"): " b || { printf "\n"; exit 0; }
        baud_valid "$b" && { [[ -n "$b" ]] && baud=$(parse_baud "$b"); break; }
        echo "  Invalid — examples: 115200  115.2K  1.5M" >&2
    done
    launch "$dev" "$baud"
fi

# ── Signature check and selective probing ─────────────────────────────────────
cur_sig=$(for i in "${!DEVS[@]}"; do echo "${VIDS[$i]}:${PIDS[$i]}:${SERS[$i]}"; done | sort -u)
prev_sig=""; [[ -f "$SIG_FILE" ]] && prev_sig=$(< "$SIG_FILE")

PROBE_DIR=$(mktemp -d /tmp/serial-probe.XXXXXX)
trap 'rm -rf "$PROBE_DIR"' EXIT

if [[ "$cur_sig" != "$prev_sig" ]]; then
    echo "$cur_sig" > "$SIG_FILE"
    [[ -n "$prev_sig" ]] && echo -e "\n${YELLOW}⚠  Device configuration changed — re-probing${NC}\n"
    run_probes "${!DEVS[@]}"; save_cache "$PROBE_DIR"
elif [[ -f "$CACHE_FILE" ]]; then
    load_cache "$PROBE_DIR"
    # Reconcile cached state with current fuser status for all ports.
    # Any state + fuser held  → OPEN (catches stale DEAD/FAIL/LIVE entries).
    # Cached OPEN + not held  → re-probe; session ended, actual state is unknown.
    declare -a _stale_open_idxs=()
    for i in "${!DEVS[@]}"; do
        _pf="$PROBE_DIR/$(basename "${DEVS[$i]}")"
        _r=$(cut -d'|' -f1 "$_pf" 2>/dev/null)
        _baud=$(cut -d'|' -f2 "$_pf" 2>/dev/null)
        _bid=$(cut -d'|' -f3 "$_pf" 2>/dev/null)
        if { fuser "${DEVS[$i]}" &>/dev/null 2>&1 || sudo -n fuser "${DEVS[$i]}" &>/dev/null 2>&1; }; then
            printf 'OPEN|%s|%s\n' "${_baud:-${BAUDS[$i]}}" "$_bid" > "$_pf"
        elif [[ "$_r" == "OPEN" ]]; then
            _stale_open_idxs+=("$i")
        fi
    done
    if (( ${#_stale_open_idxs[@]} > 0 )); then
        run_probes "${_stale_open_idxs[@]}"; save_cache "$PROBE_DIR"
    fi
    declare -A _recog
    for i in "${!DEVS[@]}"; do
        ser="${SERS[$i]}"
        result=$(cat "$PROBE_DIR/$(basename "${DEVS[$i]}")" 2>/dev/null || echo "")
        [[ "$result" =~ ^(LIVE|OPEN)\| ]] && _recog[$ser]=1
        # If REPROBE_DEAD=0, skip re-probing serials with all-dead cache entries.
        # Labeled boards are NOT exempted here: FT4232H and similar chips power up
        # from USB host regardless of target board state, so the device signature
        # never changes between board power-off and power-on — without this, a
        # labeled board cached as dead would never be re-probed.
        (( !REPROBE_DEAD )) && [[ "$result" =~ ^(DEAD|FAIL)\| ]] && _recog[$ser]=1
    done
    declare -a _reprobe_idxs=()
    for i in "${!DEVS[@]}"; do
        [[ -n "${_recog[${SERS[$i]}]+x}" ]] && continue
        _reprobe_idxs+=("$i")
    done
    # Also re-probe LIVE cached ports whose detected baud doesn't match the
    # configured baud — guards against false-positive baud detections where
    # the probe happened to get 0 bytes at the correct baud and then caught
    # stray bytes at a wrong baud that passed the printable threshold.
    for i in "${!DEVS[@]}"; do
        [[ -n "${_recog[${SERS[$i]}]+x}" ]] || continue
        _pf="$PROBE_DIR/$(basename "${DEVS[$i]}")"
        _cr=$(cat "$_pf" 2>/dev/null || echo "")
        if [[ "$_cr" =~ ^LIVE\|([0-9]+)\| && "${BASH_REMATCH[1]}" != "${BAUDS[$i]}" ]]; then
            _reprobe_idxs+=("$i")
        fi
    done
    if (( ${#_reprobe_idxs[@]} > 0 )); then
        run_probes "${_reprobe_idxs[@]}"; save_cache "$PROBE_DIR"
    fi
    unset _recog
else
    run_probes "${!DEVS[@]}"; save_cache "$PROBE_DIR"
fi

(( ${#DEVS[@]} == 0 )) && { echo -e "${RED}No serial ports found.${NC}" >&2; exit 1; }

build_board_ids
build_active_ser

# ── Label mode ────────────────────────────────────────────────────────────────
if [[ "${1:-}" == "--label" ]]; then
    display_order
    echo ""
    echo -e "${BOLD}Label editor${NC}  —  Enter to keep, type a new name to change, ${DIM}-${NC} to remove"
    echo ""
    declare -A _lbl_updates _lbl_seen _lbl_ports
    for j in "${_disp_order[@]}"; do
        _lbl_ports[${SERS[$j]}]+="${_lbl_ports[${SERS[$j]}]:+ }$(basename "${DEVS[$j]}")"
    done
    for i in "${_disp_order[@]}"; do
        ser="${SERS[$i]}"
        [[ -n "${_lbl_seen[$ser]+x}" ]] && continue
        _lbl_seen[$ser]=1
        _cur="${CFG_LABEL[$ser]:-}"
        _probed=""
        IFS='|' read -r _r _b _id \
            <<< "$(cat "$PROBE_DIR/$(basename "${DEVS[$i]}")" 2>/dev/null || echo 'FAIL||')"
        [[ -z "$_r" || "$_r" == "DEAD" ]] && _r="dead"
        [[ ( "$_r" == "LIVE" || "$_r" == "OPEN" ) && -n "$_id" ]] && _probed="$_id"
        case "$_r" in
            LIVE) _sym="${GREEN}★${NC}" ;;
            OPEN) _sym="${CYAN}⊙${NC}"  ;;
            dead) _sym=" "              ;;
            *)    _sym="${RED}✗${NC}"   ;;
        esac
        _suggested="${_cur:-${_probed}}"
        printf "  %b  %s - %s\n" "$_sym" "${CHIPS[$i]}" "${_lbl_ports[$ser]}"
        printf "     Serial Number:  %s\n" "$ser"
        [[ -n "$_cur"    ]] && printf "     Current Label:  ${GREEN}%s${NC}\n" "$_cur"
        [[ -n "$_probed" ]] && printf "     Probed Label:   ${DIM}%s${NC}\n"   "$_probed"
        _prompt="     New Label"
        [[ -n "$_suggested" ]] && _prompt+=" [${_suggested}]"
        read -rp "${_prompt}: " _newlabel || { printf "\n"; exit 0; }
        if [[ "$_newlabel" =~ ^-[[:space:]]*$ ]]; then
            [[ -n "$_cur" ]] && _lbl_updates[$ser]=""
        elif [[ -z "$_newlabel" && -n "$_suggested" && "$_suggested" != "$_cur" ]]; then
            _lbl_updates[$ser]="$_suggested"
        elif [[ -n "$_newlabel" && "$_newlabel" != "$_cur" ]]; then
            _lbl_updates[$ser]="$_newlabel"
        fi
        echo ""
    done
    if [[ ${#_lbl_updates[@]} -gt 0 ]]; then
        if rewrite_labels _lbl_updates; then
            echo -e "  ${GREEN}✓${NC} Saved ${#_lbl_updates[@]} change(s)"
            echo -e "  Exported to config: ${BOARD_CFG}"
        else
            echo -e "  ${RED}✗${NC} Failed to write config: ${BOARD_CFG}" >&2
        fi
    else
        echo -e "  ${DIM}No changes.${NC}"
        echo -e "  Config: ${BOARD_CFG}"
    fi
    exit 0
fi

# ── Dynamic column widths ──────────────────────────────────────────────────────
dev_w=6; chip_w=6
for i in "${!DEVS[@]}"; do
    dn=$(basename "${DEVS[$i]}")
    (( ${#dn}        > dev_w  )) && dev_w=${#dn}
    (( ${#CHIPS[$i]} > chip_w )) && chip_w=${#CHIPS[$i]}
done
(( dev_w++ )); (( chip_w++ ))
board_w=6
for ser in "${!BOARD_ID[@]}"; do (( ${#BOARD_ID[$ser]} > board_w )) && board_w=${#BOARD_ID[$ser]}; done
for i in "${!DEVS[@]}"; do
    [[ -n "${BOARD_ID[${SERS[$i]}]+x}" ]] && continue
    ser="${SERS[$i]}"; ser_disp="${ser}"; (( ${#ser} > 12 )) && ser_disp="${ser:0:10}"
    fb=$(( ${#CHIPS[$i]} + 1 + ${#ser_disp} ))
    (( fb > board_w )) && board_w=$fb
done
(( board_w++ ))
rule_w=$(( 2 + 1 + 5 + dev_w + 2 + 6 + 4 + board_w + 2 + chip_w + 2 + 5 + 13 ))

# ── Menu ───────────────────────────────────────────────────────────────────────
echo -e "${BOLD}Select serial port:${NC}\n"
printf "  ${BOLD}%-1s  %-4s  %-${dev_w}s  %-6s    %-${board_w}s  %-${chip_w}s  %-5s  %s${NC}\n" \
    "·" "  #" "Port" "Status" "Board" "Chip" "P#" "Baud"
printf '─%.0s' $(seq 1 "$rule_w"); echo

display_order
row=1; prev_ser="__unset__"
declare -a ROW_DEV ROW_BAUD ROW_STATE
declare -A ROW_BY_CHIPPORT   # "N-pM" → row number

for i in "${_disp_order[@]}"; do
    dev="${DEVS[$i]}"; devname=$(basename "$dev")
    ser="${SERS[$i]}"; chip="${CHIPS[$i]}"; baud="${BAUDS[$i]}"
    [[ "$ser" != "$prev_ser" && "$prev_ser" != "__unset__" ]] && echo ""
    prev_ser="$ser"
    IFS='|' read -r raw probe_baud _ \
        <<< "$(cat "$PROBE_DIR/$devname" 2>/dev/null || echo 'FAIL||')"
    [[ -z "$raw" || "$raw" == "DEAD" ]] && state="dead" || state="$raw"
    if [[ "$state" == "LIVE" && "$probe_baud" =~ ^[0-9]+$ ]]; then
        baud="$probe_baud"
    fi
    ROW_DEV[$row]="$dev"; ROW_BAUD[$row]="$baud"; ROW_STATE[$row]="$state"
    ROW_BY_CHIPPORT["${DEVICE_IDX[$ser]:-0}-p${PORT_IDX[$dev]:-0}"]=$row
    case "$state" in
        LIVE) sym="${GREEN}★${NC}"; dc="$NC";  sc="${GREEN}"; pc="$NC"  ;;
        OPEN) sym="${CYAN}⊙${NC}";  dc="$NC";  sc="${CYAN}";  pc="$NC"  ;;
        dead) sym=" ";             dc="$DIM"; sc="$DIM";    pc="$DIM" ;;
        FAIL) sym="${RED}✗${NC}";  dc="$DIM"; sc="${RED}";   pc="$DIM" ;;
    esac
    board_name="${BOARD_ID[$ser]:-}"
    [[ -z "$board_name" ]] && { ser_disp="${ser}"; (( ${#ser} > 12 )) && ser_disp="${ser:0:10}"; board_name="${chip}-${ser_disp}"; }
    if [[ -n "${_active_ser[$ser]+x}" ]]; then
        board_col=$(printf "%-${board_w}s" "$board_name")
        chip_col="$chip"
    else
        board_col="${DIM}$(printf "%-${board_w}s" "$board_name")${NC}"
        chip_col="${DIM}${chip}${NC}"
    fi
    baud_col=""; [[ "$state" == "LIVE" || "$state" == "OPEN" ]] && baud_col=$(baud_display "$baud")
    printf "  %b  %b%3d)${NC}  %b%-${dev_w}s${NC}  %b%-6s${NC}    %s  %-${chip_w}s  %b%-5s${NC}  %s\n" \
        "$sym" "$BOLD" "$row" "$dc" "$devname" "$sc" "$state" \
        "$board_col" "$chip_col" "$pc" "${DEVICE_IDX[$ser]:-0}-p${PORT_IDX[$dev]:-0}" "$baud_col"
    (( row++ ))
done

total=$(( row - 1 ))
echo ""
printf "  ${GREEN}★ LIVE${NC}    ${CYAN}⊙ OPEN${NC}    ${RED}✗ FAIL${NC}    ${DIM}  dead${NC}\n"
echo -e "  use ${DIM}serial-discover${NC}             to force a fresh probe"
echo -e "  use ${DIM}serial-discover --gen-udev${NC}  for stable port names across reboots"
echo -e "  use ${DIM}serial-discover --tmp-udev${NC}  for stable port names current session"
echo -e "  use ${DIM}serial-connect --label${NC}      to rename boards"
echo ""

trap 'printf "\n"; exit 0' INT

while true; do
    read -rp "Port [1-${total} or P#]: " choice || { printf "\n"; exit 0; }
    # Accept N-pM (e.g. 2-p1) as shorthand for the Chip-P column value
    if [[ "$choice" =~ ^[0-9]+-p[0-9]+$ ]]; then
        choice="${ROW_BY_CHIPPORT[$choice]:-}"
        [[ -z "$choice" ]] && { echo "  No match for that P#." >&2; continue; }
    fi
    [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= total )) || {
        echo "  Enter a number 1-${total} or a P# (e.g. 2-p1)." >&2; continue
    }
    if [[ "${ROW_STATE[$choice]}" == "OPEN" ]]; then
        echo ""
        echo -e "  ${CYAN}⊙${NC} ${ROW_DEV[$choice]} is currently held by:"
        fuser -v "${ROW_DEV[$choice]}" 2>&1 | grep -v '^\s*$' | sed 's/^/    /'
        echo ""
        # Check if we can kill the holding process (same user or root)
        local _holder_uid; _holder_uid=$(fuser "${ROW_DEV[$choice]}" 2>/dev/null | tr ' ' '\n' | grep -E '^[0-9]+$' | head -1 | xargs -I{} awk -F: 'NR==1{print $9}' /proc/{}/status 2>/dev/null | head -1)
        if [[ -n "$_holder_uid" && "$_holder_uid" != "$(id -u)" ]] && ! sudo -n true 2>/dev/null; then
            echo -e "  ${YELLOW}⚠${NC}  Port held by another user — cannot force-close."
            echo -e "  ${DIM}To force-close: sudo fuser -k ${ROW_DEV[$choice]}${NC}"
            echo ""
            continue
        fi
        read -rp "  Force close and connect? [y/N]: " confirm || { printf "\n"; exit 0; }
        if [[ "${confirm,,}" != "y" ]]; then echo ""; continue; fi
        fuser -k "${ROW_DEV[$choice]}" 2>/dev/null
        sleep 0.3
        rm -f "$CACHE_FILE" "$SIG_FILE"
        echo -e "  ${GREEN}Session closed.${NC}\n"
    fi
    break
done

sel_dev="${ROW_DEV[$choice]}"; sel_baud="${ROW_BAUD[$choice]}"
while true; do
    read -rp "$(baud_prompt "$sel_baud"): " b || { printf "\n"; exit 0; }
    baud_valid "$b" && { [[ -n "$b" ]] && sel_baud=$(parse_baud "$b"); break; }
    echo "  Invalid — examples: 115200  115.2K  1.5M" >&2
done

launch "$sel_dev" "$sel_baud"
