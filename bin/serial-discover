#!/bin/bash
# serial-discover — Probe all USB serial ports, display status and board names.
# Usage: serial-discover [--json | --gen-udev | --tmp-udev | --rm-udev]
#
# --json       Machine-readable output for agents and scripts.
# --gen-udev   Write /tmp/99-serial-aliases.rules for permanent stable port names.
#              Install: sudo cp /tmp/99-serial-aliases.rules /etc/udev/rules.d/
#                       sudo udevadm control --reload-rules && sudo udevadm trigger
# --tmp-udev   Create /dev/tty<LABEL> symlinks for this session only — no system
#              changes. Useful when external tools need a stable /dev path directly
#              (e.g. minicom -D /dev/ttyAM62D2-EVM). Symlinks removed on reboot.
# --rm-udev    Remove installed udev rules and any /dev/tty<LABEL> session symlinks.

source "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/serial-common.sh"

load_config
enumerate_devices
port_indices

PROBE_DIR=$(mktemp -d /tmp/serial-probe.XXXXXX)
trap 'rm -rf "$PROBE_DIR"' EXIT

# Adaptive timeouts: boards labeled in config or with a cached hostname get
# PROBE_READ_SCALE * PROBE_READ_MS so recently-released ports aren't missed.
declare -A _known_sers=()
for i in "${!DEVS[@]}"; do
    [[ -n "${CFG_LABEL[${SERS[$i]}]:-}" ]] && _known_sers["${SERS[$i]}"]=1
done
if [[ -f "$CACHE_FILE" ]]; then
    while IFS='|' read -r _ck _ _ _ch; do
        [[ -n "$_ch" ]] || continue
        IFS=':' read -r _ _ _cser _ <<< "$_ck"
        [[ -n "$_cser" ]] && _known_sers["$_cser"]=1
    done < "$CACHE_FILE"
fi
for i in "${!DEVS[@]}"; do
    [[ -n "${_known_sers[${SERS[$i]}]+x}" ]] && \
        _PROBE_TIMEOUTS["$(basename "${DEVS[$i]}")"]=$(( PROBE_READ_MS * PROBE_READ_SCALE ))
done

run_probes "${!DEVS[@]}"
_PROBE_TIMEOUTS=()
save_cache "$PROBE_DIR"

build_board_ids
build_active_ser

# ── Dynamic column widths ───────────────────────────────────────────────────────
dev_w=6; chip_w=6
for i in "${!DEVS[@]}"; do
    dn=$(basename "${DEVS[$i]}")
    (( ${#dn}        > dev_w  )) && dev_w=${#dn}
    (( ${#CHIPS[$i]} > chip_w )) && chip_w=${#CHIPS[$i]}
done
(( dev_w++ )); (( chip_w++ ))
board_w=6
for ser in "${!BOARD_ID[@]}"; do
    (( ${#BOARD_ID[$ser]} > board_w )) && board_w=${#BOARD_ID[$ser]}
done
for i in "${!DEVS[@]}"; do
    [[ -n "${BOARD_ID[${SERS[$i]}]+x}" ]] && continue
    ser="${SERS[$i]}"
    ser_disp="${ser}"; (( ${#ser} > 12 )) && ser_disp="${ser:0:10}"
    fb=$(( ${#CHIPS[$i]} + 1 + ${#ser_disp} ))
    (( fb > board_w )) && board_w=$fb
done
(( board_w++ ))
rule_w=$(( 2 + 1 + dev_w + 2 + 6 + 4 + board_w + 2 + chip_w + 2 + 5 + 13 ))

# ── Alias map: /dev symlinks ────────────────────────────────────────────────────
declare -A _dev_alias
while IFS= read -r sl; do
    tgt=$(readlink -f "$sl" 2>/dev/null)
    [[ -n "$tgt" ]] && _dev_alias[$tgt]=$(basename "$sl")
done < <(find /dev -maxdepth 1 -type l ! -path "/dev/serial/*" 2>/dev/null)

# ── JSON output ─────────────────────────────────────────────────────────────────
if [[ "${1:-}" == "--json" ]]; then
    echo '['
    sep=""
    for i in "${!DEVS[@]}"; do
        dev="${DEVS[$i]}"; devname=$(basename "$dev")
        raw=$(cat "$PROBE_DIR/$devname" 2>/dev/null || echo "FAIL||")
        state=$(cut -d'|' -f1 <<< "$raw")
        baud_raw=$(cut -d'|' -f2 <<< "$raw")
        [[ "$state" == "DEAD" ]] && state="dead"
        [[ -z "$baud_raw" || ! "$baud_raw" =~ ^[0-9]+$ ]] && baud_raw="${BAUDS[$i]}"
        label="${CFG_LABEL[${SERS[$i]}]:-}"
        board="${BOARD_ID[${SERS[$i]}]:-}"
        probe_id=$(cut -d'|' -f3 <<< "$raw")
        hostname="${probe_id:-$board}"
        alias_val="${_dev_alias[${DEVS[$i]}]:-}"
        label="${label//\"/\'}"; hostname="${hostname//\"/\'}"; alias_val="${alias_val//\"/\'}"
        printf '%s\n  {"device":"%s","devname":"%s","chip":"%s","serial":"%s","port":%d,"state":"%s","baud":%d,"label":"%s","hostname":"%s","alias":"%s"}' \
            "$sep" "${DEVS[$i]}" "$devname" "${CHIPS[$i]}" "${SERS[$i]}" \
            "${PORT_IDX[$dev]:-0}" "$state" "$baud_raw" "$label" "$hostname" "$alias_val"
        sep=","
    done
    echo ''; echo ']'
    exit 0
fi

if [[ "${1:-}" == "--tmp-udev" ]]; then
    declare -A _tseen
    for i in "${!DEVS[@]}"; do
        raw=$(cut -d'|' -f1 "$PROBE_DIR/$(basename "${DEVS[$i]}")" 2>/dev/null)
        [[ "$raw" != "LIVE" && "$raw" != "OPEN" ]] && continue
        label="${LABELS[$i]}"; [[ -z "$label" ]] && continue
        ser="${SERS[$i]}"; ifn="${IFNS[$i]}"
        [[ -n "${_tseen[$ser:$ifn]+x}" ]] && continue; _tseen["$ser:$ifn"]=1
        safe="${label//[^A-Za-z0-9_-]/_}"
        sudo ln -sf "${DEVS[$i]}" "/dev/tty${safe}" && \
            echo -e "  ${GREEN}✓${NC} /dev/tty${safe} → ${DEVS[$i]}" || \
            echo -e "  ${RED}✗${NC} failed: /dev/tty${safe}"
    done
    echo -e "  ${DIM}Session only — symlinks removed on reboot. Use --gen-udev to make permanent.${NC}"
    exit 0
fi

if [[ "${1:-}" == "--rm-udev" ]]; then
    RULES=/etc/udev/rules.d/99-serial-aliases.rules
    if [[ -f "$RULES" ]]; then
        sudo rm -f "$RULES"
        sudo udevadm control --reload-rules && sudo udevadm trigger
        echo -e "${GREEN}Removed:${NC} $RULES"
    else
        echo -e "${YELLOW}Not installed:${NC} $RULES"
    fi
    # Also remove any session symlinks created by --tmp-udev
    for i in "${!DEVS[@]}"; do
        label="${LABELS[$i]}"; [[ -z "$label" ]] && continue
        safe="${label//[^A-Za-z0-9_-]/_}"
        link="/dev/tty${safe}"
        [[ -L "$link" ]] && sudo rm -f "$link" && echo -e "${GREEN}Removed:${NC} $link"
    done
    exit 0
fi


# ── Human display ───────────────────────────────────────────────────────────────
echo -e "${BOLD}USB Serial Port Discovery${NC}  $(date '+%Y-%m-%d %H:%M:%S')\n"
printf "  ${BOLD}%-1s  %-${dev_w}s  %-6s    %-${board_w}s  %-${chip_w}s  %-5s  %s${NC}\n" \
    "·" "Port" "Status" "Board" "Chip" "P#" "Baud"
printf '─%.0s' $(seq 1 "$rule_w"); echo

display_order
prev_ser="__unset__"
for i in "${_disp_order[@]}"; do
    dev="${DEVS[$i]}"; devname=$(basename "$dev")
    ser="${SERS[$i]}"; chip="${CHIPS[$i]}"; baud="${BAUDS[$i]}"

    [[ "$ser" != "$prev_ser" && "$prev_ser" != "__unset__" ]] && echo ""
    prev_ser="$ser"

    IFS='|' read -r raw probe_baud _ \
        <<< "$(cat "$PROBE_DIR/$devname" 2>/dev/null || echo 'FAIL||')"
    [[ -z "$raw" || "$raw" == "DEAD" ]] && state="dead" || state="$raw"
    [[ "$state" == "LIVE" && "$probe_baud" =~ ^[0-9]+$ ]] && baud="$probe_baud"

    alias="${_dev_alias[$dev]:-}"
    case "$state" in
        LIVE) sym="${GREEN}★${NC}"; dc="$NC";   sc="$GREEN" ;;
        OPEN) sym="${CYAN}⊙${NC}";  dc="$CYAN"; sc="$CYAN"  ;;
        dead) sym=" ";              dc="$DIM";  sc="$DIM"   ;;
        FAIL) sym="${RED}✗${NC}";   dc="$RED";  sc="$RED"   ;;
    esac

    board_name="${BOARD_ID[$ser]:-}"
    [[ -z "$board_name" ]] && { ser_disp="${ser}"; (( ${#ser} > 12 )) && ser_disp="${ser:0:10}"; board_name="${chip}-${ser_disp}"; }
    if [[ -n "${_active_ser[$ser]+x}" ]]; then
        board_col=$(printf "%-${board_w}s" "$board_name")
        chip_col=$(printf "%-${chip_w}s" "$chip")
    else
        board_col="${DIM}$(printf "%-${board_w}s" "$board_name")${NC}"
        chip_col="${DIM}$(printf "%-${chip_w}s" "$chip")${NC}"
    fi

    baud_col=""
    [[ "$state" == "LIVE" || "$state" == "OPEN" ]] && baud_col=$(baud_display "$baud")
    [[ -n "$alias" ]] && baud_col+="${baud_col:+ }${CYAN}→${alias}${NC}"

    printf "  %b  %b%-${dev_w}s${NC}  %b%-6s${NC}    %s  %s  %-5s  %b\n" \
        "$sym" "$dc" "$devname" "$sc" "$state" \
        "$board_col" "$chip_col" "${DEVICE_IDX[$ser]:-0}-p${PORT_IDX[$dev]:-0}" "$baud_col"
done

(( ${#DEVS[@]} == 0 )) && echo -e "${RED}No serial devices found.${NC}"
echo ""
printf "  ${GREEN}★ LIVE${NC}    ${CYAN}⊙ OPEN${NC}    ${RED}✗ FAIL${NC}    ${DIM}  dead${NC}\n"
echo -e "  ${DIM}Config: ${BOARD_CFG}${NC}"

[[ "${1:-}" != "--gen-udev" ]] && exit 0

# ── udev rule generation ────────────────────────────────────────────────────────
OUTFILE="/tmp/99-serial-aliases.rules"
{
echo "# Generated by serial-discover --gen-udev  $(date '+%Y-%m-%d')"
echo "# sudo cp ${OUTFILE} /etc/udev/rules.d/"
echo "# sudo udevadm control --reload-rules && sudo udevadm trigger"
echo ""
echo "# Single-port chips"
cat <<'GENERIC'
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", \
    SYMLINK+="ttyCP210x_$env{ID_SERIAL_SHORT}", MODE="0660", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", \
    SYMLINK+="ttyCH340_$env{ID_SERIAL_SHORT}", MODE="0660", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", \
    SYMLINK+="ttyFT232_$env{ID_SERIAL_SHORT}", MODE="0660", GROUP="dialout"

GENERIC
echo "# Live/open multi-port interfaces"
declare -A _seen
for i in "${!DEVS[@]}"; do
    raw=$(cut -d'|' -f1 "$PROBE_DIR/$(basename "${DEVS[$i]}")" 2>/dev/null)
    [[ "$raw" != "LIVE" && "$raw" != "OPEN" ]] && continue
    vid="${VIDS[$i]}"; pid="${PIDS[$i]}"; ser="${SERS[$i]}"; ifn="${IFNS[$i]}"
    vp="${vid}:${pid}"
    case "$vp" in "10c4:ea60"|"1a86:7523"|"0403:6001") continue ;; esac
    [[ -n "${_seen[$ser:$ifn]+x}" ]] && continue; _seen["$ser:$ifn"]=1
    label="${LABELS[$i]}"
    [[ -z "$label" ]] && { echo "# SKIP $(basename "${DEVS[$i]}") serial=${ser} — no label"; continue; }
    safe="${label//[^A-Za-z0-9_-]/_}"
    echo "# ${label} — ${CHIPS[$i]} if${ifn}"
    echo "SUBSYSTEM==\"tty\", ATTRS{idVendor}==\"${vid}\", ATTRS{idProduct}==\"${pid}\", \\"
    echo "    ATTRS{serial}==\"${ser}\", ATTRS{bInterfaceNumber}==\"${ifn}\", \\"
    echo "    SYMLINK+=\"tty${safe}\", MODE=\"0660\", GROUP=\"dialout\""
    echo ""
done
} > "$OUTFILE"
echo -e "\n${GREEN}Rules written to:${NC} ${OUTFILE}"
echo -e "  sudo cp ${OUTFILE} /etc/udev/rules.d/"
echo -e "  sudo udevadm control --reload-rules && sudo udevadm trigger"
echo -e "\n${BOLD}Current by-id symlinks:${NC}"
if ls /dev/serial/by-id/ &>/dev/null 2>&1; then
    ls -la /dev/serial/by-id/ | awk 'NR>3 {
        n=split($0,a," "); tgt=a[n]; link=a[n-2]
        sub(".*/","",link); sub("../../","/dev/",tgt)
        printf "  %-58s → %s\n", link, tgt
    }'
else echo "  (none)"; fi
